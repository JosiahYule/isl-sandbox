---
// ATLANTIC MAP
// Real province shapes (src/data/maps.js) with the brand's offices pinned (ISL five, AS and ADS three).
// Click or tab to a pin to see that office's address and phone number.
// Props:
//   tone: "light" (navy land on a light page, default) | "dark" (for navy sections)
//   card: show the office details card (default true)
//   bleed: let neighbouring land run past the map's box (used in the homepage hero)
//   selected: the city to show first (default: the head office)
//   navigate: selecting a pin opens that office's page (used on the office pages)
//   towns: optional [{ name, lon, lat }] drawn as small dots (places we staff beyond the office cities)
import { atlanticMap as map } from '../data/maps.js';
import { offices, brand } from '../data/site.js';
import { areas } from '../data/areas.js';
import { url } from '../lib/url.js';
import { project } from '../lib/mapfit.js';

const { tone = 'light', card = true, id = 'amap', bleed = false, selected, navigate = false, towns = [] } = Astro.props;

// Towns are placed with the rule fitted in src/lib/mapfit.js
const townDots = towns.map((t) => ({ ...t, ...project(t.lon, t.lat) }));

// Which side of the pin each label sits on, so nearby labels don't collide.
const labelSide = { Halifax: 'right', Moncton: 'left', 'Saint John': 'right', Charlottetown: 'right', "St. John's": 'left' };

const pins = map.offices.filter((p) => offices.some((x) => x.city === p.city)).map((p) => {
  const o = offices.find((x) => x.city === p.city);
  const key = brand.officePages ? areas.find((a) => a.label === p.city)?.key : undefined;
  return { ...o, key, left: (p.x / map.width) * 100, top: (p.y / map.height) * 100, side: labelSide[p.city] ?? 'right' };
});
const sel = Math.max(0, pins.findIndex((p) => p.city === selected));
const tel = (n) => `tel:+1${n.replaceAll('-', '')}`;
---
<figure class:list={['amap', `amap--${tone}`, bleed && 'amap--bleed']} id={id} data-amap data-animate data-navigate={navigate ? '' : undefined}>
  <div class="canvas">
  <svg viewBox={`0 0 ${map.width} ${map.height}`} aria-hidden="true" focusable="false">
    <g class="context">{map.context.map((p) => <path d={p.d} />)}</g>
    <g class="land">{map.provinces.map((p) => <path d={p.d} data-prov={p.id} />)}</g>
    {townDots.length > 0 && <g class="towns">{townDots.map((t, i) => <circle cx={t.x} cy={t.y} r="8" style={`--o:${i}`}><title>{t.name}</title></circle>)}</g>}
  </svg>

  <ul class="pins" aria-label="Our offices">
    {pins.map((p, i) => (
      <li style={`left:${p.left}%;top:${p.top}%;--o:${i}`}>
        <button type="button" class:list={['pin', `pin--${p.side}`]} aria-pressed={i === sel ? 'true' : 'false'} data-index={i} data-href={p.key ? url(`/offices/${p.key}/`) : undefined}>
          <span class="dot" aria-hidden="true"></span>
          <span class="label">{p.city}</span>
        </button>
      </li>
    ))}
  </ul>
  </div>

  {card && (
    <div class="card" aria-live="polite">
      {pins.map((p, i) => (
        <div class="office" data-office={i} hidden={i !== sel}>
          <p class="office-city">{p.city}, {p.province}{i === 0 && <span class="hq">Head office</span>}</p>
          <p class="office-addr">{p.address}</p>
          <a class="office-tel" href={tel(p.phone)}>{p.phone}</a>
          {p.key && <a class="office-more" href={url(`/offices/${p.key}/`)}>About this office</a>}
        </div>
      ))}
    </div>
  )}
  <figcaption class="visually-hidden">Map of Atlantic Canada with offices in {pins.map((p) => p.city).slice(0, -1).join(', ')} and {pins.at(-1).city}.</figcaption>
</figure>

<script>
  // Selecting a pin shows that office in the card. Runs for every map on the page.
  document.querySelectorAll('[data-amap]').forEach((fig) => {
    const pins = fig.querySelectorAll('.pin');
    const cards = fig.querySelectorAll('[data-office]');
    pins.forEach((pin) => {
      pin.addEventListener('click', () => {
        if (fig.hasAttribute('data-navigate') && pin.dataset.href && pin.getAttribute('aria-pressed') !== 'true') { location.href = pin.dataset.href; return; }
        pins.forEach((p) => p.setAttribute('aria-pressed', String(p === pin)));
        cards.forEach((c) => (c.hidden = c.dataset.office !== pin.dataset.index));
      });
    });
  });
</script>

<style>
  .amap {
    --land: var(--map-land);
    --land-edge: #ffffff;
    --context: var(--line);
    --label-bg: var(--ink);
    position: relative; margin: 0;
  }
  /* Pins are positioned as percentages of this box, so it must hold only the map */
  .canvas { position: relative; aspect-ratio: 900 / 820; }
  .amap--dark {
    --land: var(--map-land);
    --land-edge: var(--dark);
    --context: #232323;
    --label-bg: var(--ink);
  }
  svg { width: 100%; height: 100%; overflow: hidden; }
  .amap--bleed svg { overflow: visible; }
  .context path { fill: var(--context); }
  .land path { fill: var(--land); stroke: var(--land-edge); stroke-width: 1.5; stroke-linejoin: round; }

  .towns circle { fill: var(--ink); stroke: #fff; stroke-width: 2.5; transform-box: fill-box; transform-origin: center; }
  :global(.motion) .amap .towns circle { transform: scale(0); transition: transform 0.4s var(--ease); transition-delay: calc(0.9s + var(--o) * 110ms); }
  :global(.motion) .amap.is-in .towns circle { transform: none; }
  .pins { list-style: none; margin: 0; padding: 0; }
  .pins li { position: absolute; width: 0; height: 0; }
  .pin {
    position: absolute; transform: translate(-50%, -50%);
    display: flex; align-items: center; gap: 8px;
    background: none; border: 0; padding: 6px; cursor: pointer; font: inherit;
  }
  .pin--left { flex-direction: row-reverse; transform: translate(calc(-100% + 15px), -50%); }
  .pin--right { transform: translate(-15px, -50%); }

  .dot {
    width: 18px; height: 18px; border-radius: 50%; flex: none;
    background: #fff; border: 4px solid var(--ink);
    transition: transform 180ms var(--ease), border-color 180ms var(--ease);
  }
  .label {
    background: var(--label-bg); color: #fff; white-space: nowrap;
    font-size: var(--fs-tiny); font-weight: var(--fw-bold); line-height: 1; padding: 6px 8px; border-radius: var(--radius);
  }
  .pin:hover .dot, .pin[aria-pressed='true'] .dot { transform: scale(1.25); background: var(--ink); border-color: #fff; }
  .pin[aria-pressed='true'] .label { background: #fff; color: var(--ink); outline: 1px solid var(--ink); }

  .card {
    position: absolute; right: 2%; bottom: 3%; width: min(300px, 46%);
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--ink); border-radius: var(--radius);
    padding: var(--s4) var(--s5);
  }
  .office-city { font-weight: var(--fw-bold); font-size: var(--fs-h3); margin-bottom: var(--s1); }
  .hq { display: block; font-weight: var(--fw-bold); font-size: var(--fs-tiny); color: var(--ink-soft); }
  .office-addr { font-size: var(--fs-small); color: var(--ink-soft); line-height: 1.45; margin-bottom: var(--s2); }
  .office-more { display: block; margin-top: var(--s2); font-size: var(--fs-small); font-weight: var(--fw-bold); }
  .office-tel { font-weight: var(--fw-bold); font-size: var(--fs-body); color: var(--ink); font-variant-numeric: tabular-nums; }

  /* Motion: the pins drop onto the map one after another, then the office card appears */
  :global(.motion) .amap .pin { opacity: 0; margin-top: -14px; transition: opacity 0.4s var(--ease), margin-top 0.5s var(--ease); transition-delay: calc(0.2s + var(--o) * 120ms); }
  :global(.motion) .amap.is-in .pin { opacity: 1; margin-top: 0; }
  :global(.motion) .amap .card { opacity: 0; transition: opacity 0.6s var(--ease) 0.9s; }
  :global(.motion) .amap.is-in .card { opacity: 1; }

  @media (max-width: 900px) { .amap--bleed svg { overflow: hidden; } }
  @media (max-width: 640px) {
    .label { font-size: var(--fs-tiny); padding: 4px 6px; }
    .dot { width: 14px; height: 14px; border-width: 3px; }
    .card { position: static; width: auto; margin-top: var(--s4); }
  }
</style>

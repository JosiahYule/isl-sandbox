---
// ATLANTIC MAP
// Real province shapes (src/data/maps.js) with the five offices pinned.
// Click or tab to a pin to see that office's address and phone number.
// Props:
//   tone: "light" (navy land on a light page, default) | "dark" (for navy sections)
//   card: show the office details card (default true)
//   bleed: let neighbouring land run past the map's box (used in the homepage hero)
import { atlanticMap as map } from '../data/maps.js';
import { offices } from '../data/site.js';

const { tone = 'light', card = true, id = 'amap', bleed = false } = Astro.props;

// Which side of the pin each label sits on, so nearby labels don't collide.
const labelSide = { Halifax: 'right', Moncton: 'left', 'Saint John': 'right', Charlottetown: 'right', "St. John's": 'left' };

const pins = map.offices.map((p) => {
  const o = offices.find((x) => x.city === p.city);
  return { ...o, left: (p.x / map.width) * 100, top: (p.y / map.height) * 100, side: labelSide[p.city] ?? 'right' };
});
const tel = (n) => `tel:+1${n.replaceAll('-', '')}`;
---
<figure class:list={['amap', `amap--${tone}`, bleed && 'amap--bleed']} id={id} data-amap>
  <div class="canvas">
  <svg viewBox={`0 0 ${map.width} ${map.height}`} aria-hidden="true" focusable="false">
    <g class="context">{map.context.map((p) => <path d={p.d} />)}</g>
    <g class="land">{map.provinces.map((p) => <path d={p.d} data-prov={p.id} />)}</g>
  </svg>

  <ul class="pins" aria-label="Our offices">
    {pins.map((p, i) => (
      <li style={`left:${p.left}%;top:${p.top}%`}>
        <button type="button" class:list={['pin', `pin--${p.side}`]} aria-pressed={i === 0 ? 'true' : 'false'} data-index={i}>
          <span class="dot" aria-hidden="true"></span>
          <span class="label">{p.city}</span>
        </button>
      </li>
    ))}
  </ul>
  </div>

  {card && (
    <div class="card" aria-live="polite">
      {pins.map((p, i) => (
        <div class="office" data-office={i} hidden={i !== 0}>
          <p class="office-city">{p.city}, {p.province}{i === 0 && <span class="hq">Head office</span>}</p>
          <p class="office-addr">{p.address}</p>
          <a class="office-tel" href={tel(p.phone)}>{p.phone}</a>
        </div>
      ))}
    </div>
  )}
  <figcaption class="visually-hidden">Map of Atlantic Canada with offices in Halifax, Moncton, Saint John, Charlottetown and St. John's.</figcaption>
</figure>

<script>
  // Selecting a pin shows that office in the card. Runs for every map on the page.
  document.querySelectorAll('[data-amap]').forEach((fig) => {
    const pins = fig.querySelectorAll('.pin');
    const cards = fig.querySelectorAll('[data-office]');
    pins.forEach((pin) => {
      pin.addEventListener('click', () => {
        pins.forEach((p) => p.setAttribute('aria-pressed', String(p === pin)));
        cards.forEach((c) => (c.hidden = c.dataset.office !== pin.dataset.index));
      });
    });
  });
</script>

<style>
  .amap {
    --land: var(--navy);
    --land-edge: #3b5874;
    --context: #dfe7ef;
    --label-bg: var(--navy);
    position: relative; margin: 0;
  }
  /* Pins are positioned as percentages of this box, so it must hold only the map */
  .canvas { position: relative; aspect-ratio: 900 / 820; }
  .amap--dark {
    --land: var(--navy-raised);
    --land-edge: #2f5272;
    --context: #0f2a44;
    --label-bg: #1d4466;
  }
  svg { width: 100%; height: 100%; overflow: hidden; }
  .amap--bleed svg { overflow: visible; }
  .context path { fill: var(--context); }
  .land path { fill: var(--land); stroke: var(--land-edge); stroke-width: 1; stroke-linejoin: round; }

  .pins { list-style: none; margin: 0; padding: 0; }
  .pins li { position: absolute; width: 0; height: 0; }
  .pin {
    position: absolute; transform: translate(-50%, -50%);
    display: flex; align-items: center; gap: 8px;
    background: none; border: 0; padding: 6px; cursor: pointer; font: inherit;
  }
  .pin--left { flex-direction: row-reverse; transform: translate(calc(-100% + 15px), -50%); }
  .pin--right { transform: translate(-15px, -50%); }

  .dot {
    width: 18px; height: 18px; border-radius: var(--radius-round); flex: none;
    background: #fff; border: 4px solid var(--isl-blue);
    box-shadow: 0 0 0 4px rgb(255 255 255 / 0.25);
    transition: transform 180ms var(--ease), border-color 180ms var(--ease);
  }
  .label {
    background: var(--label-bg); color: #fff; white-space: nowrap;
    font-size: 0.8rem; font-weight: 600; line-height: 1; padding: 6px 8px; border-radius: var(--radius);
  }
  .pin:hover .dot, .pin[aria-pressed='true'] .dot { transform: scale(1.25); border-color: var(--contract); }
  .pin[aria-pressed='true'] .label { background: #fff; color: var(--navy); box-shadow: 0 0 0 1px var(--navy); }

  .card {
    position: absolute; right: 2%; bottom: 3%; width: min(300px, 46%);
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--ink); border-radius: var(--radius);
    padding: var(--s4) var(--s5);
  }
  .office-city { font-family: var(--font-display); font-stretch: 112%; font-weight: 750; font-size: 1.1rem; margin-bottom: var(--s1); }
  .hq { display: block; font-family: var(--font-body); font-stretch: 100%; font-weight: 500; font-size: var(--fs-tiny); color: var(--ink-soft); }
  .office-addr { font-size: var(--fs-small); color: var(--ink-soft); line-height: 1.45; margin-bottom: var(--s2); }
  .office-tel { font-weight: 700; font-size: 1.05rem; color: var(--ink); font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) { .amap--bleed svg { overflow: hidden; } }
  @media (max-width: 640px) {
    .label { font-size: 0.7rem; padding: 4px 6px; }
    .dot { width: 14px; height: 14px; border-width: 3px; }
    .card { position: static; width: auto; margin-top: var(--s4); }
  }
</style>

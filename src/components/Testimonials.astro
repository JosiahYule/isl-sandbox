---
// TESTIMONIALS: reads quotes from src/data/site.js
// Usage: <Testimonials /> or <Testimonials limit={1} />
import { testimonials } from '../data/site.js';
const { limit = testimonials.length } = Astro.props;
---
<div class="grid">
  {testimonials.slice(0, limit).map((t) => (
    <figure class="card quote">
      <blockquote>{t.quote}</blockquote>
      <figcaption>{t.who}</figcaption>
    </figure>
  ))}
</div>

<style>
  .quote { margin: 0; display: flex; flex-direction: column; justify-content: space-between; }
  blockquote { margin: 0 0 var(--space-6); font-size: var(--text-lg); }
  figcaption { font-weight: 600; color: var(--color-ink-muted); }
</style>

---
// HOMEPAGE HERO: the brand's photo across the full width, the promise over it, one way in for
// each audience (a job search, and "Request talent"), and the newest real openings along the bottom.
// Shared by all three brands' homepages, so they open the same way.
//
// <HomeHero photo={{ src, position }} lines={['Workers in hours.', 'Hires that stay.']} lead="..." />
//   lines:  the headline, one line each (kept whole on wide screens)
//   latest: the newest open jobs, shown along the bottom edge (three on a computer, two on a phone);
//           none leaves the row out
//   long:   a longer headline (AS and ADS keep their live sites' wording): a size smaller, and it wraps
//   findJob: the label over the job search (default: "Looking for work? Search N open jobs")
import Photo from './Photo.astro';
import { jobs, provinces } from '../data/jobs.js';
import { url } from '../lib/url.js';
const { photo, lines, lead, latest = [], long = false, findJob } = Astro.props;
// Postings often carry the client or a code after a dash ("Construction Manager - NB Power",
// "... Representative – Efficiency Group –CD"): the row shows the job, the posting has the rest
const shortTitle = (t) => String(t).split(/\s+[-–—]\s*|\s*[-–—]\s+/)[0].replace(/\s*\/\s*/g, ' / ').trim();
// One-tap shortcuts under the search: each province (or territory) with open jobs right now, busiest
// first. Any province shows up as soon as the feed has a job there.
const near = [...new Set(jobs.map((j) => j.province).filter(Boolean))]
  .map((code) => ({ code, label: ({ PE: 'PEI' })[code] || provinces[code] || code, n: jobs.filter((j) => j.province === code).length }))
  .sort((a, b) => b.n - a.n);
---
  <section class:list={['hero', long && 'hero--long']}>
    <div class="hero-bg" data-animate>
      <Photo src={photo.src} alt="" ratio="16/9" sizes="100vw" position={photo.position} eager />
    </div>
    <div class="wrap hero-inner">
      <div class="hero-copy" data-stagger>
        <h1 class="hero-title">
          {lines.map((l, i) => <>{i > 0 && " "}<span class="line">{l}</span></>)}
        </h1>
        <p class="hero-lead">{lead}</p>
        <form class="search" action={url('/find-work/')} method="get" role="search" data-isl-live="search">
          <label for="hero-q">{findJob ? `${findJob} Search ${jobs.length} open jobs` : `Looking for work? Search ${jobs.length} open jobs`}</label>
          <div class="search-bar">
            <input id="hero-q" name="q" type="search" placeholder="Job title, skill or city" autocomplete="off" />
            <button type="submit">Search</button>
          </div>
          {near.length > 1 && <p class="near">Or browse {near.map((a, i) => <>{i > 0 && ' '}<a href={url(`/find-work/?province=${a.code}`)}>{a.label} <span>{a.n}</span></a></>)}</p>}
        </form>
        <p class="employer">Hiring? <a class="employer-go" href={url('/hire/')} data-cta-placement="home_hero">Request talent <span aria-hidden="true">→</span></a></p>
      </div>
    </div>

    <!-- The newest openings: still, small and quiet, so the headline and the search lead -->
    {latest.length > 0 && <div class="latest" data-isl-live="latest" data-latest>
      <div class="wrap latest-inner">
        <p class="latest-label">Latest openings</p>
        <ul class="latest-list">
          {latest.slice(0, 3).map((j) => (
            <li><a href={j.url}><strong>{shortTitle(j.title)}</strong><span>{[[j.city, j.province].filter(Boolean).join(', '), j.pay || (j.payStatus === 'conflict' ? j.payLabel : '')].filter(Boolean).join(' · ')}</span></a></li>
          ))}
        </ul>
        <a class="latest-all" href={url('/find-work/')}>All {jobs.length} jobs <span aria-hidden="true">→</span></a>
      </div>
    </div>}
  </section>

<script>
  // When the row of openings sits at the bottom of the screen, the chat button (when it's on) sits
  // just above it instead of covering "All jobs" (--isl-chat-lift is read by the assistant widget)
  const row = document.querySelector<HTMLElement>('[data-latest]');
  if (row && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      const covering = e.isIntersecting && e.boundingClientRect.bottom > innerHeight - 90;
      document.documentElement.style.setProperty('--isl-chat-lift', covering ? `${Math.ceil(innerHeight - e.boundingClientRect.top)}px` : '0px');
    }, { threshold: [0, 0.25, 0.5, 0.75, 1] }).observe(row);
  }
</script>

<style>
  /* ---------- 1. Hero ---------- */
  /* The photo fills the hero; a dark wash from the left keeps the white text readable */
  .hero { position: relative; isolation: isolate; color: #fff; background: var(--dark); min-height: min(calc(100svh - 72px), 880px); display: flex; flex-direction: column; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg :global(.photo), .hero-bg :global(.frame) { height: 100%; margin: 0; }
  .hero-bg :global(.frame) { aspect-ratio: auto !important; }
  .hero-bg::after { content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--wash) 90%, transparent) 0%, color-mix(in srgb, var(--wash) 72%, transparent) 38%, color-mix(in srgb, var(--wash) 20%, transparent) 75%, color-mix(in srgb, var(--wash) 5%, transparent) 100%),
      linear-gradient(0deg, color-mix(in srgb, var(--wash) 85%, transparent) 0%, color-mix(in srgb, var(--wash) 0%, transparent) 30%); }
  .hero-inner { flex: 1; display: flex; align-items: center; padding-block: var(--s8) var(--s7); }
  .hero-copy { max-width: 660px; }

  .hero-title { font-size: var(--fs-hero); font-weight: var(--fw-bold); letter-spacing: -0.03em; line-height: 1; color: #fff; }
  @media (min-width: 901px) { .line { white-space: nowrap; } }
  .line { display: block; }
  .hero--long .hero-copy { max-width: 820px; }
  .hero--long .hero-title { font-size: var(--fs-h1); letter-spacing: -0.025em; line-height: 1.05; }
  .hero--long .line { display: inline; white-space: normal; }

  .hero-lead { margin-top: var(--s6); font-size: var(--fs-lead); font-weight: var(--fw-light); line-height: 1.55; color: rgb(255 255 255 / 0.86); max-width: 38ch; }

  /* Job seekers: the search. Employers: a link beneath it. */
  .search { margin-top: var(--s7); max-width: 36rem; }
  .search label { display: block; font-size: var(--fs-small); font-weight: var(--fw-text); margin-bottom: var(--s2); color: rgb(255 255 255 / 0.86); }
  .search-bar { display: flex; background: #fff; }
  .search-bar input { flex: 1; min-width: 0; width: 0; /* width 0: the box's built-in 20-character width otherwise sets a minimum */ font: inherit; font-size: var(--fs-body); padding: 1rem 1.15rem; border: 0; background: transparent; color: var(--ink); }
  .search-bar input:focus { outline: 2px solid var(--accent); outline-offset: -2px; }
  .search-bar button { font: inherit; font-weight: var(--fw-bold); cursor: pointer; padding: 0 1.6rem; border: 0; background: var(--accent); color: #fff; }
  .search-bar button:hover { background: var(--accent-deep); }
  .near { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s2) var(--s4); margin: var(--s3) 0 0; width: max-content; max-width: min(100%, 44rem); max-width: min(calc(100vw - 2 * var(--gutter)), 44rem); /* may run a little wider than the search, so the four provinces fit on one line */ font-size: var(--fs-small); color: rgb(255 255 255 / 0.72); }
  .near a { color: #fff; text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: rgb(255 255 255 / 0.4); }
  .near a:hover { text-decoration-color: #fff; }
  .near span { font-variant-numeric: tabular-nums; color: rgb(255 255 255 / 0.66); }
  .employer { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3) var(--s4); margin-top: var(--s5); font-weight: var(--fw-text); color: rgb(255 255 255 / 0.86); }
  .employer-go { color: #fff; font-weight: var(--fw-bold); text-decoration: underline; text-underline-offset: 0.25em; text-decoration-thickness: 1.5px; }
  .employer-go span { display: inline-block; transition: transform 0.2s var(--ease); }
  .employer-go:hover span { transform: translateX(3px); }

  /* The photo settles slowly from slightly enlarged */
  :global(.motion) .hero-bg :global(img) { transform: scale(1.08); transition: transform 2.6s var(--ease); }
  :global(.motion) .hero-bg.is-in :global(img) { transform: none; }

  /* Latest openings: three postings in a quiet row along the bottom edge, over the photo's dark wash.
     No box, no motion: a hairline, a small label in the gutter, then the jobs. */
  .latest { border-top: 1px solid rgb(255 255 255 / 0.18); }
  .latest-inner { display: grid; grid-template-columns: 9.5rem 1fr auto; align-items: center; gap: var(--s5) var(--s6); padding-block: var(--s5) var(--s5); }
  .latest-label { margin: 0; font-size: var(--fs-small); color: rgb(255 255 255 / 0.72); }
  .latest-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s6); list-style: none; margin: 0; padding: 0; }
  .latest-list a { display: grid; gap: 2px; color: #fff; text-decoration: none; font-size: var(--fs-small); line-height: 1.35; }
  .latest-list strong { font-weight: var(--fw-bold); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .latest-list span { color: rgb(255 255 255 / 0.78); font-variant-numeric: tabular-nums; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .latest-list a:hover strong { text-decoration: underline; text-underline-offset: 0.2em; }
  .latest-all { justify-self: end; font-size: var(--fs-small); font-weight: var(--fw-bold); color: #fff; text-decoration: underline; text-underline-offset: 0.25em; text-decoration-color: rgb(255 255 255 / 0.4); white-space: nowrap; }
  .latest-all:hover { text-decoration-color: #fff; }
  .latest-all span { display: inline-block; transition: transform 0.2s var(--ease); }
  .latest-all:hover span { transform: translateX(3px); }
  @media (max-width: 1100px) { .latest-list li:nth-child(3) { display: none; } .latest-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero-bg::after { background: linear-gradient(0deg, color-mix(in srgb, var(--wash) 92%, transparent) 0%, color-mix(in srgb, var(--wash) 70%, transparent) 55%, color-mix(in srgb, var(--wash) 45%, transparent) 100%); }
    .hero-inner { padding-block: var(--s8) var(--s7); }
    .search-bar button { padding: 0 1.1rem; }
    /* Phones: the label, two openings one under the other, then the link */
    .latest-inner { grid-template-columns: 1fr auto; gap: var(--s3) var(--s4); padding-block: var(--s5); }
    .latest-label { grid-column: 1; }
    .latest-all { grid-column: 2; grid-row: 1; }
    .latest-list { grid-column: 1 / -1; grid-template-columns: 1fr; gap: var(--s3); }
  }
</style>

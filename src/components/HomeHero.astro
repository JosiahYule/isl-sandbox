---
// HOMEPAGE HERO: the brand's photo across the full width, the promise over it, one way in for
// each audience (a job search, and "Request talent"), and a strip of real open jobs.
// Shared by all three brands' homepages, so they open the same way.
//
// <HomeHero photo={{ src, position }} lines={['Workers in hours.', 'Hires that stay.']} lead="..." />
//   lines:  the headline, one line each (kept whole on wide screens)
//   ticker: the jobs in the "Now hiring" strip; none (or too few to scroll) leaves the strip out
import Photo from './Photo.astro';
import { jobs } from '../data/jobs.js';
import { url } from '../lib/url.js';
const { photo, lines, lead, ticker = [] } = Astro.props;
---
  <section class="hero">
    <div class="hero-bg" data-animate>
      <Photo src={photo.src} alt="" ratio="16/9" sizes="100vw" position={photo.position} eager />
    </div>
    <div class="wrap hero-inner">
      <div class="hero-copy" data-stagger>
        <h1 class="hero-title">
          {lines.map((l, i) => <>{i > 0 && " "}<span class="line">{l}</span></>)}
        </h1>
        <p class="hero-lead">{lead}</p>
        <form class="search" action={url('/find-work/')} method="get" role="search">
          <label for="hero-q">Looking for work? Search {jobs.length} open jobs</label>
          <div class="search-bar">
            <input id="hero-q" name="q" type="search" placeholder="Job title, skill or city" autocomplete="off" />
            <button type="submit">Search</button>
          </div>
        </form>
        <p class="employer">Hiring? <a class="employer-go" href={url('/hire/')}>Request talent <span aria-hidden="true">→</span></a></p>
      </div>
    </div>

    {ticker.length > 0 && <div class="ticker" aria-label="Now hiring" data-ticker>
      <p class="ticker-label"><span class="pulse" aria-hidden="true"></span>Now hiring</p>
      <!-- Moving content needs a way to stop it (WCAG 2.2.2): hover and focus pause it, but touch screens have neither -->
      <button type="button" class="ticker-toggle" aria-pressed="false" data-ticker-toggle>
        <svg class="i-pause" viewBox="0 0 16 16" aria-hidden="true"><rect x="3.5" y="3" width="3" height="10"/><rect x="9.5" y="3" width="3" height="10"/></svg>
        <svg class="i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z"/></svg>
        <span class="visually-hidden">Pause the job list</span>
      </button>
      <div class="ticker-track">
        {[0, 1].map((copy) => (
          <ul class="ticker-list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {ticker.map((j) => (
              <li><a href={j.url} tabindex={copy === 1 ? -1 : undefined}><strong>{j.title.replace(/\s*\/\s*/g, ' / ')}</strong><span>{j.city}, {j.province}</span><span>{j.pay}</span></a></li>
            ))}
          </ul>
        ))}
      </div>
    </div>}
  </section>

<script>
  // The ticker's pause button: pressed = paused
  const tk = document.querySelector<HTMLElement>('[data-ticker]');
  const tb = tk?.querySelector<HTMLButtonElement>('[data-ticker-toggle]');
  tb?.addEventListener('click', () => {
    const paused = tk!.classList.toggle('is-paused');
    tb.setAttribute('aria-pressed', String(paused));
    tb.querySelector('.visually-hidden')!.textContent = paused ? 'Play the job list' : 'Pause the job list';
  });
</script>

<style>
  /* ---------- 1. Hero ---------- */
  /* The photo fills the hero; a dark wash from the left keeps the white text readable */
  .hero { position: relative; isolation: isolate; color: #fff; background: var(--dark); min-height: min(calc(100svh - 72px), 880px); display: flex; flex-direction: column; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg :global(.photo), .hero-bg :global(.frame) { height: 100%; margin: 0; }
  .hero-bg :global(.frame) { aspect-ratio: auto !important; }
  .hero-bg::after { content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(20 20 20 / 0.9) 0%, rgb(20 20 20 / 0.72) 38%, rgb(20 20 20 / 0.2) 75%, rgb(20 20 20 / 0.05) 100%),
      linear-gradient(0deg, rgb(20 20 20 / 0.85) 0%, rgb(20 20 20 / 0) 30%); }
  .hero-inner { flex: 1; display: flex; align-items: center; padding-block: var(--s8) var(--s7); }
  .hero-copy { max-width: 660px; }

  .hero-title { font-size: var(--fs-hero); font-weight: var(--fw-bold); letter-spacing: -0.03em; line-height: 1; color: #fff; }
  @media (min-width: 901px) { .line { white-space: nowrap; } }
  .line { display: block; }

  .hero-lead { margin-top: var(--s6); font-size: var(--fs-lead); font-weight: var(--fw-light); line-height: 1.55; color: rgb(255 255 255 / 0.86); max-width: 38ch; }

  /* Job seekers: the search. Employers: one button. */
  .search { margin-top: var(--s7); max-width: 36rem; }
  .search label { display: block; font-size: var(--fs-small); font-weight: var(--fw-text); margin-bottom: var(--s2); color: rgb(255 255 255 / 0.86); }
  .search-bar { display: flex; background: #fff; }
  .search-bar input { flex: 1; min-width: 0; width: 0; /* width 0: the box's built-in 20-character width otherwise sets a minimum */ font: inherit; font-size: var(--fs-body); padding: 1rem 1.15rem; border: 0; background: transparent; color: var(--ink); }
  .search-bar input:focus { outline: 2px solid var(--accent); outline-offset: -2px; }
  .search-bar button { font: inherit; font-weight: var(--fw-bold); cursor: pointer; padding: 0 1.6rem; border: 0; background: var(--accent); color: #fff; }
  .search-bar button:hover { background: var(--accent-deep); }
  .employer { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3) var(--s4); margin-top: var(--s5); font-weight: var(--fw-text); color: rgb(255 255 255 / 0.86); }
  /* A link, not a second solid button: in greyscale a white button outshone Search */
  .employer-go { color: #fff; font-weight: var(--fw-bold); text-decoration: underline; text-underline-offset: 0.25em; text-decoration-thickness: 1.5px; }
  .employer-go span { display: inline-block; transition: transform 0.2s var(--ease); }
  .employer-go:hover span { transform: translateX(3px); }

  /* The photo settles slowly from slightly enlarged */
  :global(.motion) .hero-bg :global(img) { transform: scale(1.08); transition: transform 2.6s var(--ease); }
  :global(.motion) .hero-bg.is-in :global(img) { transform: none; }

  /* Now hiring: real postings scrolling along the bottom edge. Pauses on hover or focus. */
  .ticker { position: relative; display: flex; min-width: 0; max-width: 100%; align-items: stretch; border-top: 1px solid rgb(255 255 255 / 0.16); background: var(--dark); }
  /* Solid, not see-through: over a light patch of photo, translucent grey text failed contrast */
  .ticker-label { flex: none; display: flex; align-items: center; gap: var(--s2); margin: 0; padding: 0 var(--s5) 0 var(--gutter); font-size: var(--fs-small); font-weight: var(--fw-bold); background: var(--accent); color: #fff; white-space: nowrap; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #fff; }
  :global(.motion) .pulse { animation: pulse 2s ease-out infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgb(255 255 255 / 0.7); } 70%, 100% { box-shadow: 0 0 0 8px rgb(255 255 255 / 0); } }
  .ticker-track { display: flex; overflow: hidden; flex: 1; min-width: 0; mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); }
  .ticker-list { display: flex; flex: none; list-style: none; margin: 0; padding: 0; }
  :global(.motion) .ticker-list { animation: ticker 70s linear infinite; }
  .ticker:hover .ticker-list, .ticker:focus-within .ticker-list, .ticker.is-paused .ticker-list { animation-play-state: paused; }
  .ticker.is-paused .pulse { animation: none; }
  /* Pause / play: only shown when the list actually moves */
  .ticker-toggle { display: none; flex: none; place-items: center; width: 44px; border: 0; border-right: 1px solid rgb(255 255 255 / 0.16); background: var(--dark); color: #fff; cursor: pointer; }
  :global(.motion) .ticker-toggle { display: grid; }
  .ticker-toggle svg { width: 14px; height: 14px; fill: currentColor; }
  .ticker-toggle .i-play, .ticker.is-paused .ticker-toggle .i-pause { display: none; }
  .ticker.is-paused .ticker-toggle .i-play { display: block; }
  .ticker-toggle:hover { background: #000; }
  @keyframes ticker { to { transform: translateX(-100%); } }
  .ticker-list a { display: flex; gap: var(--s3); align-items: baseline; padding: var(--s4) var(--s6) var(--s4) 0; margin-left: var(--s6); color: #fff; text-decoration: none; white-space: nowrap; font-size: var(--fs-small); border-left: 1px solid rgb(255 255 255 / 0.16); padding-left: var(--s6); margin-left: 0; }
  .ticker-list a span { color: rgb(255 255 255 / 0.66); }
  .ticker-list a:hover strong { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .ticker-track { overflow-x: auto; } }

  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero-bg::after { background: linear-gradient(0deg, rgb(20 20 20 / 0.92) 0%, rgb(20 20 20 / 0.7) 55%, rgb(20 20 20 / 0.45) 100%); }
    .hero-inner { padding-block: var(--s8) var(--s7); }
    .search-bar button { padding: 0 1.1rem; }
    .ticker-label { padding-left: var(--s4); padding-right: var(--s4); }
  }
</style>

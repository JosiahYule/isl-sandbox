---
// OFFICE LIST: reads from src/data/site.js. Used on Contact (and anywhere else you want it).
// No embedded Google Maps on purpose: each live map is heavy. The address links out to Maps instead.
import { offices } from '../data/site.js';
---
<div class="grid">
  {offices.map((o) => (
    <article class="card">
      <h3>{o.city}, {o.province}</h3>
      <p>
        <a href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(o.address)}`}>{o.address}</a>
      </p>
      <p><a href={`tel:+1${o.phone.replaceAll('-', '')}`}>{o.phone}</a></p>
    </article>
  ))}
</div>

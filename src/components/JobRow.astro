---
// JOB ROW: one real posting. The coloured edge says contract (near-black) or permanent (ISL blue).
// The title opens the job's page here (/find-work/<slug>/); Apply goes straight to the application.
const { job } = Astro.props;
const posted = job.posted
  ? new Date(job.posted + 'T12:00:00').toLocaleDateString('en-CA', { month: 'short', day: 'numeric' })
  : '';
const where = [job.city, job.province].filter(Boolean).join(', ');
const field = [job.category, job.subcategory].filter(Boolean).join(', ');
---
<article class:list={['job', `job--${job.type}`]} data-job-id={job.id}
  data-type={job.type} data-province={job.province} data-area={job.area} data-industry={job.industry}
  data-search={`${job.title} ${field} ${job.city} ${job.province} ${job.description || job.snippet || ''}`}>
  <div class="main">
    <h3><a href={job.url}>{job.title}</a></h3>
    <p class="where">{where}</p>
  </div>
  <p class:list={['svc', `svc--${job.type}`]}>{job.typeLabel}</p>
  <p class:list={['pay', !job.pay && 'pay--none']}>{job.pay || job.payLabel || 'Pay discussed at interview'}</p>
  <div class="end">
    {posted && <p class="posted">Posted {posted}</p>}
    <a class="apply" href={job.applyUrl}>Apply<span class="visually-hidden"> for {job.title}</span></a>
  </div>
</article>

<style>
  .job {
    position: relative;
    display: grid; grid-template-columns: minmax(0, 2.2fr) 0.9fr 1.2fr 13rem; /* fixed last column, so every row lines up */ gap: var(--s4); align-items: center;
    padding: var(--s5) 0 var(--s5) var(--s5);
    border-bottom: 1px solid var(--line);
    transition: background-color 150ms var(--ease);
  }
  .job::before { content: ''; position: absolute; left: 0; top: var(--s4); bottom: var(--s4); width: 4px; }
  .job--contract::before { background: var(--contract); }
  .job--direct::before { background: var(--direct); }
  .job:hover { background: var(--mist); }

  .job p { margin: 0; } /* the site's paragraph spacing doesn't belong inside a row */
  h3 { font-size: var(--fs-h3); }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .where { color: var(--ink-soft); font-size: var(--fs-small); margin-top: var(--s1); }
  .pay { font-weight: var(--fw-bold); font-variant-numeric: tabular-nums; }
  .pay--none { color: var(--ink-soft); font-weight: var(--fw-text); }
  .end { display: flex; align-items: center; gap: var(--s5); justify-content: flex-end; padding-right: var(--s4); }
  .posted { font-size: var(--fs-small); color: var(--ink-soft); white-space: nowrap; }
  .apply {
    font-weight: var(--fw-bold); font-size: var(--fs-small); text-decoration: none; white-space: nowrap;
    padding: 0.5rem 0.9rem; border: 1.5px solid var(--accent); color: var(--accent);
  }
  .apply:hover { background: var(--accent); color: #fff; }

  /* Phones: title and type on top, then pay with the date under it and Apply beside them,
     so each job takes about a third less height and more of the list fits on screen */
  @media (max-width: 860px) {
    .job { grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: 'main svc' 'pay apply' 'posted apply'; gap: 2px var(--s4); padding: var(--s4) 0 var(--s4) var(--s4); }
    .main { grid-area: main; margin-bottom: var(--s3); }
    .svc { grid-area: svc; align-self: start; }
    .pay { grid-area: pay; }
    .end { display: contents; }
    .posted { grid-area: posted; }
    .apply { grid-area: apply; align-self: center; padding: 0.6rem 1rem; }
  }
</style>

---
// HERO FIGURE: the one number that matters on an inner page, set large on the right of the intro.
// Used in PageHero's aside slot on Hire, Find work, Team, Learn and Contact so they all open the same way.
// The number counts up when it's numeric. Anything inside the tag (a bar, a phone line) sits under it.
//
// <HeroFigure figure="53" label="roles open right now"><p>optional extra</p></HeroFigure>
const { figure, label } = Astro.props;
const counts = /^\d/.test(String(figure));
---
<div class="hf" data-animate>
  <p class="hf-n"><span class="figure" data-countup={counts ? '' : undefined}>{figure}</span><span class="hf-l">{label}</span></p>
  <slot />
</div>

<style>
  .hf { border-top: 1.5px solid var(--ink); padding-top: var(--s4); width: 100%; max-width: 24rem; justify-self: end; }
  .hf-n { display: grid; gap: var(--s2); margin: 0; }
  .figure { font-size: clamp(3.4rem, 2rem + 4vw, 5.2rem); color: var(--isl-blue); }
  .hf-l { color: var(--ink-soft); }
  .hf :global(.hf-extra) { margin-top: var(--s5); padding-top: var(--s4); border-top: 1px solid var(--line); font-weight: 500; }
  :global(.motion) .hf { opacity: 0; transform: translateY(14px); transition: opacity 0.8s var(--ease) 0.3s, transform 0.8s var(--ease) 0.3s; }
  :global(.motion) .hf.is-in { opacity: 1; transform: none; }
  @media (max-width: 900px) { .hf { justify-self: start; } }
</style>

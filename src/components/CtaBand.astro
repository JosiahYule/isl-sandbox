---
// CLOSING CALL TO ACTION: the dark band that ends most pages.
import Button from './Button.astro';
import { brand } from '../data/site.js';

const {
  title = 'Tell us who you need.',
  text = 'Contract workers or a permanent hire. A recruiter replies within one business day.',
  href = '/hire/',
  label = 'Request talent',
} = Astro.props;
const tel = `tel:+1${brand.mainPhone.replaceAll('-', '')}`;
---
<section class="cta on-dark">
  <div class="wrap inner">
    <h2>{title}</h2>
    <div class="side">
      <p>{text}</p>
      <div class="actions">
        <Button href={href} variant="light" size="lg">{label}</Button>
        <a class="phone" href={tel}>Or call {brand.mainPhone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(4rem, 9vw, 7.5rem); border-bottom: 1px solid var(--line-dark); }
  .inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--s7); align-items: end; }
  h2 { font-size: var(--fs-h1); max-width: 12ch; }
  .side p { color: var(--on-dark-soft); font-size: var(--fs-lead); max-width: 36ch; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s5); margin-top: var(--s5); }
  .phone { font-weight: 600; }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; } }
</style>

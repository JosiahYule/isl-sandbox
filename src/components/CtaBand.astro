---
// CALL-TO-ACTION BAND: a dark strip that closes most pages.
// Defaults to the employer request; pass props to change the wording.
import Button from './Button.astro';
import { brand } from '../data/site.js';

const {
  title = 'Ready to fill your open roles?',
  text = 'Tell us what you need. A recruiter will follow up within one business day.',
  href = '/hire/',
  label = 'Request talent',
} = Astro.props;
---
<section class="section section--dark">
  <div class="container band">
    <div>
      <h2>{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="actions">
      <Button href={href} variant="light">{label}</Button>
      <a class="phone" href={`tel:+1${brand.mainPhone.replaceAll('-', '')}`}>Call {brand.mainPhone}</a>
    </div>
  </div>
</section>

<style>
  .band {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: var(--space-8);
  }
  .band h2 { margin-bottom: var(--space-3); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-6); }
  .phone { font-weight: 600; }
</style>

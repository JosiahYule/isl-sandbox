---
// CLOSING CALL TO ACTION: the dark band that ends most pages.
import Button from './Button.astro';
import { brand, cta } from '../data/site.js';
import { PEOPLE } from '../../assistant/supabase/functions/_shared/routing.js';
import { url } from '../lib/url.js';
import { asset, sized } from '../lib/img.js';
import { team } from '../data/team.js';
// The people who answer requests, so the promise has faces (ISL only for now: AS and ADS show the
// promise without faces until their team is in the site). service="contract" shows the four provincial
// contacts, service="direct" the direct hire team, and no service everyone who takes new requests.
const {
  title = cta.title ?? 'Tell us who you need.',
  text = cta.text,
  href = '/hire/',
  label = 'Request talent',
  service,
} = Astro.props;
const provincial = ['meg', 'kelli', 'chance', 'crystal'].map((k) => PEOPLE[k]).filter(Boolean)
  .map((p) => ({ name: p.name, first: p.first, photo: asset(p.photo) }));
const directTeam = team.filter((p) => p.team === 'Direct Hire').map((p) => ({ name: p.name, first: p.name.split(' ')[0], photo: p.photo && sized(p.photo, 500) }));
const repliers = !cta.faces ? []
  : service === 'contract' ? provincial
  : service === 'direct' ? directTeam
  : [...provincial, { name: PEOPLE.zowie.name, first: PEOPLE.zowie.first, photo: asset(PEOPLE.zowie.photo) }];
const names = repliers.map((p) => p.first);
const nameList = names.slice(0, -1).join(', ') + ' and ' + names.at(-1);
const promise = service === 'direct' ? `${nameList} run every search.` : service === 'contract' ? `${nameList} answer every contract request.` : `${nameList} answer every request.`;
const tel = `tel:+1${brand.mainPhone.replaceAll('-', '')}`;
---
<section class:list={['cta', brand.ctaTone === 'bright' ? 'cta--bright' : 'on-dark']}>
  <div class="wrap inner">
    <h2>{title}</h2>
    <div class="side">
      <p>{text}</p>
      {repliers.length > 0 && <div class="who">
        <span class="faces" aria-hidden="true">{repliers.map((p) => <span class="face"><span class="ini">{p.name.split(' ').map((w) => w[0]).join('')}</span>{p.photo && <img src={p.photo} alt="" width="40" height="40" loading="lazy" onerror="this.remove()" />}</span>)}</span>
        <span class="names">{promise}</span>
      </div>}
      <div class="actions">
        <Button href={href} variant="light" size="lg">{label}</Button>
        {cta.candidateLink && !Astro.props.href && <a class="candidate" href={url('/find-work/')}>Find your next job →</a>}
        <a class="phone" href={tel}>Or call {brand.mainPhone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(4rem, 9vw, 7.5rem); border-bottom: 1px solid var(--line-dark); }
  .inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--s7); align-items: end; }
  h2 { font-size: var(--fs-h2); max-width: 14ch; } /* the same size as every other section heading */
  .side p { color: var(--on-dark-soft); font-size: var(--fs-lead); max-width: 36ch; }
  .who { display: flex; align-items: center; gap: var(--s3); margin-top: var(--s4); }
  .faces { display: flex; flex: none; }
  /* Each face: initials underneath, the photo over them (if a photo ever fails, the initials show) */
  .face { position: relative; display: grid; place-items: center; width: 40px; height: 40px; background: #2a2a2a; border: 2px solid var(--dark); }
  .face + .face { margin-left: -8px; }
  .face .ini { font-size: var(--fs-tiny); font-weight: var(--fw-bold); color: var(--on-dark-soft); }
  .face img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .names { font-size: var(--fs-small); color: var(--on-dark-soft); line-height: 1.4; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s5); margin-top: var(--s5); }
  .phone { font-weight: var(--fw-bold); }
  .candidate { font-weight: var(--fw-bold); text-underline-offset: 0.2em; }
  /* ADS: the band in the brand's bright colour, with dark text */
  .cta--bright { background: var(--bright); color: var(--bright-ink); border-bottom: 0; }
  .cta--bright h2, .cta--bright .side p, .cta--bright .phone, .cta--bright .candidate { color: var(--bright-ink); }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; } }
</style>

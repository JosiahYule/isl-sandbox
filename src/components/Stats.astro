---
// STATS ROW: reads the numbers from src/data/site.js
import { stats } from '../data/site.js';
---
<dl class="stats">
  {stats.map((s) => (
    <div>
      <dt>{s.label}</dt>
      <dd>{s.value}</dd>
    </div>
  ))}
</dl>

<style>
  .stats {
    display: grid; gap: var(--space-6); margin: 0;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  .stats div { display: flex; flex-direction: column; }
  /* the number (dd) comes after the label in the HTML for screen readers, but shows first */
  dd { order: -1; margin: 0; font-size: var(--text-2xl); font-weight: 700; line-height: 1; }
  dt { margin-top: var(--space-2); color: inherit; opacity: 0.75; }
</style>

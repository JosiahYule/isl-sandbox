---
// WE RECRUIT. IT'S THAT SIMPLE.
// The live site's signature line, then the two services, each with the two figures that back up
// "simple" and a link into that service's page. (The three short lines that sat beside the heading
// repeated the hero and the offices map, so they came out in the November 2026 tidy-up.)
//
// <WeRecruit title={['One field.', 'Every level.']} services={[...]} />
import ServiceBlocks from './ServiceBlocks.astro';
import { stat, showFigure } from '../data/site.js';
// The average search time is shown only once it's confirmed (src/brands/isl.js); until then, live
// sites say where the search reaches instead
const fill = stat('timeToFill');
const fillFig = showFigure(fill) ? [`${fill.value} days`, 'average search, brief to hire', fill] : ['Nationwide', 'permanent searches across Canada'];
const {
  title = ['We recruit.', 'It’s that simple.'],
  // What "simple" means, by service: each block is the way into that service's page.
  // Contract in near-black, direct hire in the brand colour (the site's colour key).
  services = [
    { key: 'contract', name: 'Contract staffing', href: '/contract/', go: 'How contract staffing works',
      figs: [['One rate', 'per worker, payroll included'], ['Temp to perm', 'try someone, then hire them']] },
    { key: 'direct', name: 'Direct hire', href: '/direct-hire/', go: 'How direct hire works',
      figs: [fillFig, ['90 days', 'replacement guarantee']] },
  ],
} = Astro.props;
---
<section class="section we">
  <div class="wrap">
    <h2 class="we-title" data-reveal><span class="line we-blue">{title[0]}</span> <span class="line">{title[1]}</span></h2>
    <ServiceBlocks services={services} />
  </div>
</section>

<style>
  .we-title { font-weight: var(--fw-light); font-size: var(--fs-h1); letter-spacing: -0.035em; line-height: 1.02; margin: 0; }
  .we-title .line { display: block; }
  .we-blue { color: var(--direct); }
</style>

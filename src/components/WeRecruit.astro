---
// WE RECRUIT. IT'S THAT SIMPLE.
// The live site's signature line, kept simple: the heading, and three short lines beside it
// (where we are, what we recruit for, how we match). One thing moves: the industry word.
//
// Accessibility: the rolling word is decoration (aria-hidden). Screen readers get the
// full sentence with every industry instead. With reduced motion the word stays put.
const industries = ['construction', 'logistics', 'manufacturing', 'oil and gas', 'skilled trades', 'hospitality', 'administration'];
const list = industries.slice(0, -1).join(', ') + ' and ' + industries.at(-1);
---
<section class="section we" data-we>
  <div class="wrap we-grid">
    <h2 class="we-title" data-reveal><span class="line we-blue">We recruit.</span> <span class="line">It’s that simple.</span></h2>

    <ul class="we-lines" data-stagger>
      <li>Based in Halifax, with offices across Atlantic Canada.</li>
      <li>
        <span class="visually-hidden">Specializing in {list}.</span>
        <span aria-hidden="true">Specializing in <span class="roll">{industries.map((w, i) => <span class:list={['word', i === 0 && 'on']}>{w}.</span>)}</span></span>
      </li>
      <li>People matched to work that fits their skills and goals.</li>
    </ul>
  </div>
</section>

<script>
  // Swap the industry word every couple of seconds, only while it's on screen
  // and only when the visitor's device allows motion.
  const roll = document.querySelector<HTMLElement>('[data-we] .roll');
  if (roll && document.documentElement.classList.contains('motion')) {
    const words = [...roll.querySelectorAll<HTMLElement>('.word')];
    let i = 0;
    let timer: number | undefined;
    const step = () => {
      const prev = words[i];
      prev.classList.replace('on', 'out');
      setTimeout(() => prev.classList.remove('out'), 600);
      i = (i + 1) % words.length;
      words[i].classList.add('on');
    };
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !timer) timer = window.setInterval(step, 2200);
      if (!e.isIntersecting && timer) { clearInterval(timer); timer = undefined; }
    }).observe(roll);
  }
</script>

<style>
  .we-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s6) var(--s8); align-items: center; }
  .we-title { font-weight: 300; font-size: clamp(2.6rem, 1rem + 4.4vw, 5rem); letter-spacing: -0.035em; line-height: 1.02; margin: 0; }
  .we-blue { color: var(--isl-blue); }

  /* Three lines between hairlines, the same rhythm as the site's other lists */
  .we-lines { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .we-lines li { padding-block: var(--s5); border-bottom: 1px solid var(--line); font-size: var(--fs-lead); line-height: 1.4; }

  /* The rolling word: every word sits in the same grid cell, so the box is as wide as the
     longest one and nothing around it shifts. Each word carries its own full stop, so a short
     word never leaves a gap before the period. The current word is in place; the next waits
     below, the last slides out above. */
  .roll { display: inline-grid; vertical-align: bottom; overflow: hidden; color: var(--isl-blue); font-weight: 600; }
  .word { grid-area: 1 / 1; white-space: nowrap; opacity: 0; transform: translateY(100%); }
  .word.on { opacity: 1; transform: none; }
  :global(.motion) .word { transition: transform 0.55s var(--ease), opacity 0.4s; }
  :global(.motion) .word.out { opacity: 0; transform: translateY(-100%); }

  @media (max-width: 900px) {
    .we-grid { grid-template-columns: 1fr; }
  }
</style>

---
// SITE FOOTER
// The offices row is the most useful thing in a staffing footer: a direct line to each office.
import { brand, nav, offices, social, images } from '../data/site.js';
import { url } from '../lib/url.js';
import { areas } from '../data/areas.js';
const { offices: showOffices = true } = Astro.props;
const year = new Date().getFullYear(); // never goes stale
const tel = (n) => `tel:+1${n.replaceAll('-', '')}`;
const areaKey = (city) => areas.find((a) => a.label === city)?.key;
---
<footer class="footer on-dark">
  <div class="wrap">
    {showOffices && <div class="offices">
      {offices.map((o) => (
        <div class="office">
          {areaKey(o.city) ? <a class="city" href={url(`/offices/${areaKey(o.city)}/`)}>{o.city}<span>{o.province}</span></a> : <p class="city">{o.city}<span>{o.province}</span></p>}
          <a class="phone" href={tel(o.phone)}>{o.phone}</a>
          <p class="addr">{o.address.replace(/,\s*(NS|NB|PE|NL)\s.*$/, '')}</p>
          {areaKey(o.city) && <a class="near" href={url(`/find-work/?area=${areaKey(o.city)}`)}>Jobs near {o.city}</a>}
        </div>
      ))}
    </div>}

    <div class:list={['lower', !showOffices && 'lower--top']}>
      <div class="about">
        <a class="flogo" href={url('/')} aria-label={`${brand.name} home`}>
          <img src={brand.logo} alt="" width="190" height="46" loading="lazy" onerror="this.parentElement.classList.add('no-img'); this.remove();" />
          <span class="fword" aria-hidden="true">Integrated<br />Staffing</span>
        </a>
        <p>{brand.name} has connected employers and job seekers since {brand.since}. Locally owned and operated.</p>
        <div class="badges">
          <img src={images.badgeBestPlaces} alt="Best Places to Work" width="64" height="64" loading="lazy" onerror="this.remove()" />
          <img src={images.badgeCor} alt="COR certified" width="64" height="64" loading="lazy" onerror="this.remove()" />
        </div>
      </div>
      <nav aria-label="Footer">
        <ul>{nav.map((i) => <li><a href={url(i.href)}>{i.label}</a></li>)}</ul>
        <ul>{social.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
      </nav>
    </div>

    <!-- TODO: confirm this wording with ISL before going live -->
    <p class="scam"><strong>Recruitment scam alert.</strong> {brand.name} never charges job seekers a fee and never asks for banking details to apply. If someone claiming to be us does, call your nearest office.</p>
    <p class="legal">© {year} {brand.name}. All rights reserved. <a href={url('/privacy/')}>Privacy</a> <a href={url('/terms/')}>Terms</a> <a href={url('/accessibility/')}>Accessibility</a></p>
  </div>
</footer>

<style>
  .footer { padding-block: var(--s8) var(--s6); }
  .footer a { text-decoration: none; }
  .footer a:hover { text-decoration: underline; }

  .offices {
    display: grid; grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid var(--line-dark);
  }
  .office { display: flex; flex-direction: column; align-items: flex-start; padding: var(--s5) var(--s4) var(--s5) 0; }
  .office + .office { padding-left: var(--s4); border-left: 1px solid var(--line-dark); }
  .city { font-weight: var(--fw-bold);
    font-size: var(--fs-h3); letter-spacing: -0.01em; margin-bottom: var(--s2);
  }
  a.city { color: #fff; display: block; }
  .city span { margin-left: 0.4em; color: var(--on-dark-soft); font-weight: var(--fw-text); font-size: var(--fs-small); }
  .phone { font-weight: var(--fw-bold); color: #fff; font-variant-numeric: tabular-nums; }
  .addr { color: var(--on-dark-soft); font-size: var(--fs-small); margin-top: var(--s2); line-height: 1.45; }

  .lower {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--s7);
    margin-top: var(--s7); padding-top: var(--s6); border-top: 1px solid var(--line-dark);
  }
  .lower--top { margin-top: 0; }
  /* The logo file is dark; brightness(0) + invert(1) turns every colour in it to white for the dark footer */
  .flogo { display: inline-block; margin-bottom: var(--s4); color: #fff; }
  .flogo img { height: 40px; width: auto; filter: brightness(0) invert(1); }
  .fword { display: none; font-weight: var(--fw-bold); font-size: var(--fs-h3); line-height: 1; letter-spacing: -0.01em; }
  .flogo:global(.no-img) .fword { display: block; }
  .about p { color: var(--on-dark-soft); max-width: 42ch; }
  .badges { display: flex; gap: var(--s4); margin-top: var(--s5); }
  .badges img { height: 56px; width: auto; }
  nav { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s5); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); align-content: start; }
  .near { display: inline-block; margin-top: auto; padding-top: var(--s3); font-size: var(--fs-small); text-decoration: underline !important; text-underline-offset: 0.2em; color: var(--on-dark-soft); }
  .near:hover { color: #fff; }
  .scam { margin-top: var(--s7); padding-top: var(--s4); border-top: 1px solid var(--line-dark); font-size: var(--fs-small); color: var(--on-dark-soft); }
  .scam strong { color: #fff; font-weight: var(--fw-bold); }
  .legal { margin-top: var(--s4); font-size: var(--fs-tiny); color: var(--on-dark-soft); }
  .legal a { color: var(--on-dark-soft); margin-left: var(--s4); text-decoration: underline !important; text-underline-offset: 0.2em; }
  .legal a:hover { color: #fff; }

  @media (max-width: 900px) {
    .offices { grid-template-columns: repeat(auto-fill, minmax(min(100%, 8.5rem), 1fr)); } /* two across, one when there isn't room */
    .office, .office + .office { padding: var(--s4) var(--s3) var(--s4) 0; border-left: 0; border-bottom: 1px solid var(--line-dark); }
    .lower { grid-template-columns: 1fr; gap: var(--s6); }
  }
</style>

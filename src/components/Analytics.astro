---
// Consent-gated GA4 plus anonymous enquiry attribution. No Google requests before acceptance.
// The always-present script also carries campaign context into the request form when GA4 is off.
import { analytics, brand } from '../data/site.js';
import { url } from '../lib/url.js';
const { part = 'head' } = Astro.props;
const id = analytics?.ga4 || '';
---
{part === 'body' && <>
  <div hidden data-analytics-config data-ga4={id} data-brand={brand.key} data-site-root={url('/')} />
  {id && <div class="consent" data-consent hidden role="region" aria-label="Cookie choice">
    <p>We’d like to count visits to improve this site. No advertising cookies. <a href={url('/privacy/')}>Privacy</a></p>
    <div class="c-btns">
      <button type="button" data-consent-choice="granted">Accept</button>
      <button type="button" data-consent-choice="denied" class="c-no">No thanks</button>
    </div>
  </div>}
  <script>import '../scripts/analytics.js';</script>
</>}

<style>
  .consent { position: fixed; z-index: 2147482000; left: var(--s4); bottom: var(--s4); max-width: 26rem; background: var(--ink); color: #fff; padding: var(--s4) var(--s5); display: grid; gap: var(--s3); font-size: var(--fs-small); }
  .consent[hidden] { display: none; }
  .consent p { margin: 0; line-height: 1.5; }
  .consent a { color: #fff; }
  .c-btns { display: flex; gap: var(--s2); }
  .c-btns button { font: inherit; font-weight: var(--fw-bold); padding: 0.55rem 1rem; border: 1.5px solid #fff; background: #fff; color: var(--ink); cursor: pointer; }
  .c-btns .c-no { background: transparent; color: #fff; }
</style>

---
// CONTACT CARD: one person (or office) to talk to, with the same details the chatbot shows.
// Data comes from assistant/supabase/functions/_shared/routing.js, so the site and the
// chatbot always name the same person.
//
// <ContactCard label="Contract staffing" person={PEOPLE.meg} office={OFFICES.halifax} href="/hire/?service=contract" cta="Request workers" />
import { url } from '../lib/url.js';
const { label, person, office, href, cta = 'Request talent' } = Astro.props;
const name = person?.name ?? `${office.city} office`;
const phone = person?.phone || office?.phone;
const initials = name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
const tel = (n) => `tel:+1${String(n).replace(/\D/g, '')}`;
---
<div class="cc">
  {label && <p class="cc-label">{label}</p>}
  <div class="cc-who">
    <span class="cc-face">{person?.photo ? <img src={person.photo} alt="" loading="lazy" onerror="this.remove()" /> : null}<span aria-hidden="true">{initials}</span></span>
    <div>
      <p class="cc-name">{name}</p>
      <p class="cc-handles">{person?.handles ?? office?.address}</p>
    </div>
  </div>
  <p class="cc-reach">
    {phone && <a href={tel(phone)}>{phone}</a>}
    {person?.email && <a href={`mailto:${person.email}`}>{person.email}</a>}
  </p>
  {href && <a class="cc-go" href={url(href)}>{cta}</a>}
</div>

<style>
  .cc { display: grid; gap: var(--s4); align-content: start; padding-top: var(--s4); background: linear-gradient(var(--ink), var(--ink)) no-repeat left top / 100% 1.5px; }
  .cc-label { font-size: var(--fs-small); font-weight: 600; color: var(--ink-soft); margin: 0; }
  .cc-who { display: flex; gap: var(--s4); align-items: center; }
  .cc-face { position: relative; width: 72px; height: 72px; flex: none; background: var(--mist); overflow: hidden; display: grid; place-items: center; font-weight: 300; font-size: 1.4rem; color: var(--ink-soft); }
  .cc-face img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; z-index: 1; }
  .cc-name { font-weight: 700; font-size: 1.2rem; margin: 0; letter-spacing: -0.01em; }
  .cc-handles { margin: 2px 0 0; color: var(--ink-soft); font-size: var(--fs-small); }
  .cc-reach { display: grid; gap: 2px; margin: 0; font-weight: 600; }
  .cc-reach a { color: var(--ink); text-decoration: none; width: fit-content; }
  .cc-reach a:hover { text-decoration: underline; }
  .cc-go { justify-self: start; font-weight: 600; background: var(--isl-blue); color: #fff; text-decoration: none; padding: 0.75rem 1.2rem; }
  .cc-go:hover { background: var(--isl-blue-deep); color: #fff; }
</style>

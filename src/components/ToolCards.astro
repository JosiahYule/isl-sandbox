---
// TOOL CARDS: ISL's recruitment intelligence tools (src/data/tools.js), each with a small
// preview of the answer the tool gives. Used on the homepage, the Learn page and /learn/tools/.
//
// Every preview has the same four parts, so the row reads as one set:
//   a label, one figure, one line saying what it means, and one bar along the bottom.
// Every number is computed from the tool's own data, never typed in:
//   jobs:   Atlantic unemployment from the latest Labour Force Survey, one segment per province (src/lib/lfs.js)
//   cost:   trueCost() for a $20/hour, 40-hour job in Nova Scotia (src/lib/payroll.js)
//   pay:    middle and range of pay in the busiest role family on our open jobs (src/lib/jobpay.js)
//   ad:     how many Atlantic provinces require pay in job ads (src/lib/jobad.js)
//   resume: how many checks the resume check runs, by area (src/lib/resume.js)
import { tools } from '../data/tools.js';
import { jobs } from '../data/jobs.js';
import { trueCost, money } from '../lib/payroll.js';
import { payByFamily, perHour } from '../lib/jobpay.js';
import { CHECKS } from '../lib/resume.js';
import { PAY_LAW } from '../lib/jobad.js';
import { tools as brandTools } from '../data/site.js';
import { lfs, GEOS, SHORT, at, monthName } from '../lib/lfs.js';

const dollars = (v) => perHour(v).replace('/hour', '');
const list = (xs) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} and ${xs.at(-1)}` : xs[0]);

// Cost: the bar is the wage (ink) and everything added on top (blue), as on the tool itself
const c = trueCost({ wage: brandTools.cost.wage, hours: 40, province: 'NS' });

// Pay: the busiest family's range on a shared scale, with a tick at the middle
const top = payByFamily(jobs).filter((r) => r.family !== 'Other')[0] ?? { family: '', median: 0, low: 0, high: 0, jobs: [] }; // none on AS and ADS (no pay tool)
const scaleMax = Math.max(40, Math.ceil(top.high / 5) * 5);
const pos = (v) => `${(Math.min(v, scaleMax) / scaleMax) * 100}%`;

// Job ads: one segment per Atlantic province, filled where pay is required
const law = [['PEI', 'PE'], ['New Brunswick', 'NB'], ['Nova Scotia', 'NS'], ['Newfoundland and Labrador', 'NL']]
  .map(([name, code]) => ({ name, required: PAY_LAW[code].status === 'required' }));
const required = law.filter((l) => l.required);

// Resume: one segment per area, as wide as its number of checks
const areas = [...new Set(CHECKS.map((k) => k.group))].map((g) => ({ g, n: CHECKS.filter((k) => k.group === g).length }));

// Jobs report: the region's unemployment rate, and one segment per province shaded by its rate (as on the map)
const ur = lfs ? GEOS.map((g) => ({ g, v: at(lfs.provinces[g]?.unemploymentRate, lfs.month) })).filter((r) => r.v != null) : [];
const sumOf = (k) => GEOS.reduce((t, g) => t + (at(lfs.provinces[g]?.[k], lfs.month) ?? 0), 0);
const urLo = Math.min(...ur.map((r) => r.v)), urHi = Math.max(...ur.map((r) => r.v));
const jobsPreview = ur.length
  ? { label: `Unemployment, ${monthName(lfs.month)}`, figure: `${((1 - sumOf('employment') / sumOf('labourForce')) * 100).toFixed(1)}%`, line: `across Atlantic Canada: ${ur.map((r) => `${SHORT[r.g]} ${r.v.toFixed(1)}%`).join(', ')}`,
      bar: ur.map((r) => ({ w: 1, k: 'shade', s: urHi > urLo ? (r.v - urLo) / (urHi - urLo) : 0.5 })) }
  : { label: 'Labour Force Survey', figure: 'Monthly', line: 'unemployment, jobs and wages in the four Atlantic provinces', bar: GEOS.map(() => ({ w: 1, k: 'off' })) };

const previews = {
  jobs: jobsPreview,
  cost: { label: `A $${brandTools.cost.wage}/hour job in Nova Scotia`, figure: money(c.perHour), line: `per hour worked, ${Math.round(c.uplift * 100)}% on top of the wage`,
    bar: [{ w: c.wage, k: 'ink' }, { w: c.perHour - c.wage, k: 'blue' }] },
  pay: { label: top.family, figure: dollars(top.median), unit: '/hour', line: `the middle of ${top.jobs.length} open jobs, ${dollars(top.low)} to ${dollars(top.high)}`,
    range: { lo: pos(top.low), hi: pos(top.high), mid: pos(top.median) } },
  ad: { label: 'Pay in job ads', figure: `${required.length} of ${law.length}`, line: `Atlantic provinces require it: ${list(required.map((l) => l.name))}`,
    bar: law.map((l) => ({ w: 1, k: l.required ? 'ink' : 'off' })) },
  resume: { label: 'What it looks at', figure: String(CHECKS.length), line: `checks in ${areas.length} areas, from ${areas[0].g.toLowerCase()} to ${areas.at(-1).g.toLowerCase()}`,
    bar: areas.map((a) => ({ w: a.n, k: 'ink' })) },
};
---
<ul class:list={['tools', tools.length === 3 && 'tools--3']} style={`--n:${tools.length}`}>
  {tools.map((t, i) => (
    <li style={`--i:${i}`}>
      <a class="card" href={t.url}>
        {(() => { const v = previews[t.preview]; return (
          <div class="vis" data-animate aria-hidden="true">
            <p class="v-label">{v.label}</p>
            <p class="v-fig">{v.figure}{v.unit && <span class="v-unit">{v.unit}</span>}</p>
            <p class="v-line">{v.line}</p>
            {v.bar && <span class="v-bar">{v.bar.map((seg, j) => <span class:list={['seg', `seg--${seg.k}`]} style={`flex-grow:${seg.w};--j:${j}${seg.s != null ? `;--s:${seg.s}` : ''}`}></span>)}</span>}
            {v.range && <span class="v-bar v-range"><span class="r-band" style={`left:${v.range.lo};right:calc(100% - ${v.range.hi})`}></span><span class="r-mid" style={`left:${v.range.mid}`}></span></span>}
          </div>
        ); })()}
        <p class="who">{t.who}</p>
        <h3>{t.title}</h3>
        <p class="d">{t.d}</p>
        <span class="more">{t.cta}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  /* Four tools: one row on wide screens, two by two on tablets, so no card sits alone */
  /* Three tools (AS, ADS): one row until there isn't room, then one column */
  .tools { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: var(--s6) var(--s5); }
  @media (max-width: 1180px) { .tools { grid-template-columns: repeat(2, 1fr); gap: var(--s7) var(--s6); } .tools--3 { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 900px) { .tools--3 { grid-template-columns: 1fr; } .tools--3 .vis { height: auto; } .tools--3 .v-bar { margin-top: var(--s5); } }
  .card { display: flex; flex-direction: column; height: 100%; color: var(--ink); text-decoration: none; }
  .card:hover h3 { text-decoration: underline; text-underline-offset: 0.15em; text-decoration-thickness: 1.5px; }
  .card:hover .more { color: var(--accent-deep); }
  .card:hover .vis { background: var(--mist-deep); }

  /* The preview panel: the same height and the same four parts in every card */
  .vis { background: var(--mist); height: 200px; padding: var(--s5); margin-bottom: var(--s5); display: flex; flex-direction: column; transition: background 0.2s; }
  :global(.section--tint) .vis { background: var(--paper); }
  .v-label { margin: 0; font-size: var(--fs-tiny); font-weight: var(--fw-bold); color: var(--ink-soft); }
  .v-fig { margin: var(--s3) 0 0; font-size: var(--fs-figure); font-weight: var(--fw-light); letter-spacing: -0.04em; line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .v-unit { font-size: var(--fs-small); font-weight: var(--fw-text); letter-spacing: 0; color: var(--ink-soft); margin-left: 0.15em; }
  .v-line { margin: var(--s2) 0 0; font-size: var(--fs-small); color: var(--ink-soft); line-height: 1.4; }

  /* The bar: always at the bottom, always 8px */
  .v-bar { position: relative; display: flex; gap: 3px; height: 8px; margin-top: auto; }
  .seg { display: block; min-width: 2px; }
  .seg--ink { background: var(--ink); }
  .seg--blue { background: var(--accent); }
  .seg--off { background: rgb(0 0 0 / 0.1); }
  .seg--shade { background: color-mix(in srgb, var(--accent) calc(22% + var(--s) * 78%), var(--paper)); }
  .v-range { background: rgb(0 0 0 / 0.08); }
  .r-band { position: absolute; top: 0; bottom: 0; background: var(--ink); opacity: 0.35; }
  .r-mid { position: absolute; top: -4px; bottom: -4px; width: 3px; margin-left: -1.5px; background: var(--ink); }

  .who { font-size: var(--fs-tiny); font-weight: var(--fw-text); color: var(--ink-soft); margin-bottom: var(--s2); }
  h3 { font-size: var(--fs-h3); margin-bottom: var(--s2); }
  .d { color: var(--ink-soft); }
  .more { margin-top: auto; padding-top: var(--s3); font-weight: var(--fw-bold); color: var(--accent); }

  /* Motion: cards rise in; each bar draws in from the left once */
  :global(.motion) .tools > li { opacity: 0; transform: translateY(12px); transition: opacity 0.4s var(--ease), transform 0.4s var(--ease); transition-delay: calc(var(--i) * 40ms); }
  :global(.motion) .tools > li:has(.is-in) { opacity: 1; transform: none; }
  :global(.motion) .v-bar { clip-path: inset(-6px 100% -6px 0); transition: clip-path 0.5s var(--ease) 0.15s; }
  :global(.motion) .is-in .v-bar { clip-path: inset(-6px 0 -6px 0); }

  @media (max-width: 700px) { .tools { grid-template-columns: 1fr; } .vis { height: auto; } .v-bar { margin-top: var(--s5); } } /* stacked: no row to line up with */
</style>

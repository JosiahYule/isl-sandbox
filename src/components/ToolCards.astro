---
// TOOL CARDS: ISL's three free tools, each with a small preview drawn from the tool's own content,
// so a visitor sees what they'll get before clicking. Used on the homepage and the Learn page.
//
// All numbers come from the live posts (checked October 19, 2026):
//   wage guide:   sector ranges quoted in the article text
//   resume audit: the eight checklist sections and how many checks each has (42 in all)
//   NB guide:     average home prices from its city comparison
// If a post is updated, update the numbers here too.
import { posts } from '../data/posts.js';

const post = (slug) => posts.find((p) => p.slug === slug) ?? { title: '', url: '#' };

// Wage guide: hourly range by sector. The scale runs $15 to $55.
const wages = [
  ['Warehousing and logistics', 17, 33, ''],
  ['Administrative', 17, 35, ''],
  ['Construction', 18, 46, '+'],
  ['Skilled trades', 25, 52, '+'],
];
const W0 = 15, W1 = 55;
const pos = (v) => ((v - W0) / (W1 - W0)) * 100;

// Resume audit: section name and number of checks
const audit = [['Contact', 5], ['Summary', 5], ['Experience', 6], ['Achievements', 5], ['Skills', 5], ['Education', 5], ['Keywords', 5], ['Formatting', 6]];
let tick = 0;
const auditRows = audit.map(([name, n]) => ({ name, ticks: Array.from({ length: n }, () => tick++) }));

// NB guide: average home price, in thousands
const homes = [['Toronto', 1100, '$1.1M+'], ['Moncton', 340, '$340K'], ['Fredericton', 310, '$310K'], ['Saint John', 255, '$255K']];

const tools = [
  { key: 'wage', who: 'For employers and job seekers', ...post('wage-guide-atlantic-canada-2026'), d: 'Entry-level to top-of-market hourly rates, by industry and role.', cta: 'Open the wage guide' },
  { key: 'audit', who: 'For job seekers', ...post('resume-audit'), d: 'Score your resume and see where to focus first.', cta: 'Audit your resume' },
  { key: 'nb', who: 'For job seekers', ...post('why-new-brunswick-a-practical-guide-for-canadians-considering-a-move'), d: 'Jobs, cities and a calculator for what your salary is worth there.', cta: 'Read the guide' },
];
---
<ul class="tools">
  {tools.map((t, i) => (
    <li style={`--i:${i}`}>
      <a class="card" href={t.url}>
        <div class:list={['vis', `vis--${t.key}`]} data-animate aria-hidden="true">
          {t.key === 'wage' && (
            <>
              <p class="vis-cap">Hourly range by sector</p>
              <ul class="wages">
                {wages.map(([name, lo, hi, plus], j) => (
                  <li style={`--j:${j}`}>
                    <span class="w-name">{name}</span>
                    <span class="w-track"><span class="w-bar" style={`left:${pos(lo)}%;width:${pos(hi) - pos(lo)}%`}></span></span>
                    <span class="w-val">${lo} to ${hi}{plus}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
          {t.key === 'audit' && (
            <>
              <p class="vis-cap">42 checks in 8 sections</p>
              <ul class="audit">
                {auditRows.map((r) => (
                  <li>
                    <span class="a-name">{r.name}</span>
                    <span class="a-ticks">{r.ticks.map((k) => <span class="tick" style={`--k:${k}`}></span>)}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
          {t.key === 'nb' && (
            <>
              <p class="vis-cap">Average home price</p>
              <ul class="homes">
                {homes.map(([city, v, label], j) => (
                  <li style={`--j:${j}`} class:list={[j === 0 && 'away']}>
                    <span class="h-name">{city}</span>
                    <span class="h-track"><span class="h-bar" style={`width:${(v / 1100) * 100}%`}></span></span>
                    <span class="h-val">{label}</span>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
        <p class="who">{t.who}</p>
        <h3>{t.title}</h3>
        <p class="d">{t.d}</p>
        <span class="more">{t.cta}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .tools { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s6) var(--s5); }
  .card { display: flex; flex-direction: column; height: 100%; color: var(--ink); text-decoration: none; }
  .card:hover h3 { text-decoration: underline; text-underline-offset: 0.15em; text-decoration-thickness: 1.5px; }
  .card:hover .more { color: var(--isl-blue-deep); }
  .card:hover .vis { background: #eeeeee; }

  /* The preview panel: same size for all three so the row lines up */
  .vis { background: var(--mist); height: 228px; padding: var(--s5); margin-bottom: var(--s5); display: flex; flex-direction: column; transition: background 0.2s; }
  :global(.section--tint) .vis { background: var(--paper); }
  .vis-cap { font-size: var(--fs-tiny); font-weight: 600; color: var(--ink-soft); margin-bottom: var(--s4); }
  .vis ul { list-style: none; margin: 0; padding: 0; display: grid; flex: 1; align-content: space-between; }

  /* Wage ranges */
  .wages li { display: grid; grid-template-columns: 1fr auto; gap: 4px var(--s3); }
  .w-name { font-size: var(--fs-tiny); font-weight: 500; }
  .w-val { grid-row: 1; grid-column: 2; font-size: var(--fs-tiny); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .w-track { grid-row: 2; grid-column: 1 / -1; position: relative; height: 8px; background: rgb(0 0 0 / 0.06); }
  .w-bar { position: absolute; top: 0; bottom: 0; background: var(--isl-blue); transform-origin: left; }

  /* Resume audit: one short bar per check */
  .audit li { display: grid; grid-template-columns: 6.2rem 1fr; align-items: center; gap: var(--s3); }
  .a-name { font-size: var(--fs-tiny); font-weight: 500; line-height: 1.2; }
  .a-ticks { display: flex; gap: 4px; }
  .tick { width: 5px; height: 11px; background: var(--ink); }

  /* Home prices */
  .homes li { display: grid; grid-template-columns: 5.6rem 1fr 3.4rem; align-items: center; gap: var(--s3); }
  .h-name { font-size: var(--fs-tiny); font-weight: 500; }
  .h-val { font-size: var(--fs-tiny); color: var(--ink-soft); text-align: right; font-variant-numeric: tabular-nums; }
  .h-track { height: 8px; }
  .h-bar { display: block; height: 100%; background: var(--isl-blue); transform-origin: left; }
  .away .h-bar { background: var(--ink); }

  .who { font-size: var(--fs-tiny); font-weight: 500; color: var(--ink-soft); margin-bottom: var(--s2); }
  h3 { font-size: 1.25rem; margin-bottom: var(--s2); }
  .d { color: var(--ink-soft); }
  .more { margin-top: auto; padding-top: var(--s3); font-weight: 600; color: var(--isl-blue); }

  /* Motion: the bars grow from the left, the checks fill one by one */
  :global(.motion) .tools > li { opacity: 0; transform: translateY(18px); transition: opacity 0.7s var(--ease), transform 0.7s var(--ease); transition-delay: calc(var(--i) * 110ms); }
  :global(.motion) .tools > li:has(.is-in) { opacity: 1; transform: none; }
  :global(.motion) .w-bar, :global(.motion) .h-bar { transform: scaleX(0); transition: transform 0.9s var(--ease); transition-delay: calc(0.25s + var(--j) * 120ms); }
  :global(.motion) .is-in .w-bar, :global(.motion) .is-in .h-bar { transform: none; }
  :global(.motion) .tick { background: rgb(0 0 0 / 0.1); transition: background 0.15s; transition-delay: calc(0.3s + var(--k) * 28ms); }
  :global(.motion) .is-in .tick { background: var(--ink); }

  @media (max-width: 960px) { .tools { grid-template-columns: 1fr; } .vis { height: auto; min-height: 200px; } .vis ul { gap: var(--s3); } }
</style>

---
// PAGE INTRO: the same opening on every inner page, so the site reads as one system.
//
// <PageHero title="..." lead="..." svc="contract">
//   <Button ...>optional actions</Button>
//   <Fragment slot="aside">optional visual on the right</Fragment>
// </PageHero>
//
// svc: "contract" | "direct" adds the service colour key above the title.
const { title, lead, svc } = Astro.props;
const hasAside = Astro.slots.has('aside');
const svcLabel = { contract: 'Contract staffing', direct: 'Direct hire' }[svc];
---
<section class:list={['intro', hasAside && 'intro--aside']}>
  <div class="wrap grid">
    <div class="copy">
      {svcLabel && <p class:list={['svc', `svc--${svc}`]}>{svcLabel}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      {Astro.slots.has('default') && <div class="actions"><slot /></div>}
    </div>
    {hasAside && <div class="aside"><slot name="aside" /></div>}
  </div>
</section>

<style>
  .intro { padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem); }
  .grid { display: grid; gap: var(--s7); }
  .intro--aside .grid { grid-template-columns: 1.15fr 1fr; align-items: center; }
  .svc { margin-bottom: var(--s4); }
  h1 { font-size: var(--fs-hero); letter-spacing: -0.025em; max-width: 14ch; }
  .lead { margin-top: var(--s5); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s6); }
  @media (max-width: 900px) { .intro--aside .grid { grid-template-columns: 1fr; } }
</style>

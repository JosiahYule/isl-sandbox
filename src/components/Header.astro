---
// SITE HEADER
// Menu items come from src/data/site.js. The mobile menu uses <details>, which opens
// and closes with no JavaScript.
import { brand, nav, offices, links, BRAND } from '../data/site.js';
import Button from './Button.astro';
import { url } from '../lib/url.js';
import { jobs } from '../data/jobs.js';
import { areas } from '../data/areas.js';
import { posts } from '../data/posts.js';
import { tools, guides } from '../data/tools.js';
import { industryPages } from '../data/industries.js';

// Dropdowns: built from the same data as the pages, so the numbers are always current.
// Industries, Learn and the office pages are ISL's; Find work is on every brand.
const isl = BRAND === 'isl';
const menus = {
  ...(isl && { '/contract/': [
    ...industryPages.map((i) => ({ label: i.name, href: url(`/industries/${i.slug}/`) })),
    { label: 'How contract staffing works', href: url('/contract/'), rule: true },
  ] }),
  '/find-work/': [
    { label: 'All open jobs', href: url('/find-work/'), meta: String(jobs.length) },
    ...areas.map((a) => ({ label: `Near ${a.label}`, href: url(`/find-work/?area=${a.key}`), meta: String(jobs.filter((j) => j.area === a.key).length) })),
    { label: 'Send your resume', href: links.resume, rule: true },
  ],
  '/learn/': [
    ...tools.map((t) => ({ label: t.title, href: t.url, meta: 'Tool' })),
    ...guides.map((g) => ({ label: g.title, href: g.url, meta: 'Guide' })),
    isl ? { label: 'All tools and articles', href: url('/learn/'), meta: String(posts.length + tools.length), rule: true }
      : { label: 'All tools', href: url('/learn/'), meta: String(tools.length), rule: true },
  ],
  // AS and ADS: Employers opens the two FAQ pages, as on their live sites
  ...(!isl && { '/employers/': [
    { label: 'Permanent Recruitment FAQ', href: url('/permanent-recruitment/') },
    { label: 'Temporary Recruitment FAQ', href: url('/temporary-recruitment/') },
    { label: 'Our process', href: url('/employers/'), rule: true },
  ] }),
  ...(brand.officePages && { '/contact/': [
    ...areas.map((a) => ({ label: a.label, href: url(`/offices/${a.key}/`), meta: offices.find((o) => o.city === a.label)?.phone })),
    { label: 'All ways to reach us', href: url('/contact/'), rule: true },
  ] }),
};

const [logoW, logoH] = brand.logoSize ?? [190, 46];
const current = Astro.url.pathname;
const isCurrent = (href) => current.startsWith(url(href));
---
<header class="header">
  <div class="wrap bar">
    <a class="logo" href={url('/')} aria-label={`${brand.name} home`}>
      <img src={brand.logo} alt="" width={logoW} height={logoH} style={brand.logoHeight ? `--logo-h:${brand.logoHeight}px` : undefined} onerror="this.parentElement.classList.add('no-img'); this.remove();" />
      <span class="wordmark" aria-hidden="true">{brand.wordmark[0]}<br />{brand.wordmark[1]}</span>
    </a>

    <nav class="primary" aria-label="Main">
      {nav.map((item, i) => menus[item.href] ? (
        <div class="has-drop">
          <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          <button type="button" class="drop-btn" aria-expanded="false" aria-controls={`drop-${i}`} aria-label={`More in ${item.label}`}>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          </button>
          <ul class="drop" id={`drop-${i}`}>
            {menus[item.href].map((m) => (
              <li class:list={[m.rule && 'rule']}><a href={m.href}><span>{m.label}</span>{m.meta && <span class="m">{m.meta}</span>}</a></li>
            ))}
          </ul>
        </div>
      ) : (
        <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="tools">
      {brand.loginUrl && <a class="login" href={brand.loginUrl}>Log in</a>}
      <Button href="/hire/" size="sm" data-cta-placement="header">Request talent</Button>
    </div>

    <a class="hire-m" href={url('/hire/')} data-cta-placement="mobile_header">Hire staff</a>

    <!-- Phones: one tap to call the head office, beside the menu -->
    <a class="call-m" href={`tel:+1${brand.mainPhone.replaceAll('-', '')}`} aria-label={`Call ${brand.mainPhone}`}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
      <span>Call</span>
    </a>
    <details class="mobile" data-mobile-menu>
      <summary><span>Menu</span></summary>
      <div class="sheet">
        <div class="sheet-actions">
          <Button href="/hire/" size="lg" data-cta-placement="mobile_menu">Hire staff</Button>
          <a class="menu-call" href={`tel:+1${brand.mainPhone.replaceAll('-', '')}`}>Call {brand.mainPhone}</a>
        </div>
        <nav aria-label="Mobile">
          {nav.map((item, i) => (
            <div class="mobile-group">
              <div class="mobile-row">
                <a href={url(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
                {menus[item.href] && <button class="sub-toggle" type="button" aria-expanded="false" aria-controls={`mobile-drop-${i}`} aria-label={`More in ${item.label}`}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
                </button>}
              </div>
              {menus[item.href] && <div class="sub" id={`mobile-drop-${i}`} hidden>{menus[item.href].map((m) => <a href={m.href}>{m.label}{m.meta && <span>{m.meta}</span>}</a>)}</div>}
            </div>
          ))}
        </nav>
        {brand.loginUrl && <a class="login menu-login" href={brand.loginUrl}>Log in to your account</a>}
      </div>
    </details>
  </div>
</header>

<script>
  // Dropdowns open on hover and keyboard focus (CSS). The arrow button also opens them
  // for touch screens, and Escape closes whichever is open.
  document.querySelectorAll('.has-drop').forEach((d) => {
    const btn = d.querySelector('.drop-btn');
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      document.querySelectorAll('.drop-btn').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      btn.setAttribute('aria-expanded', String(open));
    });
    d.addEventListener('keydown', (e) => { if (e.key === 'Escape') { btn.setAttribute('aria-expanded', 'false'); btn.focus(); d.classList.add('shut'); } });
    d.addEventListener('mouseleave', () => { btn.setAttribute('aria-expanded', 'false'); d.classList.remove('shut'); });
    d.addEventListener('focusout', (e) => { if (!d.contains(e.relatedTarget)) { btn.setAttribute('aria-expanded', 'false'); d.classList.remove('shut'); } });
  });
  document.addEventListener('click', (e) => { if (!e.target.closest('.has-drop')) document.querySelectorAll('.drop-btn').forEach((b) => b.setAttribute('aria-expanded', 'false')); });

  const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]')!;
  const menuSummary = mobileMenu.querySelector('summary')!;
  const toggles = [...mobileMenu.querySelectorAll<HTMLButtonElement>('.sub-toggle')];
  const closeGroups = () => toggles.forEach((b) => {
    b.setAttribute('aria-expanded', 'false');
    document.getElementById(b.getAttribute('aria-controls')!)!.hidden = true;
  });
  toggles.forEach((b) => b.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') !== 'true';
    closeGroups();
    b.setAttribute('aria-expanded', String(open));
    document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !open;
  }));
  mobileMenu.addEventListener('toggle', () => {
    document.documentElement.toggleAttribute('data-menu-open', mobileMenu.open);
    document.dispatchEvent(new CustomEvent('isl:menu', { detail: { open: mobileMenu.open } }));
    if (!mobileMenu.open) closeGroups();
  });
  mobileMenu.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { mobileMenu.open = false; menuSummary.focus(); }
  });
  // Keep Tab inside the open sheet; the page behind it is not a second menu.
  document.addEventListener('keydown', (e) => {
    if (!mobileMenu.open || e.key !== 'Tab') return;
    const focusable = [...mobileMenu.querySelectorAll<HTMLElement>('summary,a,button')].filter((el) => el.getClientRects().length);
    const first = focusable[0], last = focusable.at(-1);
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last?.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first?.focus(); }
  });
  mobileMenu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => { mobileMenu.open = false; }));
  matchMedia('(min-width: 1261px)').addEventListener('change', (e) => { if (e.matches) mobileMenu.open = false; });
</script>

<style>
  .header {
    position: sticky; top: 0; z-index: 60;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; gap: var(--s5); min-height: 72px; }

  /* The logo image loads from Squarespace. The wordmark is a fallback that only shows if it fails. */
  .logo { position: relative; display: block; flex-shrink: 0; color: var(--ink); text-decoration: none; }
  .logo img { height: var(--logo-h, 46px); width: auto; }
  /* On a phone the logo shares the bar with Call and Menu, so it steps down a little */
  @media (max-width: 480px) { .logo img { height: calc(var(--logo-h, 46px) * 0.85); } }
  /* The narrowest phones: Call becomes just its icon (the link still says "Call" to screen readers) */
  @media (max-width: 374px) { .call-m span { display: none; } .bar { gap: var(--s2); } .logo img { height: calc(var(--logo-h, 46px) * 0.72); } }
  .wordmark {
    display: none; align-items: center; font-weight: var(--fw-bold);
    font-size: var(--fs-body); line-height: 1; letter-spacing: -0.01em; min-height: 46px;
  }
  .logo:global(.no-img) .wordmark { display: flex; }

  .primary { display: flex; gap: clamp(14px, 1.4vw, 20px); margin-left: auto; }
  .primary a {
    position: relative; color: var(--ink); text-decoration: none; font-weight: var(--fw-text); font-size: var(--fs-body);
    padding-block: var(--s2); white-space: nowrap;
  }
  .primary a::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px;
    background: var(--accent); transform: scaleX(0); transform-origin: left;
    transition: transform 200ms var(--ease);
  }
  .primary a:hover::after, .primary a[aria-current='page']::after { transform: scaleX(1); }

  /* Dropdowns */
  .has-drop { position: relative; display: flex; align-items: center; gap: 2px; }
  .drop-btn { display: grid; place-items: center; width: 24px; height: 24px; padding: 0; border: 0; background: none; color: var(--ink-soft); cursor: pointer; }
  .drop-btn svg { width: 11px; height: 11px; transition: transform 0.2s var(--ease); }
  .drop {
    position: absolute; top: calc(100% + 12px); left: -18px; z-index: 70; min-width: 17rem;
    list-style: none; margin: 0; padding: var(--s2) 0; background: var(--paper);
    border: 1px solid var(--line); border-top: 2px solid var(--ink);
    opacity: 0; visibility: hidden; transform: translateY(-6px);
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0s linear 0.18s;
  }
  /* An invisible bridge so the menu stays open while the pointer moves down to it */
  .drop::before { content: ''; position: absolute; left: 0; right: 0; top: -14px; height: 14px; }
  .has-drop:hover .drop, .has-drop:focus-within .drop, .has-drop:has(.drop-btn[aria-expanded='true']) .drop {
    opacity: 1; visibility: visible; transform: none; transition-delay: 0s;
  }
  .has-drop.shut .drop { opacity: 0; visibility: hidden; }
  .has-drop:hover .drop-btn svg, .drop-btn[aria-expanded='true'] svg { transform: rotate(180deg); }
  .drop li.rule { border-top: 1px solid var(--line); margin-top: var(--s2); padding-top: var(--s2); }
  .drop a { display: flex; justify-content: space-between; gap: var(--s5); padding: 0.55rem var(--s5); color: var(--ink); text-decoration: none; font-size: var(--fs-body); white-space: nowrap; }
  .drop a::after { display: none; }
  .drop a:hover, .drop a:focus-visible { background: var(--mist); }
  .drop .m { color: var(--ink-soft); font-variant-numeric: tabular-nums; font-size: var(--fs-small); }
  .sheet .sub { display: grid; padding: 0 0 var(--s3); border-bottom: 1px solid var(--line); }
  .sheet .sub a { display: flex; justify-content: space-between; font-size: var(--fs-body); font-weight: var(--fw-text); padding: var(--s2) 0; border: 0; letter-spacing: 0; color: var(--ink); text-decoration: none; }
  .sheet .sub a span { color: var(--ink-soft); font-variant-numeric: tabular-nums; }

  .tools { display: flex; align-items: center; gap: var(--s5); }
  .login { white-space: nowrap; color: var(--ink-soft); font-size: var(--fs-small); font-weight: var(--fw-text); text-decoration: none; }
  .login:hover { color: var(--ink); text-decoration: underline; }

  .mobile, .hire-m { display: none; }
  .hire-m { align-items: center; justify-content: center; min-height: 44px; padding: 0.65rem 0.85rem; margin-left: auto; background: var(--accent); color: #fff; font-size: var(--fs-small); font-weight: var(--fw-bold); white-space: nowrap; text-decoration: none; }
  .hire-m:hover { background: var(--accent-deep); color: #fff; }
  .call-m { display: none; flex-shrink: 0; align-items: center; gap: var(--s2); padding: var(--s2) var(--s3); font-weight: var(--fw-bold); color: var(--ink); text-decoration: none; }
  .call-m svg { width: 18px; height: 18px; color: var(--accent); }
  .mobile summary {
    list-style: none; cursor: pointer; font-weight: var(--fw-bold);
    padding: var(--s2) var(--s4); border: 2px solid var(--ink); border-radius: var(--radius);
  }
  .mobile summary::-webkit-details-marker { display: none; }
  .mobile[open] summary { background: var(--ink); color: #fff; }
  .sheet {
    position: absolute; left: 0; right: 0; top: 100%;
    height: calc(100dvh - 72px); overflow-y: auto;
    background: var(--paper); padding: var(--s6) var(--gutter);
    display: flex; flex-direction: column; gap: var(--s5);
  }
  .sheet nav { display: grid; }
  .sheet-actions { display: grid; gap: var(--s3); }
  .menu-call { text-align: center; font-weight: var(--fw-bold); padding: var(--s2); }
  .mobile-row { display: flex; align-items: center; border-bottom: 1px solid var(--line); }
  .mobile-row > a { flex: 1; min-width: 0; }
  .sub-toggle { display: grid; place-items: center; flex: none; width: 48px; height: 48px; border: 0; background: transparent; color: var(--ink); cursor: pointer; }
  .sub-toggle svg { width: 18px; height: 18px; }
  .sub-toggle[aria-expanded='true'] svg { transform: rotate(180deg); }
  .sheet .sub[hidden] { display: none; }
  .menu-login { margin-top: var(--s3); padding-block: var(--s3); }
  .sheet nav a { font-weight: var(--fw-bold);
    font-size: var(--fs-h2); letter-spacing: -0.02em; color: var(--ink); text-decoration: none;
    padding-block: var(--s3);
  }
  .sheet nav a[aria-current='page'] { color: var(--accent); }
  .sheet-tools { display: grid; gap: var(--s4); padding-bottom: var(--s6); }

  /* 7 menu items plus the logo and button need about 1260px (AS has the longest labels); below that, use the Menu button */
  @media (max-width: 1260px) {
    .primary, .tools { display: none; }
    .mobile { display: block; }
    .hire-m { display: inline-flex; }
    .call-m { display: inline-flex; }
    .bar { gap: var(--s3); }
  }
  @media (max-width: 600px) {
    .call-m { display: none; }
    .mobile summary { padding-inline: var(--s3); min-height: 44px; }
    .sheet nav .mobile-row > a { font-size: 1.5rem; }
    .sheet { padding-top: var(--s5); }
  }
</style>

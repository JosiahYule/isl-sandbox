---
// CANADA MAP: Atlantic provinces in ISL blue (where the offices are),
// the rest of Canada outlined (where permanent searches reach).
import { canadaMap as map } from '../data/maps.js';
const { tone = 'light' } = Astro.props;
---
<figure class:list={['cmap', `cmap--${tone}`]}>
  <svg viewBox={`0 0 ${map.width} ${map.height}`} role="img" aria-labelledby="cmap-title">
    <title id="cmap-title">Map of Canada. Offices in the four Atlantic provinces; permanent searches in every province and territory.</title>
    {map.provinces.map((p) => <path d={p.d} class:list={[p.atlantic ? 'atl' : 'rest']} />)}
    {map.offices.map((o) => <circle cx={o.x} cy={o.y} r="6" />)}
  </svg>
  <figcaption>
    <span class="key key--atl">Offices</span>
    <span class="key key--rest">Permanent searches</span>
  </figcaption>
</figure>

<style>
  .cmap { margin: 0; }
  svg { width: 100%; height: auto; }
  .rest { fill: none; stroke: var(--isl-blue); stroke-width: 1.4; stroke-linejoin: round; }
  .atl { fill: var(--isl-blue); stroke: var(--paper); stroke-width: 1; }
  circle { fill: var(--contract); stroke: var(--navy); stroke-width: 2; }
  .cmap--dark .rest { stroke: var(--direct-light); }
  .cmap--dark .atl { fill: var(--direct-light); stroke: var(--navy); }
  figcaption { display: flex; gap: var(--s5); margin-top: var(--s3); font-size: var(--fs-small); font-weight: 600; }
  .key { display: inline-flex; align-items: center; gap: var(--s2); }
  .key::before { content: ''; width: 14px; height: 14px; border-radius: 1px; }
  .key--atl::before { background: var(--isl-blue); }
  .key--rest::before { border: 1.5px solid var(--isl-blue); }
  .cmap--dark .key--atl::before { background: var(--direct-light); }
  .cmap--dark .key--rest::before { border-color: var(--direct-light); }
</style>

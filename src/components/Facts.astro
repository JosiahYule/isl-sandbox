---
// FACTS BAND: a row of key figures in the brand's light display weight, divided by hairlines.
// Numbers count up when the band scrolls into view; words (like "Within hours") just fade in.
//
// <Facts facts={[['13', 'years in Atlantic Canada'], ['Within hours', 'from request to worker on site']]} />
// A figure counts up when it starts with a number ("13", "200+", "92%").
const { facts = [] } = Astro.props;
const counts = (f) => /^\d/.test(f);
---
<section class="facts-band">
  <div class="wrap">
    <ul class="facts" data-stagger style={`--n:${facts.length}`}>
      {facts.map(([f, d]) => (
        <li><span class="figure" data-countup={counts(f) ? '' : undefined}>{f}</span><span class="fd">{d}</span></li>
      ))}
    </ul>
  </div>
</section>

<style>
  .facts-band { border-bottom: 1px solid var(--line); }
  .facts { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), 1fr); }
  .facts li { padding: var(--s6) var(--s5) var(--s6) 0; }
  .facts li + li { padding-left: var(--s5); border-left: 1px solid var(--line); }
  .figure { display: block; font-size: clamp(2.2rem, 1.4rem + 2.2vw, 3.4rem); margin-bottom: var(--s2); }
  .fd { display: block; color: var(--ink-soft); max-width: 26ch; }
  @media (max-width: 900px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .facts li, .facts li + li { padding: var(--s5) var(--s4) var(--s5) 0; border-left: 0; border-top: 1px solid var(--line); }
  }
  @media (max-width: 340px) { .facts { grid-template-columns: 1fr; } }
</style>

---
// DIRECT HIRE (PERMANENT PLACEMENT)  →  /direct-hire/
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import PageHero from '../../components/PageHero.astro';
import CanadaMap from '../../components/CanadaMap.astro';
import CtaBand from '../../components/CtaBand.astro';
import Steps from '../../components/Steps.astro';
import UnitChart from '../../components/UnitChart.astro';
import Photo from '../../components/Photo.astro';
import Proof from '../../components/Proof.astro';
import PersonCard from '../../components/PersonCard.astro';
import { stock } from '../../data/photos.js';
import { team } from '../../data/team.js';
import { stat, showFigure } from '../../data/site.js';
import Unconfirmed from '../../components/Unconfirmed.astro';

const recruiters = team.filter((p) => p.team === 'Direct Hire');
// Retention and time to hire appear only once confirmed (src/brands/isl.js): the sandbox shows them
// tagged, live sites leave the chart and the figure out
const retention = stat('retention');
const retentionN = showFigure(retention) ? parseInt(retention.value, 10) : 0;
const fill = stat('timeToFill');
const showFill = showFigure(fill);
// A real sequence, so it's numbered.
const steps = [
  ['Brief', 'We learn the role, the team and what you need from the hire.'],
  ['Search', 'Recruiters reach out through targeted networks instead of waiting for applicants.'],
  ['Shortlist', 'You meet candidates screened for skill, fit and real interest.'],
  ['Hire', 'We handle the paperwork through to the start date, then follow up after placement.'],
  ['Guarantee', 'If the hire doesn’t work out within 90 days, we replace them.'],
];
const terms = [
  ['Retainer-based', 'Terms agreed before the search starts.'],
  ['Industry recruiters', 'Each search is led by a recruiter in your field.'],
  ['One invoice', 'A percentage of the hire’s annual salary.'],
];
---
<Base assistantMode="employer" title="Direct hire recruitment" description="Permanent recruitment for hard-to-fill roles anywhere in Canada, with a 90-day replacement guarantee.">
  <PageHero title="Permanent hires, searched coast to coast." lead="Targeted recruitment for hard-to-fill, full-time roles.">
    <Button href="/hire/?service=direct" size="lg">Start a search</Button>
    <Fragment slot="aside"><CanadaMap /></Fragment>
  </PageHero>

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head"><h2>How a search runs</h2></div>
      <Steps steps={steps} tone="direct" dashedLast />
      <div class="wide" data-reveal><Photo src={stock.interview.src} alt={stock.interview.alt} ratio="21/9" sizes="(max-width: 1320px) 100vw, 1240px" position="center 40%" /></div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      {retentionN > 0 ? (
        <div class="stay">
          <UnitChart value={retentionN} label={`${retentionN} of every 100 direct hire placements stay`} />
          <div>
            <div class="section-head">
              <h2>Hires that last.</h2>
              <p class="lead">Of every 100 people we place permanently, {retentionN} stay.<Unconfirmed figure={retention} /></p>
            </div>
            <!-- The 90-day guarantee is step 05 above; the time to hire is said here only -->
            {showFill && <ul class="figs" data-stagger>
              <li><span class="figure" data-countup>{fill.value}</span>days, on average, from brief to hire<Unconfirmed figure={fill} /></li>
            </ul>}
          </div>
        </div>
      ) : (
        <div class="section-head">
          <h2>Hires that last.</h2>
          <p class="lead">If a hire doesn’t work out within 90 days, we find a replacement.</p>
        </div>
      )}
      <ul class="items">
        {terms.map(([t, d]) => <li class="item item--blue"><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head"><h2>Your direct hire recruiters</h2></div>
      <ul class="people" data-stagger>
        {recruiters.map((r) => (
          <li><PersonCard person={r} /></li>
        ))}
      </ul>
    </div>
  </section>

  <Proof index={0} tint />

  <CtaBand title="Start your next key hire." text="Tell us about the role. A direct hire recruiter will set up a call within one business day." href="/hire/?service=direct" label="Start a search" service="direct" />
</Base>

<style>
  .wide { margin-top: clamp(3rem, 6vw, 5rem); }

  /* Retention: the dot chart beside three figures */
  .stay { display: grid; grid-template-columns: minmax(220px, 300px) 1fr; gap: clamp(2.5rem, 7vw, 7rem); align-items: center; margin-bottom: var(--s8); }
  .stay .section-head { margin-bottom: var(--s6); }
  .figs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); gap: var(--s5); max-width: 34rem; } /* one figure (47 days) spans the full width under the lead */
  .figs li { --rule: var(--direct); background: linear-gradient(var(--rule), var(--rule)) no-repeat left top / 100% 1.5px; padding-top: var(--s4); color: var(--ink-soft); font-size: var(--fs-small); }
  .figs .figure { display: block; font-size: var(--fs-figure); color: var(--direct); margin-bottom: var(--s2); }
  :global(.motion) .figs > li { background-size: 0% 1.5px; }
  :global(.motion) .figs.is-in > li { background-size: 100% 1.5px; }

  .people { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s5); }

  @media (max-width: 960px) {
    .stay { grid-template-columns: 1fr; }
    .stay :global(.units) { max-width: 240px; }
    .people { grid-template-columns: 1fr 1fr; }
    .wide :global(.frame) { aspect-ratio: 3 / 2 !important; }
  }
  @media (max-width: 640px) { .figs { grid-template-columns: 1fr; } }
</style>

---
// CONTRACT STAFFING  →  /contract/
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import PageHero from '../../components/PageHero.astro';
import IndustryMatrix from '../../components/IndustryMatrix.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import Proof from '../../components/Proof.astro';
import AtlanticMap from '../../components/AtlanticMap.astro';
import { jobs } from '../../data/jobs.js';
import { areas } from '../../data/areas.js';
import { places } from '../../data/places.js';

// Proof that we staff well beyond the offices: towns with open contract roles right now
// that aren't in any office's own area (from the live job snapshot, so it updates with the feed).
const officeTowns = new Set(areas.flatMap((a) => a.towns));
const beyond = [...new Set(jobs.filter((j) => j.type === 'contract' && j.city && !officeTowns.has(j.city.toLowerCase())).map((j) => j.city.replace(' - ', '-')))];
const townDots = beyond.map((name) => ({ name, ll: places[name.toLowerCase()] || places[name.toLowerCase().replace('-', ' - ')] }))
  .filter((t) => t.ll).map((t) => ({ name: t.name, lon: t.ll[0], lat: t.ll[1] }));
import { stock } from '../../data/photos.js';
import { route, provinceName } from '../../../assistant/supabase/functions/_shared/routing.js';
import { url } from '../../lib/url.js';

// Who takes contract requests in each province: the same routing the chatbot uses
const local = [['NS', 'Halifax', 'halifax'], ['NB', 'Moncton', 'moncton'], ['PE', 'Charlottetown', 'charlottetown'], ['NL', "St. John's", 'st-johns']]
  .map(([province, city, key]) => ({ province, key, ...route({ audience: 'employer', service: 'contract', place: { province, city } }) }));
const tel = (n) => `tel:+1${String(n).replace(/\D/g, '')}`;

const uses = [
  ['Vacation and leave cover', 'Keep the work moving while someone is away, from a week of vacation to a full maternity leave.'],
  ['Seasonal peaks', 'Add people when orders climb and scale back when they settle.'],
  ['Steady growth', 'Staff up ahead of a new contract without committing to permanent headcount.'],
  ['Try before you hire', 'See someone on the job first, then bring them onto your team.'],
];

// What the single hourly rate covers (from the live About page).
const covered = [
  ['The worker’s wages', 'Paid on our payroll.'],
  ['Payroll remittances', 'Handled and filed for every hour worked.'],
  ['Workers’ compensation', 'Coverage, claims, and safe, timely return to work.'],
  ['Screening', 'Including typing and dexterity tests where the role calls for them.'],
  ['Orientation', 'Specific to your company and site.'],
];
---
<Base assistantMode="employer" title="Contract staffing" description="Pre-screened contract workers anywhere in Canada, on site within hours of your request, for one all-inclusive hourly rate.">
  <PageHero photo={{ ...stock.welder, position: 'center' }} title="Pre-screened workers, on site within hours." lead="Anywhere in Canada. They work for you and stay on our payroll.">
    <Button href="/hire/?service=contract" size="lg">Request workers</Button>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>When employers call us</h2></div>
      <ul class="items">
        {uses.map(([t, d]) => <li class="item"><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- Coverage: each office covers its whole province -->
  <section class="section section--tint coverage" data-isl-live="coverage">
    <div class="wrap cov-grid">
      <div class="cov-copy">
        <div class="section-head">
          <h2>Wherever the work is.</h2>
          <p class="lead">Our five offices cover Atlantic Canada, and we place contract workers anywhere in the country.</p>
        </div>
        {beyond.length > 0 && (
          <div class="now">
            <p class="now-label">Contract roles open right now in</p>
            <ul class="now-list" data-stagger>{beyond.map((t) => <li>{t}</li>)}</ul>
          </div>
        )}
        <p class="key"><span class="k-office">Our offices</span><span class="k-town">Open roles beyond them</span></p>
        <a class="more" href="#local">Find your provincial contact</a>
      </div>
      <AtlanticMap id="coverage-map" card={false} navigate towns={townDots} />
    </div>
  </section>

  <!-- One rate: five separate costs gather into a single rate card as it scrolls into view -->
  <section class="section section--rule">
    <div class="wrap rate-grid">
      <div class="rate-copy">
        <div class="section-head">
          <h2>One rate. Everything inside it.</h2>
          <p class="lead">Hire directly and each of these is yours to arrange and pay for. With us, it's one rate.</p>
        </div>
        <div class="rate-photo">
          <Photo src={stock.construction.src} alt={stock.construction.alt} ratio="3/2" sizes="(max-width: 900px) 100vw, 40vw" />
        </div>
      </div>
      <div class="stack" data-animate>
        <p class="stack-head"><span>One hourly rate</span><span class="stack-sub">per worker</span></p>
        <ul>
          {covered.map(([t, d], i) => (
            <li style={`--i:${i}`}>
              <svg class="check" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10.5l4 4 8-9" pathLength="1" /></svg>
              <span class="c-t">{t}</span>
              <span class="c-d">{d}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Where we place contract workers</h2>
        <p class="lead">From warehouse floors to contact centres.</p>
      </div>
      <IndustryMatrix only="contract" />
    </div>
  </section>

  <Proof index={1} tint />

  <section class="section" id="local">
    <div class="wrap">
      <div class="section-head"><h2>Your contact for each province</h2></div>
      <ul class="items local">
        {local.map((l) => (
          <li class="item">
            <p class="l-prov">{provinceName(l.province)}</p>
            <h3>{l.person?.name ?? `${l.office.city} office`}</h3>
            <p>{l.person?.handles}</p>
            <a class="l-tel" href={tel(l.person?.phone || l.office.phone)}>{l.person?.phone || l.office.phone}</a>
            <a class="more" href={url(`/offices/${l.key}/`)}>{l.office.city === 'Moncton' ? 'Moncton and Saint John' : l.office.city} office</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand title="Need people this week?" text="Tell us the role and the start date. A recruiter replies within one business day." href="/hire/?service=contract" label="Request workers" service="contract" />
</Base>

<style>
  .l-prov { font-size: var(--fs-small); font-weight: var(--fw-bold); color: var(--ink-soft) !important; margin-bottom: var(--s2); }
  .l-tel { display: block; margin-top: var(--s3); font-weight: var(--fw-bold); color: var(--ink); text-decoration: none; font-variant-numeric: tabular-nums; }
  .local .more { display: inline-block; margin-top: var(--s2); }
  .local .item { display: grid; grid-row: span 5; grid-template-rows: subgrid; row-gap: 0; align-content: start; } /* rows shared across the cards */
  .local .item > * { margin-bottom: 0; }
  .local .item > p:not(.l-prov) { margin-bottom: var(--s2); }
  .cov-grid { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }
  .now { border-top: 1.5px solid var(--ink); padding-top: var(--s4); }
  .now-label { font-size: var(--fs-small); font-weight: var(--fw-bold); color: var(--ink-soft); margin-bottom: var(--s3); }
  .now-list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }
  .now-list li { background: var(--paper); border: 1.5px solid var(--line); padding: 0.4rem 0.8rem; font-weight: var(--fw-bold); font-size: var(--fs-small); }
  .key { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s5); margin-top: var(--s5); font-size: var(--fs-small); color: var(--ink-soft); }
  .key span { display: inline-flex; align-items: center; gap: var(--s2); }
  .key span::before { content: ''; width: 12px; height: 12px; border-radius: 50%; }
  .k-office::before { background: #fff; border: 3px solid var(--ink); }
  .k-town::before { background: var(--ink); border: 2px solid #fff; outline: 1px solid var(--ink); }
  .coverage .more { display: inline-block; margin-top: var(--s5); font-weight: var(--fw-bold); }
  @media (max-width: 900px) { .cov-grid { grid-template-columns: 1fr; } }
  .rate-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .rate-copy .section-head { margin-bottom: var(--s6); }

  /* The rate card */
  .stack { background: var(--paper); border: 1.5px solid var(--ink); }
  .stack-head {
    display: flex; justify-content: space-between; align-items: baseline; gap: var(--s4);
    margin: 0; padding: var(--s4) var(--s5); background: var(--ink); color: #fff;
    font-weight: var(--fw-bold); font-size: var(--fs-h3);
  }
  .stack-sub { font-weight: var(--fw-text); font-size: var(--fs-small); color: rgb(255 255 255 / 0.7); }
  .stack ul { list-style: none; margin: 0; padding: 0 var(--s5); }
  .stack li { display: grid; grid-template-columns: 20px 1fr; column-gap: var(--s3); padding-block: var(--s4); }
  .stack li + li { border-top: 1px solid var(--line); }
  .check { width: 20px; height: 20px; grid-row: span 2; margin-top: 2px; }
  .check path { fill: none; stroke: var(--accent); stroke-width: 2.4; stroke-linecap: square; }
  .c-t { font-weight: var(--fw-bold); }
  .c-d { grid-column: 2; color: var(--ink-soft); font-size: var(--fs-small); }

  /* Motion: the costs start spread apart as separate pieces, then close into the card */
  :global(.motion) .stack { border-color: transparent; background: transparent; transition: border-color 0.5s, background 0.5s; transition-delay: 0.9s; }
  :global(.motion) .stack-head { transform: scaleX(0); transform-origin: left; transition: transform 0.6s var(--ease) 0.9s; }
  :global(.motion) .stack-head > span { opacity: 0; transition: opacity 0.4s 1.3s; }
  :global(.motion) .stack li { transform: translateY(calc(var(--i) * 14px)); opacity: 0; transition: transform 0.9s var(--ease), opacity 0.5s; transition-delay: calc(var(--i) * 90ms); }
  :global(.motion) .check path { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 0.4s var(--ease); transition-delay: calc(1.2s + var(--i) * 120ms); }
  :global(.motion) .stack.is-in { border-color: var(--ink); background: var(--paper); }
  :global(.motion) .stack.is-in .stack-head { transform: none; }
  :global(.motion) .stack.is-in .stack-head > span { opacity: 1; }
  :global(.motion) .stack.is-in li { transform: none; opacity: 1; }
  :global(.motion) .stack.is-in .check path { stroke-dashoffset: 0; }

  @media (max-width: 900px) {
    .rate-grid { grid-template-columns: 1fr; }
  }
</style>

---
// ABOUT  →  /about/
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import PageHero from '../../components/PageHero.astro';
import Facts from '../../components/Facts.astro';
import CtaBand from '../../components/CtaBand.astro';
import Photo from '../../components/Photo.astro';
import { url } from '../../lib/url.js';
import { photos } from '../../data/photos.js';
import { brand, images, offices, stats } from '../../data/site.js';
import { team } from '../../data/team.js';

const years = new Date().getFullYear() - brand.since;
const provinces = new Set(offices.map((o) => o.province)).size;
const reviews = stats.find((s) => s.label.includes('reviews'))?.value ?? '200+';
const facts = [
  [String(years), 'years in Atlantic Canada'],
  [String(offices.length), 'local offices'],
  [String(provinces), 'Atlantic provinces'],
  [String(team.length), 'recruiters and staff'],
  [reviews, 'five-star Google reviews'],
];
const values = [
  ['Impact', 'A placement should make a measurable difference for the employer and the person hired.'],
  ['Passion', 'We care about the people we place and the businesses that hire them.'],
  ['Honesty', 'Clear terms and straight answers, before and after the hire.'],
  ['Communication', 'Responsive at every stage, including after someone starts.'],
];
const gallery = [
  [photos.chamberAwards, 'At the Chamber Awards'],
  [photos.megZowie, 'Meg and Zowie'],
  [photos.evanFirstYear, "Celebrating Evan's first year"],
  [photos.chamberTrio, 'Erika, Meg and Shelley at the Chamber Awards'],
  [photos.christmasTree, 'Beside the office Christmas tree'],
  [photos.teamMembers, 'Members of the team'],
];
---
<Base title="About" description="Locally owned and operated recruiting and staffing in Atlantic Canada since 2013.">
  <PageHero title="The right fit, for both sides of the hire." lead="We match Atlantic Canadian employers with the people they need, on contract and permanently.">
    <Button href="/hire/">I'm hiring</Button>
    <Button href="/find-work/" variant="outline">I'm looking for work</Button>
  </PageHero>

  <div class="wrap team-photo" data-reveal>
    <Photo src={photos.teamTogether.src} alt={photos.teamTogether.alt} ratio="21/9" sizes="(max-width: 1280px) 100vw, 1200px" position="center 85%" eager />
  </div>

  <div class="facts-gap"><Facts facts={facts} /></div>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>What we value</h2></div>
      <dl class="values" data-stagger>
        {values.map(([t, d]) => (
          <div class="value"><dt>{t}</dt><dd>{d}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head section-head--split gal-head"><h2>The people behind the placements</h2><p class="lead"><a href={url('/team/')}>Meet the whole team</a></p></div>
      <div class="gallery" data-stagger>
        {gallery.map(([p, caption]) => (
          <Photo src={p.src} alt={p.alt} ratio="4/3" sizes="(max-width: 900px) 50vw, 33vw" caption={caption} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap">
      <ul class="items recognition">
        <li class="item rec">
          <img src={images.badgeBestPlaces} alt="" width="56" height="56" loading="lazy" onerror="this.remove()" />
          <div><h3>Best Places to Work</h3></div>
        </li>
        <li class="item rec">
          <img src={images.badgeCor} alt="" width="56" height="56" loading="lazy" onerror="this.remove()" />
          <div><h3>COR certified</h3><p>Certificate of Recognition for occupational health and safety.</p></div>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* On phones a 21:9 strip makes 40 people tiny, so the frame gets taller */
  @media (max-width: 700px) { .team-photo :global(.frame) { aspect-ratio: 3 / 2 !important; } }
  .gal-head .lead { justify-self: end; font-weight: var(--fw-bold); font-size: var(--fs-body); }
  @media (max-width: 860px) { .gal-head .lead { justify-self: start; } }
  .facts-gap { margin-top: clamp(3rem, 6vw, 5rem); }
  .facts-gap :global(.facts-band) { border-top: 1px solid var(--line); }

  .values { margin: 0; border-top: 1.5px solid var(--ink); }
  .value { display: grid; grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr); gap: var(--s6); align-items: baseline; padding-block: var(--s5); border-bottom: 1px solid var(--line); }
  .value dt { transition: color 0.25s, transform 0.4s var(--ease); }
  .value:hover dt { color: var(--accent); transform: translateX(6px); }
  dt { font-weight: var(--fw-bold); font-size: var(--fs-h3); letter-spacing: -0.01em; line-height: 1.25; } /* values sit below their section heading in size */
  dd { margin: 0; color: var(--ink-soft); font-size: var(--fs-lead); font-weight: var(--fw-light); max-width: 40ch; }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s6) var(--s4); }
  .gallery :global(.frame) { overflow: hidden; }
  .gallery :global(img) { transition: transform 0.7s var(--ease); }
  .gallery :global(.photo:hover img) { transform: scale(1.04); }

  .rec { display: flex; gap: var(--s4); align-items: flex-start; }
  .rec img { width: 56px; height: 56px; object-fit: contain; flex: none; }

  @media (max-width: 900px) {
    .value { grid-template-columns: 1fr; gap: var(--s2); }
    .gallery { grid-template-columns: 1fr 1fr; }
  }
</style>

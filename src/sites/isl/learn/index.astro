---
// LEARN (BLOG INDEX)  →  /learn/
// Lists posts from src/data/posts.js. Posts still live on the real site.
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import ToolCards from '../../../components/ToolCards.astro';
import { posts } from '../../../data/posts.js';
import { url } from '../../../lib/url.js';

const fmt = (d) => new Date(d + 'T12:00:00').toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });
const audienceLabel = { employers: 'For employers', 'job seekers': 'For job seekers', everyone: 'Market insights' };
const filters = [
  { key: '', label: 'All posts' },
  { key: 'employers', label: 'For employers' },
  { key: 'job seekers', label: 'For job seekers' },
  { key: 'everyone', label: 'Market insights' },
];
// The old resume audit post is replaced by the Resume check tool, so it's left out of the list
const [featured, ...rest] = posts.filter((p) => p.slug !== 'resume-audit');
---
<Base title="Learn" description="Hiring advice, career guides and Atlantic Canada job market insights.">
  <PageHero title="Tools, guides and hiring advice." lead="Built by our team from what we see across Atlantic Canada." />

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head section-head--split t-head"><h2>Tools</h2><p class="lead"><a href={url('/learn/tools/')}>All tools and guides</a></p></div>
      <ToolCards />
    </div>
  </section>

  <section class="section section--tint posts" data-posts>
    <div class="wrap">
      <a class="featured" href={featured.url} data-reveal>
        <span class="eyebrow"><span class="new">Latest</span><span class="aud">{audienceLabel[featured.audience]}</span><time datetime={featured.date}>{fmt(featured.date)}</time></span>
        <span class="f-title">{featured.title}</span>
        <span class="read">Read the post <span aria-hidden="true">→</span></span>
      </a>

      <div class="filters" role="group" aria-label="Filter posts">
        {filters.map((f, i) => <button type="button" data-key={f.key} aria-pressed={String(i === 0)}>{f.label}</button>)}
      </div>

      <ul class="list">
        {rest.map((p) => (
          <li data-aud={p.audience}>
            <a href={p.url}>
              <time datetime={p.date}>{fmt(p.date)}</time>
              <span class="title">{p.title}</span>
              <span class="aud">{audienceLabel[p.audience]}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector('[data-posts]');
  const buttons = root.querySelectorAll('.filters button');
  const items = root.querySelectorAll('.list li');
  buttons.forEach((b) => b.addEventListener('click', () => {
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    items.forEach((li) => (li.hidden = !!b.dataset.key && li.dataset.aud !== b.dataset.key));
  }));
</script>

<style>
  .t-head .lead { justify-self: end; font-weight: var(--fw-bold); font-size: var(--fs-body); }
  @media (max-width: 860px) { .t-head .lead { justify-self: start; } }
  /* The newest post leads, set large; the rest follow as a dated list */
  .featured { display: grid; gap: var(--s4); justify-items: start; padding-bottom: var(--s7); color: var(--ink); text-decoration: none; }
  .featured:hover .f-title { text-decoration: underline; text-decoration-thickness: 2px; }
  /* One meta line: Latest (a small solid tag) · audience · date */
  .eyebrow { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); font-size: var(--fs-small); }
  .new { background: var(--ink); color: #fff; font-weight: var(--fw-bold); font-size: var(--fs-tiny); padding: 0.2rem 0.5rem; }
  .featured .aud { color: var(--accent); font-weight: var(--fw-bold); }
  .f-title { font-weight: var(--fw-bold); letter-spacing: -0.025em; line-height: 1.05; font-size: var(--fs-h2); max-width: 20ch; }
  .read { font-weight: var(--fw-bold); color: var(--accent); }
  .read span { display: inline-block; transition: transform 0.3s var(--ease); }
  .featured:hover .read span { transform: translateX(4px); }

  .filters { display: flex; flex-wrap: wrap; gap: var(--s2); margin-bottom: var(--s4); }
  .filters button {
    font: inherit; font-size: var(--fs-small); font-weight: var(--fw-bold); cursor: pointer;
    padding: 0.5rem 0.95rem; border-radius: var(--radius); background: transparent; color: var(--ink); border: 1.5px solid var(--line);
  }
  .filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }

  .list { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .list li[hidden] { display: none; }
  .list a {
    display: grid; grid-template-columns: 11rem 1fr 10rem 1.5rem; gap: var(--s5); align-items: baseline;
    padding-block: var(--s5); border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none;
  }
  .list a:hover .title { text-decoration: underline; text-decoration-thickness: 2px; }
  .arrow { color: var(--accent); font-weight: var(--fw-bold); opacity: 0; transform: translateX(-8px); transition: opacity 0.25s, transform 0.3s var(--ease); }
  .list a:hover .arrow, .list a:focus-visible .arrow { opacity: 1; transform: none; }
  time { font-size: var(--fs-small); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .title { font-weight: var(--fw-bold); font-size: var(--fs-h3); letter-spacing: -0.01em; line-height: 1.25; }
  .aud { font-size: var(--fs-small); font-weight: var(--fw-text); color: var(--ink-soft); }
  .list .aud { text-align: right; }

  @media (max-width: 760px) {
    .list a { grid-template-columns: 1fr; gap: var(--s1); }
    .list .aud { text-align: left; }
    .arrow { display: none; }
  }
</style>

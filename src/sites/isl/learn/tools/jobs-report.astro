---
import Base from '../../../../layouts/Base.astro';
import '../../../../styles/jobs-report.css';
import { atlanticMap as map } from '../../../../data/maps.js';
import { lfs } from '../../../../lib/lfs.js';
import { htmlJson } from '../../../../lib/html-json.js';
import { url } from '../../../../lib/url.js';
import { GEOS, ALL_GEOS, NAME, SHORT, METRICS, INDUSTRIES, defaultState, reportMonths, regionalBrief, measure, chartModel, hundredParts, reportInsights, industryRows, sortedIndustries, monthName, formatValue, formatSigned } from '../../../../lib/jobs-report.js';
import { rate, signed, num } from '../../../../lib/lfs-math.js';
const state = lfs ? defaultState(lfs) : null;
const months = lfs ? reportMonths(lfs) : [];
const brief = lfs ? regionalBrief(lfs, state.month) : null;
const chart = lfs ? chartModel(lfs, state) : null;
const parts = lfs ? hundredParts(lfs, state) : null;
const insights = lfs ? reportInsights(lfs, state) : [];
const industries = lfs ? sortedIndustries(lfs, state) : [];
const selectedIndustry = industries.find((row) => row.name === state.sector);
const sectorChart = lfs ? chartModel(lfs, { ...state, mode: 'level', compare: 'none' }, { industry: state.sector, width: 600, height: 170 }) : null;
const release = lfs?.released ? new Date(lfs.released).toLocaleDateString('en-CA', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'America/Halifax' }) : '';
const labels = { NB: [96, 470], PE: [292, 405], NS: [318, 690], NL: [770, 545] };
const TABLES = [
  ['14-10-0287-01', 'Labour force characteristics', 'https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1410028701'],
  ['14-10-0355-02', 'Employment by industry', 'https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1410035502'],
  ['14-10-0063-01', 'Employee wages', 'https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1410006301'],
];
---
<Base title="Atlantic jobs report" description="Explore Atlantic Canada’s labour market. Compare provinces, move through monthly data and see the shifts in employment, pay and industries." assistant={false}>
<div class="jobs-report" data-report data-jobs-url={url('/find-work/')} data-hire-url={url('/hire/')}>
  <section class="report-hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow"><a href={url('/learn/')}>Recruitment intelligence</a><span>/</span> The labour market</p>
        <h1>Atlantic<br />jobs report<span class="blue">.</span></h1>
        <p class="hero-lead">See what’s shifting.<br />Find your next move.</p>
        <p class="release"><span class="release-dot" aria-hidden="true"></span>{lfs ? <>Latest release: {monthName(lfs.month)}<span class="release-detail">Published {release}</span></> : 'Waiting for the first release'}</p>
      </div>
      {lfs && <div class="hero-map">
        <p class="map-hint">Four provinces. Choose your focus. <span aria-hidden="true">↙</span></p>
        <svg viewBox={`0 0 ${map.width} ${map.height}`} aria-label="Choose an Atlantic province to explore">
          <g class="map-context" aria-hidden="true">{map.context.map((p) => <path d={p.d} />)}</g>
          <g>{map.provinces.map((p) => <path class:list={['map-province', p.id === state.province && 'is-selected']} d={p.d} data-map-geo={p.id} role="button" tabindex="0" aria-label={`Explore ${NAME[p.id]}`} aria-pressed={String(p.id === state.province)} />)}</g>
          <g class="map-labels" aria-hidden="true">{GEOS.map((geo) => <text x={labels[geo][0]} y={labels[geo][1]}><tspan x={labels[geo][0]}>{SHORT[geo]}</tspan><tspan class="map-value" data-map-value={geo} x={labels[geo][0]} dy="42">{formatValue(measure(lfs, geo, 'unemployment', state.month).now, 'unemployment')}</tspan></text>)}</g>
        </svg>
        <p class="map-foot">Unemployment rate · <span data-month-label>{monthName(state.month)}</span></p>
      </div>}
    </div>
    {lfs && <div class="regional wrap">
      <div class="regional-head"><p class="eyebrow">Atlantic Canada <span data-regional-month>{monthName(state.month)}</span></p><p class="regional-story" data-regional-story>{brief.headline}</p></div>
      <div class="regional-stat"><strong data-region-monthly>{brief.monthly == null ? '–' : signed(brief.monthly)}</strong><span>employment change this month</span></div>
      <div class="regional-stat"><strong data-region-yearly>{brief.yearly == null ? '–' : signed(brief.yearly)}</strong><span>employment change over the year</span></div>
      <div class="regional-stat"><strong data-region-ur>{brief.ur == null ? '–' : rate(brief.ur)}</strong><span>regional unemployment rate</span></div>
    </div>}
  </section>

  {lfs?.fixture && <p class="wrap sample" role="note">Sample figures for building the page. These are not real.</p>}
  {!lfs && <section class="wrap report-empty"><h2>The first report is on its way.</h2><p>Figures will appear here after the next successful Statistics Canada update.</p></section>}
  {lfs && <>
  <noscript><p class="wrap no-script">Turn on JavaScript to explore provinces and earlier months. The latest Nova Scotia view and all-province data table are available below.</p></noscript>
  <div class="control-dock">
    <div class="wrap control-inner">
      <div class="province-picks" role="group" aria-label="Province to explore">{ALL_GEOS.map((geo) => <button type="button" data-province={geo} aria-pressed={String(geo === state.province)}><span class="desktop-name">{geo === 'NL' ? 'Newfoundland & Labrador' : NAME[geo]}</span><span class="mobile-name">{SHORT[geo]}</span></button>)}</div>
      <label class="month-control"><span>Report month</span><select data-report-month aria-label="Report month">{[...months].reverse().map((month) => <option value={month} selected={month === state.month}>{monthName(month)}</option>)}</select></label>
    </div>
  </div>

  <section class="wrap report-workspace" aria-labelledby="focus-title">
    <div class="focus-heading">
      <div><p class="eyebrow section-number">01 / Your market</p><h2 id="focus-title" data-focus-title>{NAME[state.province]}</h2><p class="muted" data-focus-date>{monthName(state.month)} · seasonally adjusted, except wages</p></div>
      <div class="period-control"><span>Compare changes</span><div class="segmented" role="group" aria-label="Change period"><button type="button" data-period="month" aria-pressed="false">Month</button><button type="button" data-period="year" aria-pressed="true">Year</button></div></div>
    </div>
    <div class="metric-cards" role="group" aria-label="Key measures. Choose one to explore its trend">
      {['unemployment', 'employment', 'wages', 'participation'].map((key) => {const value = measure(lfs, state.province, key, state.month, state.period); return <button type="button" class="metric-card" data-card-metric={key} aria-pressed={String(key === state.metric)}><span class="metric-label">{METRICS[key].title}<span aria-hidden="true">↗</span></span><strong data-card-value={key}>{value.value}</strong><span class="metric-delta" data-card-delta={key}>{value.comparison}</span>{key === 'wages' && <span class="metric-foot">Always compared year over year</span>}</button>;})}
    </div>

    <div class="explorer-heading"><div><h3>Explore the trend</h3><p class="muted">Choose a measure. Compare markets. Go back in time.</p></div><div class="report-actions"><button class="text-button" type="button" data-copy>Copy view link <span aria-hidden="true">↗</span></button><button class="text-button" type="button" data-download aria-label="Download this chart as CSV">Download CSV <span aria-hidden="true">↓</span></button></div></div>
    <div class="metric-picks" role="group" aria-label="Chart measure">{Object.entries(METRICS).map(([key, metric]) => <button type="button" data-metric={key} aria-pressed={String(key === state.metric)}>{metric.label}</button>)}</div>
    <div class="chart-workbench">
      <div class="plot-panel">
        <div class="plot-controls">
          <label>Compare with<select data-compare aria-label="Compare with">{ALL_GEOS.filter((g) => g !== state.province).map((g) => <option value={g} selected={g === state.compare}>{NAME[g]}</option>)}<option value="none">No comparison</option></select></label>
          <div class="chart-options"><div class="segmented" role="group" aria-label="Chart window"><button type="button" data-range="12" aria-pressed="false">1 year</button><button type="button" data-range="24" aria-pressed="true">2 years</button></div><div class="segmented" role="group" aria-label="Chart display"><button type="button" data-mode="level" aria-pressed="true">Levels</button><button type="button" data-mode="change" aria-pressed="false">Change</button></div></div>
        </div>
        <figure class="main-figure">
          <figcaption><p class="plot-unit" data-chart-unit>{chart.unit}</p><div class="readout" aria-hidden="true"><span class="readout-month" data-readout-month>{monthName(state.month)}</span><span class="readout-value primary"><i></i><span data-main-name>{NAME[state.province]}</span><strong data-main-value>{formatValue(chart.a.at(-1), state.metric)}</strong></span><span class="readout-value secondary" data-compare-readout><i></i><span data-compare-name>{NAME[state.compare]}</span><strong data-compare-value>{formatValue(chart.b.at(-1), state.metric)}</strong></span></div></figcaption>
          <svg class="main-chart" data-chart viewBox={`0 0 ${chart.width} ${chart.height}`} role="img" aria-labelledby="report-chart-title report-chart-description">
            <title id="report-chart-title">{chart.title}</title><desc id="report-chart-description">Monthly values from {monthName(chart.start)} to {monthName(chart.end)}. Exact values are in the chart data table below.</desc>
            <g class="plot-grid" data-chart-grid>{chart.ticks.map((tick) => <g><line x1={chart.left} x2={chart.width - chart.right} y1={tick.y} y2={tick.y} /><text x={chart.left - 12} y={tick.y + 4} text-anchor="end">{tick.value}</text></g>)}</g>
            <path class="plot-area" data-chart-area d={chart.area} />
            <path class="plot-comparison" data-chart-comparison d={chart.pathB} />
            <path class="plot-primary" data-chart-primary d={chart.pathA} />
            <g class="plot-months" data-chart-months>{chart.labels.map((label) => <text x={label.x} y={chart.height - 8} text-anchor={label.anchor}>{label.text}</text>)}</g>
            <g class="plot-cursor" data-chart-cursor hidden><line data-cursor-line /><circle data-cursor-primary r="5" /><circle data-cursor-compare r="4" /></g>
          </svg>
          <p class="chart-note" data-chart-empty hidden={chart.pa.some(Boolean)}>Not enough comparable observations for this view. Try Levels or another date.</p>
        </figure>
        <p class="chart-note" data-chart-note>{METRICS[state.metric].definition}</p>
        <div class="timeline">
          <div class="timeline-heading"><span>Explore a report month</span><strong data-timeline-month>{monthName(state.month)}</strong><button type="button" data-latest hidden>Back to latest ↗</button></div>
          <label class="visually-hidden" for="report-timeline">Explore a report month</label><input id="report-timeline" data-timeline type="range" min="0" max={months.length - 1} value={months.indexOf(state.month)} step="1" aria-valuetext={monthName(state.month)} />
          <div class="timeline-ends"><span>{monthName(months[0], true)}</span><span>{monthName(months.at(-1), true)}</span></div>
        </div>
      </div>
      <aside class="province-comparison" aria-labelledby="comparison-title"><p class="eyebrow">Across the region</p><h3 id="comparison-title" data-comparison-title>{METRICS[state.metric].title}</h3><p class="muted small" data-comparison-date>{monthName(state.month)}</p><div data-province-list>{GEOS.map((geo) => {const m = measure(lfs, geo, state.metric, state.month, state.period); return <button class="province-row" type="button" data-snapshot-geo={geo} aria-pressed={String(geo === state.province)}><span>{NAME[geo]}</span><strong>{m.value}</strong><small>{m.comparison}</small><span class="province-rule" aria-hidden="true"></span></button>;})}</div><p class="comparison-note">Select a province to bring it into focus. Change figures follow the Month / Year setting.</p></aside>
    </div>
    <details class="chart-data"><summary>View chart data <span aria-hidden="true">+</span></summary><div class="data-scroll" tabindex="0" role="region" aria-label="Monthly chart data"><table><caption class="visually-hidden" data-chart-caption>{chart.title}</caption><thead data-chart-table-head><tr><th scope="col">Month</th><th scope="col">{NAME[state.province]}</th><th scope="col">{NAME[state.compare]}</th></tr></thead><tbody data-chart-table>{chart.months.map((m, i) => <tr><th scope="row">{monthName(m)}</th><td>{formatValue(chart.a[i], state.metric)}</td><td>{formatValue(chart.b[i], state.metric)}</td></tr>)}</tbody></table></div></details>
  </section>

  <section class="report-reading" aria-labelledby="reading-title"><div class="wrap reading-grid">
    <div class="reading-copy"><p class="eyebrow section-number">02 / Read the signals</p><h2 id="reading-title">What changed,<br />and why it matters.</h2><p class="muted">A read of the selected figures. One month is a signal to investigate, not a forecast.</p><div class="insight-list" data-insights>{insights.map((insight) => <article><h3>{insight.label}</h3><p>{insight.text}</p></article>)}</div>
      <div class="audience-read"><div class="segmented" role="group" aria-label="Practical context"><button type="button" data-audience="employer" aria-pressed="true">I’m hiring</button><button type="button" data-audience="candidate" aria-pressed="false">I’m looking for work</button></div><p data-audience-text>Use the provincial trend to frame your planning, then check pay, location and availability for the specific role.</p><a class="inline-go" data-context-link href={url('/hire/?where=Nova+Scotia')}>Discuss a hire in Nova Scotia →</a></div>
    </div>
    <div class="hundred-panel"><p class="eyebrow">A different denominator</p><h3>Out of every<br />100 people<span class="blue">.</span></h3><p class="small muted"><span data-hundred-geo>{NAME[state.province]}</span> · age 15 and over</p><div class="hundred-dots" data-hundred role="img" aria-label={parts ? `${parts[0]} working, ${parts[1]} looking for work, ${parts[2]} outside the labour force` : 'Data not available'}>{Array.from({length:100},(_,i)=><span class={parts && i < parts[0] ? 'dot-work' : parts && i < parts[0] + parts[1] ? 'dot-look' : 'dot-out'}></span>)}</div><dl class="hundred-key">{['Working','Looking for work','Outside the labour force'].map((label,i)=><div><dt><i class={`key-${i}`}></i>{label}</dt><dd data-hundred-count={i}>{parts?.[i] ?? '–'}</dd></div>)}</dl><p class="small muted">Students, retirees and people caring for family can be outside the labour force. Unemployment uses only people working or looking for work as its denominator. Figures here are rounded to add to 100.</p></div>
  </div></section>

  <section class="wrap industry-section" aria-labelledby="industry-title">
    <div class="industry-heading"><div><p class="eyebrow section-number">03 / Follow the industries</p><h2 id="industry-title">Where employment<br />is moving.</h2><p class="muted" data-industry-context>{NAME[state.province]} · change since {monthName(selectedIndustry ? measure(lfs,state.province,'employment',state.month,state.period).prior : state.month)}</p></div><p class="industry-explainer">Explore the 16 broad industries. Choose one to see its history. These figures count people working, not jobs advertised.</p></div>
    <div class="industry-controls"><label class="industry-search">Find an industry<input type="search" data-industry-search placeholder="Try construction or health care" autocomplete="off" /></label><label>Sort by<select data-industry-sort><option value="gains">Largest gains</option><option value="losses">Largest declines</option><option value="size">Employment size</option></select></label><div><span class="field-label">Show change in</span><div class="segmented" role="group" aria-label="Industry change units"><button type="button" data-basis="people" aria-pressed="true">People</button><button type="button" data-basis="percent" aria-pressed="false">Percent</button></div></div></div>
    <div class="industry-workbench"><div class="industry-list-panel"><p class="list-caption"><span>Industry / employment</span><span data-industry-units>Change in people</span></p><div data-industry-list>{industries.slice(0,6).map((row)=><button type="button" class="industry-row" data-sector={row.name} aria-pressed={String(row.name===state.sector)}><span class="industry-name">{row.label}<small>{row.now == null ? 'Not available' : num(row.now)+' working'}</small></span><span class="industry-bar-track" aria-hidden="true"><span style={`--bar-width:${row.change == null ? 0 : Math.abs(row.change)/Math.max(...industries.map(r=>Math.abs(r.change||0)),1)*48}%;--bar-side:${row.change<0 ? 'auto' : '50%'};--bar-right:${row.change<0 ? '50%' : 'auto'}`} class:list={['industry-bar',row.change<0 && 'is-negative']}></span></span><strong>{row.change == null ? '–' : signed(row.change)}</strong></button>)}</div><p class="industry-empty" data-industry-empty hidden>No industries match. Try a shorter term.</p><button type="button" class="show-industries" data-industry-more>Show all 16 industries <span aria-hidden="true">↓</span></button><p class="small muted">All changes are survey estimates. Small provincial or industry changes can reflect sampling variability. This view does not test statistical significance.</p></div>
      <aside class="sector-detail" aria-labelledby="sector-title"><p class="eyebrow">Industry close-up</p><label class="visually-hidden" for="report-sector">Industry close-up</label><select id="report-sector" data-sector-select>{INDUSTRIES.map(name=><option selected={name===state.sector}>{name}</option>)}</select><h3 id="sector-title" data-sector-title>{selectedIndustry?.label}</h3><p class="sector-number" data-sector-value>{selectedIndustry?.now == null ? '–' : num(selectedIndustry.now)}</p><p class="muted small">people working · <span data-sector-month>{monthName(state.month)}</span></p><div class="sector-deltas"><p><span data-sector-change>{selectedIndustry?.change == null ? '–' : signed(selectedIndustry.change)}</span><small data-sector-prior>over the year</small></p><p><span data-sector-percent>{formatSigned(selectedIndustry?.percent,1,'%')}</span><small>employment change</small></p></div><svg class="sector-chart" data-sector-chart viewBox="0 0 600 170" role="img" aria-label={`${selectedIndustry?.label} employment history`}><path class="plot-area" data-sector-area d={sectorChart.area}/><path class="plot-primary" data-sector-line d={sectorChart.pathA}/></svg><p class="sector-chart-dates"><span data-sector-start>{monthName(sectorChart.start,true)}</span><span data-sector-end>{monthName(sectorChart.end,true)}</span></p><p class="small muted">Seasonally adjusted. The trend ends at your selected month.</p></aside>
    </div>
  </section>

  <section class="wrap report-methods"><details><summary>Sources, definitions and all-province figures <span aria-hidden="true">+</span></summary><div class="method-content"><p>Statistics Canada’s Labour Force Survey. Employment and rate series are seasonally adjusted. Hourly wages are not seasonally adjusted, so wage changes use the same month a year earlier. Wages are nominal averages across employees, not a recommended pay rate for a particular role.</p><p>The regional employment figures add the four provinces. The regional unemployment rate uses their combined employment and labour force, rather than averaging the four rates. Sector totals use the 16 broad industries to avoid counting retail and wholesale twice.</p><p>Monthly estimates can move because of sampling variability. This tool does not assess statistical significance or predict hiring demand. Data may be revised. Earlier months shown here use the currently saved series, not the figures originally published on those dates.</p><ul>{TABLES.map(([id,name,href])=><li><a href={href}>{name} <span>Table {id} ↗</span></a></li>)}<li><a href="https://publications.gc.ca/collections/collection_2025/statcan/71-543-g2025001-eng.pdf">Guide to the Labour Force Survey ↗</a></li></ul><p class="small muted">Latest saved release: {monthName(lfs.month)} · published {release}. Figures refresh automatically when the source update succeeds.</p><div class="data-scroll" tabindex="0" role="region" aria-label="All-province figures"><table><caption>All-province figures · <span data-all-month>{monthName(state.month)}</span></caption><thead><tr><th scope="col">Measure</th>{ALL_GEOS.map(g=><th scope="col">{SHORT[g]}</th>)}</tr></thead><tbody data-all-table>{Object.entries(METRICS).map(([key,metric])=><tr><th scope="row">{metric.title}</th>{ALL_GEOS.map(g=><td>{measure(lfs,g,key,state.month,state.period).value}</td>)}</tr>)}</tbody></table></div></div></details></section>
  <p class="visually-hidden" role="status" aria-live="polite" aria-atomic="true" data-report-status></p>
  <script type="application/json" id="report-data" set:html={htmlJson(lfs)} />
  </>}
</div>
<script>import '../../../../scripts/jobs-report.js';</script>
</Base>

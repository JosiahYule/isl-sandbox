---
// TOOL: ATLANTIC JOBS REPORT  →  /learn/tools/jobs-report/
// Statistics Canada's monthly Labour Force Survey for the four Atlantic provinces, in charts.
// The numbers come from src/data/lfs/latest.json, which a GitHub workflow refreshes the morning each
// new survey comes out (scripts/fetch-lfs.mjs, .github/workflows/update-lfs.yml). Nothing is typed in.
//
//   in short        three figures for the region: jobs this month, unemployment, wages
//   unemployment    a map shaded by each province's rate, with the change from last month
//   jobs            how many more (or fewer) people are working than a year ago
//   two years       each province's unemployment rate against Canada's, month by month
//   every 100       out of every 100 adults: working, looking, or neither
//   young people    unemployment at 15 to 24, next to the overall rate
//   industries      which industries gained or lost workers over the year, province by province
//   wages           the average hourly wage, its change over the year, and the minimum wage
//
// Charts are drawn here as plain SVG and HTML, so the page reads without any charting code;
// the script only adds the hover readout on the line charts and the province buttons.
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import { atlanticMap as map } from '../../../../data/maps.js';
import { MIN_WAGE } from '../../../../lib/minwage.js';
import { url } from '../../../../lib/url.js';
import { industryTakeaway } from '../../../../lib/lfs-report.js';
import { lfs, GEOS, NAME, SHORT, monthName, read, at, back, rate, pts, people, num, signed, money } from '../../../../lib/lfs.js';

const M = lfs?.month;
const yearAgo = M ? monthName(back(M, 12)) : '';
const percentagePoints = (v) => pts(v).replace(/\bpoints?\b/, (word) => `percentage ${word}`);
const ALL = [...GEOS, 'CA'];
const P = (g, k) => lfs.provinces[g]?.[k];
const R = (g, k) => read(P(g, k), M);

// ---- In short: Atlantic Canada as one region (the provinces added together)
let region = null;
if (lfs) {
  const sum = (k, month) => GEOS.reduce((t, g) => t + (at(P(g, k), month) ?? NaN), 0);
  const ur = (month) => (1 - sum('employment', month) / sum('labourForce', month)) * 100;
  const prevM = back(M, 1);
  region = {
    jobsM: people(sum('employment', M) - sum('employment', prevM)),
    jobsY: people(sum('employment', M) - sum('employment', back(M, 12))),
    ur: ur(M), urPrev: ur(prevM),
  };
}

// ---- Unemployment: the map is shaded by rate, darkest where it's highest
const urRows = lfs ? ALL.map((g) => ({ g, ...R(g, 'unemploymentRate') })).filter((r) => r.now != null) : [];
const provUR = urRows.filter((r) => r.g !== 'CA');
const urLo = Math.min(...provUR.map((r) => r.now)), urHi = Math.max(...provUR.map((r) => r.now));
const shade = (v) => (urHi > urLo ? (v - urLo) / (urHi - urLo) : 0.5);
// Where each province's figure sits on the map (in the map's own 900 × 820 units)
const LABEL = { NB: [96, 470], PE: [292, 405], NS: [318, 690], NL: [770, 545] };
const caUR = urRows.find((r) => r.g === 'CA');

// ---- Jobs: people working now against a year ago
const jobRows = lfs ? ALL.map((g) => {
  const r = R(g, 'employment');
  return r.now == null ? null : { g, now: people(r.now), m: r.m != null ? people(r.m) : null, y: r.y != null ? people(r.y) : null, yPct: r.year ? (r.y / r.year) * 100 : null };
}).filter(Boolean) : [];
const jobMax = Math.max(...jobRows.map((r) => Math.abs(r.yPct ?? 0)), 0.5);

// ---- Two years of unemployment, each province against Canada, on one shared scale
const W = 560, H = 230, PADL = 40, PADB = 28, PADT = 12;
const trend = lfs ? GEOS.map((g) => {
  const s = P(g, 'unemploymentRate') ?? [];
  const ca = P('CA', 'unemploymentRate') ?? [];
  return { g, months: s.map((p) => p.month), a: s.map((p) => p.value), b: s.map((p) => at(ca, p.month)) };
}).filter((t) => t.a.length > 1) : [];
const allV = trend.flatMap((t) => [...t.a, ...t.b]).filter((v) => v != null);
const tLo = Math.floor(Math.min(...allV) - 0.5), tHi = Math.ceil(Math.max(...allV) + 0.5);
const tx = (i, n) => PADL + (i / (n - 1)) * (W - PADL - 4);
const ty = (v) => PADT + (1 - (v - tLo) / (tHi - tLo)) * (H - PADT - PADB);
// Keep missing months as gaps, so dates and markers always refer to the same observation.
const line = (vals) => vals.map((v, i) => v == null ? '' : `${i === 0 || vals[i - 1] == null ? 'M' : 'L'}${tx(i, vals.length).toFixed(1)},${ty(v).toFixed(1)}`).join(' ');
const trendMonths = [...new Set(trend.flatMap((t) => t.months))].sort();
const tStep = tHi - tLo > 6 ? 2 : 1;
const tTicks = []; for (let t = Math.ceil(tLo / tStep) * tStep; t <= tHi; t += tStep) tTicks.push(t);

// ---- Out of every 100 adults: working, looking for work, or neither (rounded so they add to 100)
function hundred(er, pr) {
  const parts = [er, pr - er, 100 - pr];
  const base = parts.map(Math.floor);
  let left = 100 - base.reduce((a, b) => a + b, 0);
  parts.map((p, i) => [p - base[i], i]).sort((a, b) => b[0] - a[0]).forEach(([, i]) => { if (left-- > 0) base[i]++; });
  return base;
}
const lfRows = lfs ? ALL.map((g) => {
  const er = R(g, 'employmentRate'), pr = R(g, 'participationRate');
  if (er.now == null || pr.now == null) return null;
  const [work, look, out] = hundred(er.now, pr.now);
  return { g, work, look, out, pr: pr.now, prY: pr.y };
}).filter(Boolean) : [];

// ---- Young people: unemployment at 15 to 24 next to everyone 15 and over
const youthRows = lfs ? ALL.map((g) => ({ g, youth: R(g, 'youthUnemploymentRate'), all: R(g, 'unemploymentRate') })).filter((r) => r.youth.now != null && r.all.now != null) : [];
const yHi = Math.ceil(Math.max(...youthRows.map((r) => r.youth.now), 10) / 5) * 5;
const yx = (v) => `${(v / yHi) * 100}%`;
const yTicks = []; for (let t = 0; t <= yHi; t += 5) yTicks.push(t);

// ---- Industries: the change in people working over the year, biggest gains first
const SHORTER = {
  'Forestry, fishing, mining, quarrying, oil and gas': 'Forestry, fishing, mining, oil and gas',
  'Wholesale and retail trade': 'Retail and wholesale',
  'Finance, insurance, real estate, rental and leasing': 'Finance, insurance and real estate',
  'Professional, scientific and technical services': 'Professional, scientific and technical',
  'Business, building and other support services': 'Business, building and support services',
  'Educational services': 'Education',
  'Other services (except public administration)': 'Other services',
};
// The sixteen industries the survey reports each month (any finer breakdown is left out, so nothing is counted twice)
const TOP = ['Agriculture', 'Forestry, fishing, mining, quarrying, oil and gas', 'Utilities', 'Construction', 'Manufacturing', 'Wholesale and retail trade',
  'Transportation and warehousing', 'Finance, insurance, real estate, rental and leasing', 'Professional, scientific and technical services',
  'Business, building and other support services', 'Educational services', 'Health care and social assistance', 'Information, culture and recreation',
  'Accommodation and food services', 'Other services (except public administration)', 'Public administration'];
const indViews = lfs ? [...GEOS, 'CA'].map((g) => {
  const I = lfs.industries[g] ?? {};
  const keys = Object.keys(I).filter((k) => k !== 'Total');
  const known = keys.filter((k) => TOP.includes(k));
  const rows = (known.length >= 10 ? known : keys).map((k) => {
    const r = read(I[k], M);
    return r.now == null || r.y == null ? null : { name: SHORTER[k] ?? k, now: people(r.now), y: people(r.y), pct: r.year ? (r.y / r.year) * 100 : 0 };
  }).filter(Boolean).sort((a, b) => b.y - a.y);
  const max = Math.max(...rows.map((r) => Math.abs(r.y)), 1);
  return { g, rows, max, summary: industryTakeaway(rows, NAME[g], yearAgo) };
}).filter((v) => v.rows.length) : [];

// ---- Wages: the average hourly wage, against a year ago and against the minimum wage
const wageRows = lfs ? ALL.map((g) => {
  const r = read(lfs.wages[g]?.averageHourly, M);
  if (r.now == null) return null;
  return { g, now: r.now, yPct: r.year ? (r.y / r.year) * 100 : null, min: MIN_WAGE[g] };
}).filter(Boolean) : [];
const wLo = 15, wHi = Math.ceil(Math.max(...wageRows.map((r) => r.now), 30) / 5) * 5;
const wx = (v) => `${((Math.min(Math.max(v, wLo), wHi) - wLo) / (wHi - wLo)) * 100}%`;
const wTicks = []; for (let t = wLo; t <= wHi; t += 5) wTicks.push(t);

const released = lfs?.released ? new Date(lfs.released) : null;
const releasedText = released ? released.toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Halifax' }) : null;
const prevName = M ? monthName(back(M, 1)).split(' ')[0] : '';
const dir = (v) => (v > 0 ? 'up' : v < 0 ? 'down' : 'flat');
const pct1 = (v) => `${v > 0 ? '+' : v < 0 ? '−' : ''}${Math.abs(v).toFixed(1)}%`;
const TABLES = [
  ['14-10-0287-01', 'Labour force characteristics by province', 'https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1410028701'],
  ['14-10-0355-02', 'Employment by industry', 'https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1410035502'],
  ['14-10-0063-01', 'Employee wages by industry', 'https://www150.statcan.gc.ca/t1/tbl1/en/tv.action?pid=1410006301'],
];
---
<Base live title="Atlantic jobs report" description="Statistics Canada’s monthly Labour Force Survey for Nova Scotia, New Brunswick, PEI and Newfoundland and Labrador, in charts: unemployment, jobs, industries and wages." assistantMode="employer">
  <PageHero compact title="Atlantic jobs report." lead={lfs ? `${monthName(M)}, from Statistics Canada’s Labour Force Survey${releasedText ? `, released ${releasedText}` : ''}. It updates on its own each month.` : 'Statistics Canada’s monthly Labour Force Survey for the four Atlantic provinces, in charts.'} />

  {lfs?.fixture && <p class="sample wrap" role="note">Sample figures for building the page. These are not real.</p>}

  {!lfs && (
    <section class="section section--rule">
      <div class="wrap">
        <p class="lead">The first report is on its way. It loads from Statistics Canada automatically, then updates itself each month.</p>
      </div>
    </section>
  )}

  {lfs && (<>
  <!-- IN SHORT -->
  <section class="section section--rule short-sec">
    <div class="wrap">
      <ul class="short" data-stagger>
        <li>
          <p class="figure">{signed(region.jobsM)}</p>
          <p>change in employment across Atlantic Canada in {monthName(M).split(' ')[0]}, {region.jobsY >= 0 ? `${num(region.jobsY)} more people working` : `${num(-region.jobsY)} fewer people working`} than a year ago</p>
        </li>
        <li>
          <p class="figure">{rate(region.ur)}</p>
          <p>unemployment across the region, {percentagePoints(region.ur - region.urPrev)} from {prevName}{caUR && `. Canada: ${rate(caUR.now)}`}</p>
        </li>
        {wageRows.find((r) => r.g === 'CA')?.yPct != null && (() => { const c = wageRows.find((r) => r.g === 'CA'); return (
          <li>
            <p class="figure">{pct1(c.yPct)}</p>
            <p>change in Canada’s average hourly wage over the year, to {money(c.now)}</p>
          </li>
        ); })()}
      </ul>
    </div>
  </section>

  <!-- UNEMPLOYMENT: the map -->
  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Unemployment</h2>
        <p class="lead">The share of the labour force looking for work. A rise from 6% to 7% is one percentage point. Darker means higher.</p>
      </div>
      <div class="ur">
        <figure class="ur-map" aria-hidden="true" data-animate>
          <svg viewBox={`0 0 ${map.width} ${map.height}`}>
            <g class="context">{map.context.map((p) => <path d={p.d} />)}</g>
            <g class="land">{map.provinces.map((p) => { const r = provUR.find((x) => x.g === p.id); return <path d={p.d} style={`--k:${r ? shade(r.now) : 0}`} />; })}</g>
            <g class="labels">{provUR.map((r) => (
              <text x={LABEL[r.g][0]} y={LABEL[r.g][1]}>
                <tspan class="l-name" x={LABEL[r.g][0]}>{SHORT[r.g]}</tspan>
                <tspan class="l-v" x={LABEL[r.g][0]} dy="46">{rate(r.now)}</tspan>
              </text>
            ))}</g>
          </svg>
        </figure>
        <ol class="ur-list">
          {[...provUR].sort((a, b) => b.now - a.now).map((r) => (
            <li>
              <span class="u-name">{NAME[r.g]}</span>
              <span class="u-v">{rate(r.now)}</span>
              <span class:list={['u-ch', r.m != null && `u-ch--${dir(Math.round(r.m * 10))}`]}>{r.m != null ? `${percentagePoints(r.m)} from ${prevName}` : ''}</span>
            </li>
          ))}
          {caUR && <li class="u-ca"><span class="u-name">Canada</span><span class="u-v">{rate(caUR.now)}</span><span class="u-ch">{caUR.m != null ? `${percentagePoints(caUR.m)} from ${prevName}` : ''}</span></li>}
        </ol>
      </div>
    </div>
  </section>

  <!-- JOBS over the year -->
  <section class="section section--tint">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Employment</h2>
        <p class="lead">People working in each province, and the change since {yearAgo}.</p>
      </div>
      <div class="jobs" data-animate>
        {jobRows.map((r) => (
          <div class:list={['j-row', r.g === 'CA' && 'j-row--ca']}>
            <p class="j-name"><strong>{NAME[r.g]}</strong><span>{num(r.now)} working</span></p>
            <div class="j-track" aria-hidden="true">
              {r.yPct != null && <span class:list={['j-bar', r.yPct < 0 && 'j-bar--down']} style={`--w:${(Math.abs(r.yPct) / jobMax) * 50}%`}></span>}
            </div>
            <p class="j-fig">
              {r.y != null && <><span class="figure">{pct1(r.yPct)}</span><span>{signed(r.y)} over the year</span></>}
              {r.m != null && <span class="j-m">{signed(r.m)} in {monthName(M).split(' ')[0]}</span>}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TWO YEARS of unemployment -->
  {trend.length > 0 && (
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Two years of unemployment</h2>
        <p class="lead">Each province’s rate month by month, with Canada’s in grey. Tap or point at a chart to read a month. Tap elsewhere to dismiss.</p>
      </div>
      <p id="trend-help" class="visually-hidden">Use the left and right arrow keys to read each month, Home and End for the first and latest months, and Escape to dismiss the readout. Monthly values are available in All the numbers below.</p>
      <div class="multiples">
        {trend.map((t) => (
          <figure class="sm" data-sm={JSON.stringify({ m: t.months.map((m) => monthName(m)), short: t.months.map((m) => monthName(m, true)), a: t.a, b: t.b, n: NAME[t.g], scale: { width: W, height: H, left: PADL, bottom: PADB, top: PADT, min: tLo, max: tHi } })} data-animate tabindex="0" aria-describedby="trend-help" aria-details="unemployment-history" aria-label={`${NAME[t.g]} unemployment, ${monthName(t.months[0])} to ${monthName(t.months.at(-1))}.`}>
            <figcaption><strong>{NAME[t.g]}</strong><span>{rate(t.a.at(-1))}</span></figcaption>
            <div class="sm-plot">
              <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
                <g class="grid">{tTicks.map((v) => <><line x1={PADL} x2={W} y1={ty(v)} y2={ty(v)} /><text x={PADL - 8} y={ty(v) + 4}>{v}%</text></>)}</g>
                <g class="months">
                  <text x={tx(0, t.a.length)} y={H - 4} text-anchor="start">{monthName(t.months[0], true)}</text>
                  <text x={tx(t.a.length - 1, t.a.length)} y={H - 4} text-anchor="end">{monthName(t.months.at(-1), true)}</text>
                </g>
                <path class="l-ca" d={line(t.b)} pathLength="1" />
                <path class="l-p" d={line(t.a)} pathLength="1" />
                {t.a.at(-1) != null && <circle class="end" cx={tx(t.a.length - 1, t.a.length)} cy={ty(t.a.at(-1))} r="4.5" />}
                <g class="hair" data-hair hidden><line y1={PADT} y2={H - PADB} /><circle class="h-a" r="4.5" /><circle class="h-b" r="4" /></g>
              </svg>
              <div class="tip" data-tip aria-hidden="true" hidden></div>
            </div>
            <p class="visually-hidden" data-chart-status role="status" aria-live="polite" aria-atomic="true"></p>
          </figure>
        ))}
      </div>
      <p class="key" aria-hidden="true"><span class="k k--p">Province</span><span class="k k--ca">Canada</span></p>
    </div>
  </section>
  )}

  <!-- OUT OF EVERY 100 adults -->
  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Out of every 100 adults</h2>
        <p class="lead">People 15 and over: working, looking for work, or neither (students, retirees, people caring for family).</p>
      </div>
      <ul class="hundreds" data-stagger>
        {lfRows.map((r) => (
          <li class="h-item">
            <h3>{NAME[r.g]}</h3>
            <svg class="waffle" viewBox="0 0 100 100" role="img" aria-label={`Out of every 100 people 15 and over in ${NAME[r.g]}: ${r.work} working, ${r.look} looking for work, ${r.out} neither.`}>
              {Array.from({ length: 100 }, (_, i) => <rect x={(i % 10) * 10 + 0.8} y={Math.floor(i / 10) * 10 + 0.8} width="8.4" height="8.4" class={i < r.work ? 'w-work' : i < r.work + r.look ? 'w-look' : 'w-out'} style={`--i:${i}`} />)}
            </svg>
            <dl class="h-key">
              <div><dt><span class="sw sw--work"></span>Working</dt><dd>{r.work}</dd></div>
              <div><dt><span class="sw sw--look"></span>Looking for work</dt><dd>{r.look}</dd></div>
              <div><dt><span class="sw sw--out"></span>Neither</dt><dd>{r.out}</dd></div>
            </dl>
            <p class="h-note">{rate(r.pr)} in the labour force{r.prY != null && `, ${percentagePoints(r.prY)} from a year ago`}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- YOUNG PEOPLE -->
  {youthRows.length > 0 && (
  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Young people</h2>
        <p class="lead">Unemployment among people aged 15 to 24, compared with everyone aged 15 and over.</p>
      </div>
      <div class="youth" data-animate>
        <div class="y-axis" aria-hidden="true">{yTicks.map((t) => <span style={`left:${yx(t)}`}>{t}%</span>)}</div>
        {youthRows.map((r) => (
          <div class:list={['y-row', r.g === 'CA' && 'y-row--ca']}>
            <p class="y-name">{NAME[r.g]}</p>
            <div class="y-track" aria-hidden="true">
              <span class="y-gap" style={`left:${yx(r.all.now)};width:calc(${yx(r.youth.now)} - ${yx(r.all.now)})`}></span>
              <span class="y-dot y-dot--all" style={`left:${yx(r.all.now)}`}></span>
              <span class="y-dot y-dot--youth" style={`left:${yx(r.youth.now)}`}></span>
            </div>
            <p class="y-fig"><strong>{rate(r.youth.now)}</strong> <span>15 to 24</span><span class="visually-hidden">, against {rate(r.all.now)} for everyone</span></p>
          </div>
        ))}
        <p class="key" aria-hidden="true"><span class="k k--all">Everyone 15 and over</span><span class="k k--youth">15 to 24</span></p>
      </div>
    </div>
  </section>
  )}

  <!-- INDUSTRIES -->
  {indViews.length > 0 && (
  <section class="section section--tint" data-ind>
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Industries</h2>
        <p class="lead" data-ind-summary aria-live="polite" aria-atomic="true">{indViews[0].summary}</p>
      </div>
      <div class="pick" role="group" aria-label="Show industries in">
        {indViews.map((v, i) => <button type="button" data-pick={v.g} aria-pressed={String(i === 0)}>{SHORT[v.g]}</button>)}
      </div>
      {indViews.map((v, i) => (
        <div class="ind" data-view={v.g} data-summary={v.summary} hidden={i !== 0}>
          <h3 class="visually-hidden">{NAME[v.g]}</h3>
          <ul class="i-list">
            {v.rows.map((r) => (
              <li>
                <span class="i-name">{r.name}<span class="i-now">{num(r.now)} working</span></span>
                <span class="i-track" aria-hidden="true"><span class:list={['i-bar', r.y < 0 && 'i-bar--down']} style={`--w:${(Math.abs(r.y) / v.max) * 50}%`}></span></span>
                <span class="i-v">{r.y === 0 ? 'No change' : signed(r.y)}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  )}

  <!-- WAGES -->
  {wageRows.length > 0 && (
  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Wages</h2>
        <p class="lead">The average hourly wage of employees, its change over the year, and the province’s minimum wage.</p>
      </div>
      <div class="wages" data-animate>
        <div class="w-axis" aria-hidden="true">{wTicks.map((t) => <span style={`left:${wx(t)}`}>${t}</span>)}</div>
        {wageRows.map((r) => (
          <div class:list={['w-row', r.g === 'CA' && 'w-row--ca']}>
            <p class="w-name"><strong>{NAME[r.g]}</strong>{r.min && <span>Minimum {money(r.min.rate)}</span>}</p>
            <div class="w-track" aria-hidden="true">
              {r.min && <span class="w-gap" style={`left:${wx(r.min.rate)};width:calc(${wx(r.now)} - ${wx(r.min.rate)})`}></span>}
              {r.min && <span class="w-dot w-dot--min" style={`left:${wx(r.min.rate)}`}></span>}
              <span class="w-dot w-dot--avg" style={`left:${wx(r.now)}`}></span>
            </div>
            <p class="w-fig"><span class="figure">{money(r.now)}</span>{r.yPct != null && <span>{pct1(r.yPct)} over the year</span>}</p>
          </div>
        ))}
        <p class="key" aria-hidden="true"><span class="k k--wage">Average hourly wage</span><span class="k k--min">Minimum wage</span></p>
      </div>
      <p class="note">Wages aren’t seasonally adjusted, so they’re compared with the same month last year. Minimum wage is each province’s general hourly rate today. <a href={url('/learn/tools/pay-on-open-jobs/')}>See what our open jobs pay</a>.</p>

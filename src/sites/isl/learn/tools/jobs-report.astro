<script>
  // 1. Industries: the province buttons show one province's list; ?province=NB opens on it
  const ind = document.querySelector<HTMLElement>('[data-ind]');
  if (ind) {
    const buttons = [...ind.querySelectorAll<HTMLButtonElement>('[data-pick]')];
    const summary = ind.querySelector<HTMLElement>('[data-ind-summary]')!;
    const show = (key: string, push = true) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.pick === key)));
      ind.querySelectorAll<HTMLElement>('[data-view]').forEach((el) => {
        el.hidden = el.dataset.view !== key;
        if (!el.hidden) summary.textContent = el.dataset.summary!;
      });
      if (push) { const u = new URL(location.href); u.searchParams.set('province', key); history.replaceState(null, '', u); }
    };
    buttons.forEach((b) => b.addEventListener('click', () => show(b.dataset.pick!)));
    const start = new URLSearchParams(location.search).get('province');
    if (start && buttons.some((b) => b.dataset.pick === start)) show(start, false);
  }

  // 2. Hover previews a month; a tap/click keeps it open until focus or a tap moves elsewhere.
  //    Only deliberate selections are announced, so pointer movement stays quiet.
  document.querySelectorAll<HTMLElement>('[data-sm]').forEach((fig) => {
    const d = JSON.parse(fig.dataset.sm!) as {
      m: string[]; short: string[]; a: (number | null)[]; b: (number | null)[]; n: string;
      scale: { width: number; height: number; left: number; bottom: number; top: number; min: number; max: number };
    };
    const svg = fig.querySelector('svg')!;
    const hair = fig.querySelector<SVGGElement>('[data-hair]')!;
    const tip = fig.querySelector<HTMLElement>('[data-tip]')!;
    const status = fig.querySelector<HTMLElement>('[data-chart-status]')!;
    const n = d.a.length;
    const s = d.scale;
    const x = (i: number) => s.left + (i / (n - 1)) * (s.width - s.left - 4);
    const y = (v: number) => s.top + (1 - (v - s.min) / (s.max - s.min)) * (s.height - s.top - s.bottom);
    let at = n - 1;
    let pinned = false;
    const fmt = (v: number | null) => (v == null ? '–' : `${v.toFixed(1)}%`);
    const spoken = (v: number | null) => (v == null ? 'not available' : `${v.toFixed(1)}%`);
    const draw = (i: number, announce = false) => {
      at = Math.max(0, Math.min(n - 1, i));
      const px = x(at);
      hair.removeAttribute('hidden');
      hair.querySelector('line')!.setAttribute('x1', String(px));
      hair.querySelector('line')!.setAttribute('x2', String(px));
      for (const [selector, value] of [['.h-a', d.a[at]], ['.h-b', d.b[at]]] as const) {
        const marker = hair.querySelector<SVGCircleElement>(selector)!;
        marker.toggleAttribute('hidden', value == null);
        if (value != null) { marker.setAttribute('cx', String(px)); marker.setAttribute('cy', String(y(value))); }
      }
      // The readout: values lead, names follow; built with textContent
      tip.replaceChildren();
      const head = document.createElement('p'); head.className = 'tip-m'; head.textContent = d.short[at]; tip.append(head);
      for (const [cls, name, v] of [['a', d.n, d.a[at]], ['b', 'Canada', d.b[at]]] as const) {
        const row = document.createElement('p'); row.className = `tip-r tip-r--${cls}`;
        const s = document.createElement('strong'); s.textContent = fmt(v);
        row.append(s, document.createTextNode(` ${name}`)); tip.append(row);
      }
      tip.hidden = false;
      const box = svg.getBoundingClientRect();
      const left = (px / s.width) * box.width;
      const target = left > box.width * 0.6 ? left - tip.offsetWidth - 12 : left + 12;
      tip.style.left = `${Math.max(0, Math.min(target, box.width - tip.offsetWidth))}px`;
      if (announce) status.textContent = `${d.m[at]}. ${d.n}: ${spoken(d.a[at])} unemployment. Canada: ${spoken(d.b[at])}.`;
    };
    const hide = () => { pinned = false; hair.setAttribute('hidden', ''); tip.hidden = true; status.textContent = ''; };
    const nearest = (clientX: number) => {
      const box = svg.getBoundingClientRect();
      if (!box.width) return at;
      const position = ((clientX - box.left) / box.width) * s.width;
      return Math.max(0, Math.min(n - 1, Math.round(((position - s.left) / (s.width - s.left - 4)) * (n - 1))));
    };
    svg.addEventListener('pointermove', (e) => {
      if (!pinned && e.pointerType !== 'touch' && e.pointerType !== 'pen') draw(nearest(e.clientX));
    });
    svg.addEventListener('click', (e) => { pinned = true; draw(nearest(e.clientX), true); });
    svg.addEventListener('pointerleave', () => { if (!pinned && document.activeElement !== fig) hide(); });
    fig.addEventListener('focus', () => draw(at, true));
    fig.addEventListener('blur', hide);
    fig.addEventListener('keydown', (e) => {
      const next = { ArrowLeft: at - 1, ArrowRight: at + 1, Home: 0, End: n - 1 }[e.key];
      if (next != null) { pinned = true; draw(next, true); e.preventDefault(); }
    });
    document.addEventListener('pointerdown', (e) => { if (!fig.contains(e.target as Node)) hide(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') hide();
    });
  });
</script>


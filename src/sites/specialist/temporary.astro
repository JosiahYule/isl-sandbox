---
// TEMPORARY STAFFING  →  /temporary/   (Accountant Staffing and Administrative Staffing)
// The specialist's version of ISL's Contract staffing page: when employers call, how it works,
// and what the one hourly rate covers. From the live Temporary Recruitment FAQ and Employers pages.
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import PageHero from '../../components/PageHero.astro';
import Steps from '../../components/Steps.astro';
import CtaBand from '../../components/CtaBand.astro';
import { field, terms } from '../../data/site.js';

const uses = [
  ['Leaves', 'Parental leave, sick leave or a leave of absence, covered for as long as it runs.'],
  ['Peak periods', field.peak],
  ['Projects', 'A system change, a cleanup or a special project, without adding headcount.'],
  ['Sudden vacancies', 'Keep the work moving while you search for a permanent hire.'],
];
const steps = [
  ['Tell us the role', 'The work, the skills and the dates. You set an approximate length.'],
  ['We match a contractor', 'Already tested, interviewed and reference-checked, so they can start on short notice.'],
  ['They start', 'They work with your team. End the contract any time without penalty, or extend it.'],
  ['We handle the rest', 'Payroll, remittances and the end of the contract, with check-ins along the way.'],
];
// What the one hourly rate covers (Temporary Recruitment FAQ: "How much does the service cost?")
const covered = [
  ['The contractor’s pay', 'They’re on our payroll, not yours.'],
  ['Employer EI and CPP', 'The employer’s share, included.'],
  ['Payroll', 'Processing and remittances.'],
  ['Our fee', 'Included in the rate.'],
];
---
<Base assistantMode="employer" title={`Temporary ${field.short} staffing`} description={`Pre-screened temporary ${field.short} staff across Atlantic Canada, on short notice, for one hourly rate.`}>
  <PageHero title="Temporary staff, on short notice." lead={`Pre-screened ${field.people} for leaves, peak periods and projects.`}>
    <Button href="/hire/?service=contract" size="lg">Request a contractor</Button>
  </PageHero>

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head"><h2>When employers call us</h2></div>
      <ul class="items">
        {uses.map(([t, d]) => <li class="item"><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section-head"><h2>How it works</h2></div>
      <Steps steps={steps} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="section-head">
        <h2>One hourly rate.</h2>
        <p class="lead">It varies with the role’s level and the contractor’s experience, and it covers everything below.</p>
      </div>
      <ul class="covered">
        {covered.map(([t, d]) => <li><strong>{t}</strong><span>{d}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap perm">
      <p class="figure">{terms.tempToPerm}</p>
      <div>
        <h2>Contracts often become permanent.</h2>
        <p class="lead">A contract is a fair trial for both sides, and you can hire them when you’re sure.</p>
      </div>
    </div>
  </section>

  <CtaBand title="Need someone next week?" text="Tell us the role and the dates. One hourly rate, and you can end the contract any time." href="/hire/?service=contract" label="Request a contractor" />
</Base>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .covered { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .covered li { display: grid; grid-template-columns: minmax(0, 12rem) minmax(0, 1fr); gap: var(--s4); padding-block: var(--s4); border-bottom: 1px solid var(--line); }
  .covered span { color: var(--ink-soft); }

  .perm { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s6) clamp(2rem, 6vw, 5rem); align-items: center; }
  .perm .figure { margin: 0; font-size: var(--fs-figure-lg); color: var(--direct); white-space: nowrap; }
  .perm h2 { font-size: var(--fs-h2); margin-bottom: var(--s3); }

  @media (max-width: 860px) {
    .split, .perm { grid-template-columns: 1fr; }
    .covered li { grid-template-columns: 1fr; gap: var(--s1); }
  }
</style>

---
// ABOUT US  →  /about/   (Accountant Staffing and Administrative Staffing)
// The same shape as ISL's About page: the promise, the key figures, then the firm itself,
// in the live About page's words (src/brands/copy/), and the family of firms it belongs to.
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import PageHero from '../../components/PageHero.astro';
import Facts from '../../components/Facts.astro';
import CtaBand from '../../components/CtaBand.astro';
import { brand, offices, terms, copy } from '../../data/site.js';

const c = copy.about;
const facts = [
  [String(new Date().getFullYear() - brand.since), 'years in Atlantic Canada'],
  [String(offices.length), 'local offices'],
  ['6 months', 'guarantee on permanent hires', 'direct'],
  [terms.tempToPerm, 'contracts become permanent', 'direct'],
];
// The three sister firms
const family = [
  { name: 'Accountant Staffing', what: 'Accounting and finance professionals', href: 'https://www.accountantstaffing.ca' },
  { name: 'Administrative Staffing', what: 'Administrative professionals', href: 'https://www.administrativestaffing.ca' },
  { name: 'Integrated Staffing', what: 'Contract and permanent staffing in every industry', href: 'https://www.integratedstaffing.ca' },
];
---
<Base title="About Us" description={c.text[0]}>
  <PageHero title={c.title} lead={c.text[0]}>
    <Button href="/employers/">For Employers</Button>
    <Button href="/job-seekers/" variant="outline">For Job Seekers</Button>
  </PageHero>

  <Facts facts={facts} />

  <section class="section">
    <div class="wrap story">
      {c.text.slice(1).map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Three firms, one family</h2>
        <p class="lead">Locally owned and operated in Atlantic Canada.</p>
      </div>
      <ul class="items family">
        {family.map((f) => (
          <li class:list={['item', f.name === brand.name && 'item--blue']}>
            <h3>{f.name}</h3>
            <p>{f.what}</p>
            {f.name === brand.name ? <span class="here">You’re here</span> : <a class="more" href={f.href}>Visit {f.name}</a>}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .story { display: grid; gap: var(--s5); max-width: 62ch; }
  .story p { font-size: var(--fs-lead); font-weight: var(--fw-light); line-height: 1.55; }
  .here { display: inline-block; margin-top: var(--s3); font-weight: var(--fw-bold); color: var(--direct); }
</style>

---
// ABOUT US  →  /about/   (Accountant Staffing and Administrative Staffing)
// The same shape as ISL's About page: the promise, the key figures, then the firm itself,
// in the live About page's words (src/brands/copy/). The three sister firms are in every footer
// ("Three brands. One network."), so this page doesn't repeat them.
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Facts from '../../components/Facts.astro';
import CtaBand from '../../components/CtaBand.astro';
import { brand, offices, terms, copy } from '../../data/site.js';

const c = copy.about;
const facts = [
  [String(new Date().getFullYear() - brand.since), 'years in Atlantic Canada'],
  [String(offices.length), 'local offices'],
  ['6 months', 'guarantee on permanent hires', 'direct'],
  [terms.tempToPerm, 'contracts become permanent', 'direct'],
];
---
<Base title="About us" description={c.text[0]}>
  <PageHero title={c.title} lead={c.text[0]} />

  <Facts facts={facts} />

  <section class="section">
    <div class="wrap story">
      {c.text.slice(1).map((p) => <p>{p}</p>)}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .story { display: grid; gap: var(--s5); max-width: 62ch; }
  .story p { font-size: var(--fs-lead); font-weight: var(--fw-light); line-height: 1.55; }
</style>

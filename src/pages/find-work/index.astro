---
// JOB BOARD  →  /find-work/
// Search and filters run in the browser over the listings on the page.
// Jobs are a real snapshot of the Avionte feed (src/data/jobs.js); later the page reads the feed live.
// Linking with ?q=forklift pre-fills the search (the homepage search does this).
// Linking with ?area=halifax shows jobs near that office (the footer's "Jobs near" links do this).
import Base from '../../layouts/Base.astro';
import JobRow from '../../components/JobRow.astro';
import PageHero from '../../components/PageHero.astro';
import { jobs, provinces } from '../../data/jobs.js';
import { areas } from '../../data/areas.js';
import { url } from '../../lib/url.js';
import { industryPages } from '../../data/industries.js';
import { brand, links, services, field, copy } from '../../data/site.js';
// Industries that have open jobs right now, for the industry filter
const industryOptions = industryPages.map((i) => ({ slug: i.slug, name: i.name, n: jobs.filter((j) => j.industry === i.slug).length })).filter((i) => i.n);

const provinceOptions = [...new Set(jobs.map((j) => j.province))]
  .map((code) => ({ code, name: provinces[code] ?? code }))
  .sort((a, b) => a.name.localeCompare(b.name));
const PAGE = 15; // rows shown before "Show all"; search and filters always show every match
const areaLinks = areas.map((a) => ({ ...a, n: jobs.filter((j) => j.area === a.key).length }))
const count = { contract: jobs.filter((j) => j.type === 'contract').length, direct: jobs.filter((j) => j.type === 'direct').length };
---
<Base assistantMode="seeker" title="Find work" description={field ? `Temporary and permanent ${field.short} jobs across Atlantic Canada.` : 'Contract and permanent jobs across Atlantic Canada and beyond.'}>
  <PageHero title={field ? 'Job opportunities.' : 'Find your next job.'} lead={field ? `Temporary and permanent ${field.short} roles across Atlantic Canada.` : 'Contract and permanent roles across Atlantic Canada.'}>
    {brand.assistant && <button type="button" class="textlink" data-open-assistant>Or describe what you want to the job assistant</button>}
  </PageHero>

  <section class="results" data-isl-live="results">
    <div class="wrap">
      <form class:list={['search', industryOptions.length === 0 && 'search--3']} role="search" data-search>
        <label class="visually-hidden" for="q">Search jobs</label>
        <input id="q" name="q" type="search" placeholder="Job title, skill or city" autocomplete="off" />
        <label class="visually-hidden" for="prov">Province</label>
        <select id="prov" name="province">
          <option value="">All provinces</option>
          {provinceOptions.map((p) => <option value={p.code}>{p.name}</option>)}
        </select>
        {industryOptions.length > 0 && <label class="visually-hidden" for="ind">Industry</label>}
        {industryOptions.length > 0 && <select id="ind" name="industry">
          <option value="">All industries</option>
          {industryOptions.map((i) => <option value={i.slug}>{i.name}</option>)}
        </select>}
        <div class="types" role="group" aria-label="Job type">
          <button type="button" class="t" data-type="" aria-pressed="true">All</button>
          <button type="button" class="t t--contract" data-type="contract" aria-pressed="false">{services.contract.jobLabel} <span>{count.contract}</span></button>
          <button type="button" class="t t--direct" data-type="direct" aria-pressed="false">{services.direct.jobLabel} <span>{count.direct}</span></button>
        </div>
      </form>
      <nav class="near" aria-label="Jobs near an office">
        <span>Jobs near</span>
        <ul>
          {/* An office with nothing open is left out of view (a dead end), but kept so its footer link still filters */}
          {areaLinks.map((a) => (
            <li hidden={a.n === 0 || undefined}><a href={url(`/find-work/?area=${a.key}`)} data-area={a.key}>{a.label} <span class="n">{a.n}</span></a></li>
          ))}
        </ul>
      </nav>
      <h2 class="visually-hidden">Open roles</h2>
      <div class="results-heading">
        <div aria-live="polite" aria-atomic="true">
          <p class="count"><strong data-count>{jobs.length}</strong> <span data-count-label>open roles</span></p>
          <p class="result-summary" data-result-summary>{jobs.length} roles available</p>
        </div>
        <button class="reset" type="button" data-reset hidden>Clear search and filters</button>
      </div>
      <div class="list" data-list>
        {jobs.map((job) => <JobRow job={job} />)}
      </div>
      <button type="button" class="more" data-more hidden>Show all {jobs.length} roles</button>
      <div class="empty" data-empty hidden>
        <p class="empty-title">No roles match that search.</p>
        <p>Try a broader term or another province. Or <a href={links.resume}>send us your resume</a> and we'll contact you when something fits.</p>
      </div>
    </div>
  </section>

  <section class="section section--tint general">
    <div class="wrap general-grid">
      <h2>Don't see the right role?</h2>
      <div>
        <p class="lead">Send your resume and we'll contact you when something fits.</p>
        <a class="apply" href={links.resume}>Send your resume</a>
      </div>
    </div>
  </section>

  {copy?.jobs?.inclusion && (
    <section class="section inclusion">
      <div class="wrap general-grid">
        <h2>Diversity and inclusion</h2>
        <div>{copy.jobs.inclusion.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>
  )}

</Base>

<script>
  import { matchesJobQuery } from '../../lib/jobsearch.js';
  import { RESULT_KEYS, resultsContext } from '../../lib/job-navigation.js';

  const form = document.querySelector<HTMLFormElement>('[data-search]')!;
  const q = form.querySelector<HTMLInputElement>('#q')!;
  const prov = form.querySelector<HTMLSelectElement>('#prov')!;
  const ind = form.querySelector<HTMLSelectElement>('#ind');
  const typeButtons = [...form.querySelectorAll<HTMLButtonElement>('.t')];
  const rows = [...document.querySelectorAll<HTMLElement>('[data-list] > *')];
  const countEl = document.querySelector('[data-count]')!;
  const labelEl = document.querySelector('[data-count-label]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const more = document.querySelector<HTMLButtonElement>('[data-more]')!;
  const reset = document.querySelector<HTMLButtonElement>('[data-reset]')!;
  const summary = document.querySelector<HTMLElement>('[data-result-summary]')!;
  const areaLinks = [...document.querySelectorAll<HTMLAnchorElement>('.near a')];
  const PAGE = 15;
  const KEYS = RESULT_KEYS;
  let area = '', type = '', expanded = false;
  let trackingTimer: ReturnType<typeof setTimeout>;

  function syncUrl() {
    const u = new URL(location.href);
    const values = [q.value.trim(), prov.value, ind?.value || '', type, area, expanded ? 'all' : ''];
    KEYS.forEach((key, i) => values[i] ? u.searchParams.set(key, values[i]) : u.searchParams.delete(key));
    history.replaceState(null, '', u);
  }

  function apply(sync = true, track = true) {
    const term = q.value.trim();
    const filtering = !!(term || prov.value || ind?.value || type || area);
    let shown = 0;
    rows.forEach((r) => {
      const ok = matchesJobQuery(r.dataset.search, term)
        && (!prov.value || r.dataset.province === prov.value)
        && (!ind?.value || r.dataset.industry === ind.value)
        && (!type || r.dataset.type === type)
        && (!area || r.dataset.area === area);
      if (ok) shown++;
      r.hidden = !ok || (!filtering && !expanded && shown > PAGE);
    });
    more.hidden = filtering || expanded || shown <= PAGE;
    areaLinks.forEach((a) => a.dataset.area === area ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current'));
    typeButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.type === type)));
    countEl.textContent = String(shown);
    labelEl.textContent = shown === 1 ? 'open role' : 'open roles';
    empty.hidden = shown > 0;
    reset.hidden = !filtering;
    const visible = filtering || expanded ? shown : Math.min(PAGE, shown);
    const filters = [term ? `“${term}”` : '', prov.value ? prov.selectedOptions[0].textContent : '',
      ind?.value ? ind.selectedOptions[0].textContent : '', type ? typeButtons.find((b) => b.dataset.type === type)?.firstChild?.textContent?.trim() : '',
      area ? `near ${areaLinks.find((a) => a.dataset.area === area)?.firstChild?.textContent?.trim()}` : ''].filter(Boolean);
    summary.textContent = `Showing ${visible} of ${shown} ${shown === 1 ? 'role' : 'roles'}${filters.length ? ' · ' + filters.join(' · ') : ''}`;
    if (sync) syncUrl();
    const context = resultsContext(location.search);
    rows.forEach((row) => {
      const link = row.querySelector<HTMLAnchorElement>('h3 a');
      if (!link) return;
      // Add the search to the job's link, keeping what the link already has (on Squarespace a job's
      // address is /find-work/job?id=..., and replacing the whole query would drop the job's ID)
      const destination = new URL(link.href);
      RESULT_KEYS.forEach((key) => destination.searchParams.delete(key));
      new URLSearchParams(context).forEach((value, key) => destination.searchParams.set(key, value));
      link.href = destination.href;
    });
    if (track) {
      clearTimeout(trackingTimer);
      trackingTimer = setTimeout(() => document.dispatchEvent(new CustomEvent('isl:track', {
        detail: { name: 'job_search', params: { audience: 'candidate', results_count: shown,
          has_keywords: !!term, province: prov.value || 'all', service: type || 'all' } },
      })), 500); // counts only; never send the visitor's free-text search to analytics
    }
  }

  function readUrl() {
    const params = new URLSearchParams(location.search);
    q.value = params.get('q') || '';
    const validOption = (select: HTMLSelectElement | null, value: string) =>
      select && [...select.options].some((o) => o.value === value) ? value : '';
    prov.value = validOption(prov, params.get('province') || '');
    if (ind) ind.value = validOption(ind, params.get('industry') || '');
    type = ['contract', 'direct'].includes(params.get('type') || '') ? params.get('type')! : '';
    area = areaLinks.some((a) => a.dataset.area === params.get('area')) ? params.get('area')! : '';
    expanded = params.get('view') === 'all';
    apply(false, false);
  }

  form.addEventListener('submit', (e) => { e.preventDefault(); apply(); });
  q.addEventListener('input', () => apply());
  prov.addEventListener('change', () => apply());
  ind?.addEventListener('change', () => apply());
  typeButtons.forEach((b) => b.addEventListener('click', () => { type = b.dataset.type || ''; apply(); }));
  areaLinks.forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault(); area = area === a.dataset.area ? '' : a.dataset.area!; apply();
  }));
  more.addEventListener('click', () => { expanded = true; apply(); rows[PAGE]?.querySelector('a')?.focus(); });
  reset.addEventListener('click', () => {
    q.value = ''; prov.value = ''; if (ind) ind.value = ''; type = ''; area = ''; expanded = false;
    apply(); q.focus();
  });
  window.addEventListener('popstate', readUrl);
  readUrl();
</script>

<style>
  .search {
    display: grid; grid-template-columns: 1fr 12rem 15rem auto; gap: var(--s2);
    margin-bottom: var(--s6); padding: var(--s2); background: var(--paper);
    border: 1.5px solid var(--ink); border-radius: var(--radius);
  }
  .search input, .search select {
    font: inherit; font-size: var(--fs-body); padding: 0.85rem 1rem; border: 0; background: transparent; color: var(--ink); min-width: 0;
  }
  .search select { border-left: 1px solid var(--line); cursor: pointer; }
  .search input:focus, .search select:focus { outline: 2px solid var(--accent); outline-offset: -2px; }
  .types { display: flex; gap: 4px; padding: 4px; border-left: 1px solid var(--line); }
  .t {
    font: inherit; font-size: var(--fs-small); font-weight: var(--fw-bold); cursor: pointer; white-space: nowrap;
    display: inline-flex; align-items: center; gap: var(--s2);
    padding: 0.55rem 0.9rem; border: 0; border-radius: 2px; background: transparent; color: var(--ink);
  }
  .t span { font-weight: var(--fw-text); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .t[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .t[aria-pressed='true'] span { color: rgb(255 255 255 / 0.7); }
  .t--contract[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .t--contract[aria-pressed='true'] span { color: rgb(255 255 255 / 0.7); }
  .t--direct[aria-pressed='true'] { background: var(--direct); }


  .search--3 { grid-template-columns: 1fr 12rem auto; }
  .results { padding-block: 0 clamp(4rem, 8vw, 6.5rem); }
  .near { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); margin: calc(-1 * var(--s3)) 0 var(--s6); font-size: var(--fs-small); }
  .near > span { color: var(--ink-soft); }
  .near ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }
  .near a { display: inline-flex; gap: var(--s2); padding: 0.4rem 0.8rem; border: 1.5px solid var(--line); color: var(--ink); text-decoration: none; font-weight: var(--fw-bold); }
  .near a:hover { border-color: var(--ink); }
  .near a[aria-current='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .near .n { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .near a[aria-current='true'] .n { color: rgb(255 255 255 / 0.7); }
  .results-heading { display: flex; flex-wrap: wrap; gap: var(--s3) var(--s5); justify-content: space-between; align-items: center; margin-bottom: var(--s4); }
  .count { font-size: var(--fs-small); color: var(--ink-soft); }
  .result-summary { font-size: var(--fs-small); color: var(--ink-soft); margin-top: var(--s2); overflow-wrap: anywhere; }
  .count strong { font-weight: var(--fw-bold); font-size: var(--fs-h3); color: var(--ink); margin-right: 0.2em; }
  .list { border-top: 1.5px solid var(--ink); }
  /* The rows are JobRow components, so the rule must reach outside this page's own styles */
  .list > :global([hidden]) { display: none; }
  .empty { padding: var(--s7) 0; border-top: 1.5px solid var(--ink); max-width: 46rem; }
  .empty-title { font-weight: var(--fw-bold); font-size: var(--fs-h3); }
  .reset { font: inherit; font-size: var(--fs-small); font-weight: var(--fw-bold); cursor: pointer;
    padding: 0.7rem 1rem; border: 1.5px solid var(--ink); border-radius: var(--radius); background: transparent; color: var(--ink); }
  .reset:hover { background: var(--ink); color: #fff; }
  .more {
    margin-top: var(--s5); font: inherit; font-weight: var(--fw-bold); cursor: pointer;
    padding: 0.8rem 1.35rem; border: 2px solid var(--ink); background: transparent; color: var(--ink);
  }
  .more:hover { background: var(--ink); color: #fff; }
  .more[hidden] { display: none; }
  .note { margin-top: var(--s5); font-size: var(--fs-tiny); color: var(--ink-soft); }

  .general-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s7); align-items: end; }
  .apply { display: inline-block; margin-top: var(--s5); font-weight: var(--fw-bold); background: var(--accent); color: #fff; text-decoration: none; padding: 0.9rem 1.4rem; }
  .apply:hover { background: var(--accent-deep); color: #fff; }

  /* Mid-size screens: search on its own row, the two filters side by side, job type below */
  @media (max-width: 1100px) {
    .search { grid-template-columns: 1fr 1fr; }
    .search input, .search .types, .search--3 select { grid-column: 1 / -1; }
  }
  /* Phones: the two filters stay side by side and the office links run in one swipeable line,
     so the first jobs start on the first screen instead of below a stack of controls */
  @media (max-width: 860px) {
    .search select { border-left: 0; border-top: 1px solid var(--line); padding-inline: 0.75rem; }
    .search select + label + select, .search select + select { border-left: 1px solid var(--line); }
    .near { flex-wrap: nowrap; margin-right: calc(-1 * var(--gutter, 1.25rem)); }
    .near > span { flex-shrink: 0; }
    .near ul { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; padding-right: var(--gutter, 1.25rem); }
    .near ul::-webkit-scrollbar { display: none; }
    .near li { flex-shrink: 0; }
    .types { overflow-x: auto; border-left: 0; border-top: 1px solid var(--line); }
    .general-grid { grid-template-columns: 1fr; }
  }
  .inclusion .general-grid { align-items: start; }
  .inclusion p { margin: 0; max-width: 64ch; color: var(--ink-soft); }
  .inclusion p + p { margin-top: var(--s3); }
</style>

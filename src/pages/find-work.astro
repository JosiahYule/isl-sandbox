---
// JOB BOARD  →  /find-work/
// Search and filters run in the browser over the listings on the page.
// Jobs are a real snapshot of the Avionte feed (src/data/jobs.js); later the page reads the feed live.
// Linking with ?q=forklift pre-fills the search (the homepage search does this).
// Linking with ?area=halifax shows jobs near that office (the footer's "Jobs near" links do this).
import Base from '../layouts/Base.astro';
import JobRow from '../components/JobRow.astro';
import PageHero from '../components/PageHero.astro';
import { jobs, provinces, snapshotDate } from '../data/jobs.js';
import { areas } from '../data/areas.js';
import { url } from '../lib/url.js';

const provinceOptions = [...new Set(jobs.map((j) => j.province))]
  .map((code) => ({ code, name: provinces[code] ?? code }))
  .sort((a, b) => a.name.localeCompare(b.name));
const PAGE = 15; // rows shown before "Show all"; search and filters always show every match
const areaLinks = areas.map((a) => ({ ...a, n: jobs.filter((j) => j.area === a.key).length }));
const count = { contract: jobs.filter((j) => j.type === 'contract').length, direct: jobs.filter((j) => j.type === 'direct').length };
---
<Base assistantMode="seeker" title="Find work" description="Contract and permanent jobs across Atlantic Canada and beyond.">
  <PageHero title="Find your next job." lead="Contract and permanent roles across Atlantic Canada.">
    <button type="button" class="textlink" data-open-assistant>Or describe what you want to the job assistant</button>
  </PageHero>

  <section class="results">
    <div class="wrap">
      <form class="search" role="search" data-search>
        <label class="visually-hidden" for="q">Search jobs</label>
        <input id="q" name="q" type="search" placeholder="Job title, skill or city" autocomplete="off" />
        <label class="visually-hidden" for="prov">Province</label>
        <select id="prov" name="province">
          <option value="">All provinces</option>
          {provinceOptions.map((p) => <option value={p.code}>{p.name}</option>)}
        </select>
        <div class="types" role="group" aria-label="Job type">
          <button type="button" class="t" data-type="" aria-pressed="true">All</button>
          <button type="button" class="t t--contract" data-type="contract" aria-pressed="false">Contract <span>{count.contract}</span></button>
          <button type="button" class="t t--direct" data-type="direct" aria-pressed="false">Permanent <span>{count.direct}</span></button>
        </div>
      </form>
      <nav class="near" aria-label="Jobs near an office">
        <span>Jobs near</span>
        <ul>
          {areaLinks.map((a) => (
            <li><a href={url(`/find-work/?area=${a.key}`)} data-area={a.key}>{a.label} <span class="n">{a.n}</span></a></li>
          ))}
        </ul>
      </nav>
      <h2 class="visually-hidden">Open roles</h2>
      <p class="count" aria-live="polite"><strong data-count>{jobs.length}</strong> <span data-count-label>open roles</span></p>
      <div class="list" data-list>
        {jobs.map((job) => <JobRow job={job} />)}
      </div>
      <button type="button" class="more" data-more>Show all {jobs.length} roles</button>
      <div class="empty" data-empty hidden>
        <p class="empty-title">No roles match that search.</p>
        <p>Try a broader term or another province. Or <a href="https://www.integratedstaffing.ca/careers/general-apply">send us your resume</a> and we'll contact you when something fits.</p>
        <button type="button" data-reset>Clear search and filters</button>
      </div>
      <p class="note">Sandbox preview: real postings from ISL's job feed as of {snapshotDate}. Some may have been filled since.</p>
    </div>
  </section>

  <section class="section section--tint general">
    <div class="wrap general-grid">
      <h2>Don't see the right role?</h2>
      <div>
        <p class="lead">Send your resume and we'll contact you when something fits.</p>
        <a class="apply" href="https://www.integratedstaffing.ca/careers/general-apply">Send your resume</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector('[data-search]');
  const q = form.querySelector('#q');
  const prov = form.querySelector('#prov');
  const typeButtons = form.querySelectorAll('.t');
  const rows = [...document.querySelectorAll('[data-list] > *')];
  const countEl = document.querySelector('[data-count]');
  const labelEl = document.querySelector('[data-count-label]');
  const empty = document.querySelector('[data-empty]');
  const more = document.querySelector('[data-more]');
  const areaLinks = document.querySelectorAll('.near a');
  let area = new URLSearchParams(location.search).get('area') ?? '';
  const PAGE = 15;
  let type = '';
  let expanded = false;

  function apply() {
    const term = q.value.trim().toLowerCase();
    const filtering = !!(term || prov.value || type || area);
    let shown = 0;
    rows.forEach((r) => {
      const ok = (!term || r.dataset.search.includes(term))
        && (!prov.value || r.dataset.province === prov.value)
        && (!type || r.dataset.type === type)
        && (!area || r.dataset.area === area);
      if (ok) shown++;
      // Without a search or filter, show the newest PAGE roles until "Show all" is pressed
      r.hidden = !ok || (!filtering && !expanded && shown > PAGE);
    });
    more.hidden = filtering || expanded || shown <= PAGE;
    areaLinks.forEach((a) => a.setAttribute('aria-current', String(a.dataset.area === area)));
    countEl.textContent = shown;
    labelEl.textContent = shown === 1 ? 'open role' : 'open roles';
    empty.hidden = shown > 0;
  }

  q.value = new URLSearchParams(location.search).get('q') ?? '';
  form.addEventListener('submit', (e) => { e.preventDefault(); apply(); });
  q.addEventListener('input', apply);
  prov.addEventListener('change', apply);
  typeButtons.forEach((b) => b.addEventListener('click', () => {
    type = b.dataset.type;
    typeButtons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    apply();
  }));
  // Area links filter in place (no page reload) and keep the address shareable
  areaLinks.forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    area = area === a.dataset.area ? '' : a.dataset.area;
    const u = new URL(location.href);
    area ? u.searchParams.set('area', area) : u.searchParams.delete('area');
    history.replaceState(null, '', u);
    apply();
  }));
  more.addEventListener('click', () => { expanded = true; apply(); rows[PAGE]?.querySelector('a')?.focus(); });
  document.querySelector('[data-reset]').addEventListener('click', () => {
    q.value = ''; prov.value = ''; type = ''; area = '';
    const u = new URL(location.href); u.searchParams.delete('area'); history.replaceState(null, '', u);
    typeButtons.forEach((x, i) => x.setAttribute('aria-pressed', String(i === 0)));
    apply(); q.focus();
  });
  apply();
</script>

<style>
  .search {
    display: grid; grid-template-columns: 1fr 14rem auto; gap: var(--s2);
    margin-bottom: var(--s6); padding: var(--s2); background: var(--paper);
    border: 1.5px solid var(--ink); border-radius: var(--radius);
  }
  .search input, .search select {
    font: inherit; font-size: 1.05rem; padding: 0.85rem 1rem; border: 0; background: transparent; color: var(--ink); min-width: 0;
  }
  .search select { border-left: 1px solid var(--line); cursor: pointer; }
  .search input:focus, .search select:focus { outline: 2px solid var(--isl-blue); outline-offset: -2px; }
  .types { display: flex; gap: 4px; padding: 4px; border-left: 1px solid var(--line); }
  .t {
    font: inherit; font-size: var(--fs-small); font-weight: 600; cursor: pointer; white-space: nowrap;
    display: inline-flex; align-items: center; gap: var(--s2);
    padding: 0.55rem 0.9rem; border: 0; border-radius: 2px; background: transparent; color: var(--ink);
  }
  .t span { font-weight: 500; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .t[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .t[aria-pressed='true'] span { color: rgb(255 255 255 / 0.7); }
  .t--contract[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .t--contract[aria-pressed='true'] span { color: rgb(255 255 255 / 0.7); }
  .t--direct[aria-pressed='true'] { background: var(--direct); }


  .results { padding-block: 0 clamp(4rem, 8vw, 6.5rem); }
  .near { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s2) var(--s4); margin: calc(-1 * var(--s3)) 0 var(--s6); font-size: var(--fs-small); }
  .near > span { color: var(--ink-soft); }
  .near ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2); }
  .near a { display: inline-flex; gap: var(--s2); padding: 0.4rem 0.8rem; border: 1.5px solid var(--line); color: var(--ink); text-decoration: none; font-weight: 500; }
  .near a:hover { border-color: var(--ink); }
  .near a[aria-current='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .near .n { color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .near a[aria-current='true'] .n { color: rgb(255 255 255 / 0.7); }
  .count { font-size: var(--fs-small); color: var(--ink-soft); margin-bottom: var(--s3); }
  .count strong { font-weight: 700; font-size: 1.4rem; color: var(--ink); margin-right: 0.2em; }
  .list { border-top: 1.5px solid var(--ink); }
  /* The rows are JobRow components, so the rule must reach outside this page's own styles */
  .list > :global([hidden]) { display: none; }
  .empty { padding: var(--s7) 0; border-top: 1.5px solid var(--ink); max-width: 46rem; }
  .empty-title { font-weight: 700; font-size: 1.4rem; }
  .empty button {
    margin-top: var(--s4); font: inherit; font-weight: 600; cursor: pointer;
    padding: 0.7rem 1.1rem; border: 2px solid var(--ink); border-radius: var(--radius); background: transparent;
  }
  .more {
    margin-top: var(--s5); font: inherit; font-weight: 600; cursor: pointer;
    padding: 0.8rem 1.35rem; border: 2px solid var(--ink); background: transparent; color: var(--ink);
  }
  .more:hover { background: var(--ink); color: #fff; }
  .more[hidden] { display: none; }
  .note { margin-top: var(--s5); font-size: var(--fs-tiny); color: var(--ink-soft); }

  .general-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s7); align-items: end; }
  .apply { display: inline-block; margin-top: var(--s5); font-weight: 600; background: var(--isl-blue); color: #fff; text-decoration: none; padding: 0.9rem 1.4rem; }
  .apply:hover { background: var(--isl-blue-deep); color: #fff; }

  @media (max-width: 860px) {
    .search { grid-template-columns: 1fr; }
    .search select { border-left: 0; border-top: 1px solid var(--line); }
    .types { overflow-x: auto; border-left: 0; border-top: 1px solid var(--line); }
    .general-grid { grid-template-columns: 1fr; }
  }
</style>

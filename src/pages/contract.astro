---
// CONTRACT STAFFING  →  /contract/
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import HireClock from '../components/HireClock.astro';
import IndustryMatrix from '../components/IndustryMatrix.astro';
import CtaBand from '../components/CtaBand.astro';

// What the single hourly rate covers (from the live About page).
const covered = [
  ['The worker’s wages', 'Paid by us, on our payroll.'],
  ['Payroll remittances', 'Handled and filed for every hour worked.'],
  ['Workers’ compensation', 'Coverage, claims, and safe, timely return to work.'],
  ['Screening', 'Including typing and dexterity tests where the role calls for them.'],
  ['Orientation', 'Company-specific orientations at no extra cost.'],
];
const uses = [
  ['Vacation and leave cover', 'Keep the work moving while someone is away, from a week of vacation to a full maternity leave.'],
  ['Seasonal peaks', 'Add people when orders climb and scale back when they settle.'],
  ['Steady growth', 'Staff up ahead of a new contract without committing to permanent headcount.'],
  ['Try before you hire', 'See someone on the job first, then bring them onto your team.'],
];
---
<Base assistant={false} title="Contract staffing" description="Pre-screened contract workers across Atlantic Canada, on site within hours of your request, for one all-inclusive hourly rate.">
  <PageHero svc="contract" title="Pre-screened workers, on site within hours." lead="For leaves, peaks and growth. One hourly rate covers everything, and the people work on our payroll, not yours.">
    <Button href="/hire/?service=contract" size="lg">Request workers</Button>
  </PageHero>

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head"><h2>When employers call us</h2></div>
      <ul class="items">
        {uses.map(([t, d]) => <li class="item"><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap rate-grid">
      <div class="section-head">
        <h2>One rate. Everything inside it.</h2>
        <p class="lead">You get a single hourly rate per worker. These costs are already in it, so there's nothing else to track, file or pay.</p>
      </div>
      <ul class="covered">
        {covered.map(([t, d]) => <li><span class="c-t">{t}</span><span class="c-d">{d}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Compared with a permanent search</h2>
      </div>
      <HireClock focus="contract" />
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap ind-grid">
      <div class="section-head">
        <h2>Where we place contract workers</h2>
        <p class="lead">Eight industries, from warehouse floors to contact centres.</p>
      </div>
      <IndustryMatrix only="contract" />
    </div>
  </section>

  <CtaBand title="Need people this week?" text="Tell us the role and the start date. A recruiter replies within one business day." href="/hire/?service=contract" label="Request workers" />
</Base>

<style>
  .rate-grid, .ind-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .covered { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .covered li { display: grid; grid-template-columns: 14rem 1fr; gap: var(--s4); padding-block: var(--s4); border-bottom: 1px solid var(--line); }
  .c-t { font-weight: 600; }
  .c-d { color: var(--ink-soft); }
  @media (max-width: 900px) {
    .rate-grid, .ind-grid { grid-template-columns: 1fr; }
    .covered li { grid-template-columns: 1fr; gap: var(--s1); }
  }
</style>

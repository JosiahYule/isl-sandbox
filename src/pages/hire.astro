---
// EMPLOYER REQUEST  →  /hire/
// The request form, with a card beside it showing who will reply. The card updates as the
// visitor picks a service and a province, using the same routing as the chatbot
// (assistant/supabase/functions/_shared/routing.js), so both always name the same person.
//
// Sending: when forms.requestEndpoint is set in src/data/site.js, the form posts to the
// isl-request function (assistant/supabase/functions/isl-request), which emails the recruiter
// the card names. With no endpoint (the sandbox), it shows the confirmation and says nothing was sent.
// Links can pre-fill it: ?service=contract|direct, ?details=... (the textarea), ?where=Nova Scotia
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import { brand, forms } from '../data/site.js';
import { url } from '../lib/url.js';

const locations = ['Nova Scotia', 'New Brunswick', 'Prince Edward Island', 'Newfoundland and Labrador', 'Elsewhere in Canada'];
const tel = `tel:+1${brand.mainPhone.replaceAll('-', '')}`;
// From the live /hire page: the four steps from request to filled position.
const afterSteps = [
  ['A recruiter replies', 'To confirm the role, timing and rate.'],
  ['We search our network', 'Recruiters screen candidates against your requirements.'],
  ['You meet the candidates', 'A shortlist, ready to interview or start.'],
  ['Your position is filled', 'We handle the paperwork and follow up after placement.'],
];
---
<Base assistantMode="employer" title="Request talent" description="Request contract workers or start a permanent search. A recruiter replies within one business day.">
  <PageHero compact title="Tell us who you need." lead="Contract workers anywhere in Atlantic Canada, permanent hires anywhere in Canada. A recruiter replies within one business day.">
    <a class="textlink" href={tel}>Prefer to talk? Call {brand.mainPhone}</a>
  </PageHero>

  <section class="section section--rule work">
    <div class="wrap layout">
      <form data-endpoint={forms.requestEndpoint || undefined} class="form" id="request" novalidate>
        <!-- 1. The request first: what and where -->
        <fieldset class="service">
          <legend>What do you need?</legend>
          <div class="options">
            <label class="opt opt--contract">
              <input type="radio" name="service" value="contract" />
              <span class="opt-name">Contract workers</span>
              <span class="opt-meta">For a set time, on site within hours</span>
            </label>
            <label class="opt opt--direct">
              <input type="radio" name="service" value="direct" />
              <span class="opt-name">A permanent hire</span>
              <span class="opt-meta">A targeted search with a 90-day guarantee</span>
            </label>
            <label class="opt opt--unsure">
              <input type="radio" name="service" value="unsure" />
              <span class="opt-name">Not sure yet</span>
              <span class="opt-meta">Three quick questions will help</span>
            </label>
          </div>

          <!-- Shown only for "Not sure yet" -->
          <div class="helper" hidden>
            <div class="q" data-q="length">
              <p class="q-label" id="q1">How long do you need them?</p>
              <div class="seg" role="group" aria-labelledby="q1">
                <button type="button" data-v="temp" aria-pressed="false">Days to months</button>
                <button type="button" data-v="perm" aria-pressed="false">Permanently</button>
              </div>
            </div>
            <div class="q" data-q="start">
              <p class="q-label" id="q2">When do they need to start?</p>
              <div class="seg" role="group" aria-labelledby="q2">
                <button type="button" data-v="now" aria-pressed="false">This week</button>
                <button type="button" data-v="later" aria-pressed="false">In a few weeks or more</button>
              </div>
            </div>
            <div class="q" data-q="trial">
              <p class="q-label" id="q3">Would you like to see them on the job first?</p>
              <div class="seg" role="group" aria-labelledby="q3">
                <button type="button" data-v="yes" aria-pressed="false">Yes</button>
                <button type="button" data-v="no" aria-pressed="false">No</button>
              </div>
            </div>
            <p class="result" aria-live="polite" hidden></p>
          </div>
        </fieldset>

        <div class="fields">
          <!-- Each field: label, optional hint, the control, then its error (linked with aria-describedby) -->
          <div class="field field--wide">
            <label for="f-role">What are you hiring for?</label>
            <span class="hint" id="h-role">The role, how many people, and when you need them to start</span>
            <textarea id="f-role" name="role" rows="3" required aria-describedby="h-role e-role"></textarea>
            <span class="err" id="e-role" hidden>Tell us the role, even roughly.</span>
          </div>
          <div class="field field--wide">
            <label for="f-location">Where's the work?</label>
            <select id="f-location" name="location" required aria-describedby="e-location">
              <option value="" selected disabled>Choose a province</option>
              {locations.map((l) => <option>{l}</option>)}
            </select>
            <span class="err" id="e-location" hidden>Choose where the work is.</span>
          </div>

          <!-- 2. Then the person -->
          <div class="field">
            <label for="f-name">Your name</label>
            <input id="f-name" name="name" autocomplete="name" required aria-describedby="e-name" />
            <span class="err" id="e-name" hidden>Enter your name.</span>
          </div>
          <div class="field">
            <label for="f-email">Work email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="e-email" />
            <span class="err" id="e-email" hidden data-empty="Enter an email address we can reply to." data-bad="Enter an email address like name@company.ca.">Enter an email address we can reply to.</span>
          </div>
          <div class="field"><label for="f-company">Company <span class="opt-tag">(optional)</span></label><input id="f-company" name="company" autocomplete="organization" /></div>
          <div class="field"><label for="f-phone">Phone <span class="opt-tag">(optional)</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>

        <!-- Hidden from people; bots fill it in, and the function ignores anything that does -->
        <label class="hp" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off" /></label>

        <p class="to-line" aria-live="polite"></p>
        <div class="submit">
          <button type="submit">Send request</button>
          <p>We use your details only to respond to this request. <a href={url('/privacy/')}>Privacy</a></p>
        </div>
        <p class="send-err" hidden role="alert">That didn’t send. Please try again, or call us at <a href={tel}>{brand.mainPhone}</a>.</p>
        <div class="sent" hidden tabindex="-1">
          <p class="sent-title">Request sent.</p>
          <p class="sent-who"></p>
          <p class="sent-note">Sandbox preview: nothing was actually sent.</p>
        </div>
      </form>

      <!-- Who will reply: updates with the service and province chosen -->
      <div class="reply" aria-live="polite">
        <p class="r-label">Who'll reply</p>
        <div class="r-card">
          <span class="r-face"><img alt="" hidden /><span class="r-ini"></span></span>
          <div>
            <p class="r-name">The office nearest the work</p>
            <p class="r-role">Choose where the work is to see who it goes to.</p>
          </div>
        </div>
        <p class="r-reach"><a class="r-tel" href={tel}>{brand.mainPhone}</a><a class="r-mail" hidden></a></p>
        <p class="r-note" hidden></p>
        <p class="r-promise">Replies within one business day.</p>
      </div>
    </div>
  </section>

  <section class="section section--tint after">
    <div class="wrap">
      <div class="section-head"><h2>What happens after you send it</h2></div>
      <Steps steps={afterSteps} />
    </div>
  </section>
</Base>

<script>
  import { route, provinceName } from '../../assistant/supabase/functions/_shared/routing.js';

  const form = document.getElementById('request') as HTMLFormElement;
  const radios = [...form.querySelectorAll<HTMLInputElement>('input[name="service"]')];
  const loc = form.querySelector<HTMLSelectElement>('[name="location"]')!;
  const helper = form.querySelector<HTMLElement>('.helper')!;
  const select = (v: string) => radios.forEach((r) => (r.checked = r.value === v));
  const service = () => radios.find((r) => r.checked)?.value || 'unsure';

  // ---- Pre-fill from links (the chatbot, the service pages, office pages) ----
  const params = new URLSearchParams(location.search);
  const fromUrl = params.get('service');
  if (fromUrl === 'contract' || fromUrl === 'direct') select(fromUrl);
  if (params.get('details')) form.querySelector<HTMLTextAreaElement>('[name="role"]')!.value = params.get('details')!;
  const where = params.get('where');
  if (where && [...loc.options].some((o) => o.text === where)) loc.value = where;

  // ---- Who'll reply ----
  const CODES: Record<string, string> = { 'Nova Scotia': 'NS', 'New Brunswick': 'NB', 'Prince Edward Island': 'PE', 'Newfoundland and Labrador': 'NL' };
  const card = document.querySelector('.reply')!;
  const $ = (s: string) => card.querySelector(s) as HTMLElement;
  const toLine = form.querySelector<HTMLElement>('.to-line')!;
  let replier = 'A recruiter';

  function updateReply() {
    const choice = loc.value;
    const svc = service();
    const outside = choice === 'Elsewhere in Canada';
    const place = outside ? { outside: true, province: '', city: '' } : CODES[choice] ? { province: CODES[choice], city: '', outside: false } : null;
    if (!place && svc !== 'direct') {
      $('.r-name').textContent = 'The office nearest the work';
      $('.r-role').textContent = 'Choose where the work is to see who it goes to.';
      $('.r-ini').textContent = 'ISL'; (card.querySelector('.r-face img') as HTMLImageElement).hidden = true;
      $('.r-mail').hidden = true; $('.r-note').hidden = true;
      toLine.textContent = ''; replier = 'A recruiter';
      return;
    }
    // Contract can't be staffed outside Atlantic Canada: that request goes to a permanent search
    const asked = outside && svc !== 'direct' ? 'direct' : svc;
    const r = route({ audience: 'employer', service: asked === 'direct' ? 'direct' : asked === 'unsure' ? 'unsure' : 'contract', place });
    const p = r.person;
    const name = p?.name || `Our ${r.office.city} office`;
    $('.r-name').textContent = name;
    $('.r-role').textContent = p?.handles || r.office.address;
    $('.r-ini').textContent = name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2);
    const img = card.querySelector('.r-face img') as HTMLImageElement;
    img.hidden = true; // shown only once the photo has loaded, so a missing one leaves the initials
    if (p?.photo) { img.onload = () => (img.hidden = false); img.onerror = () => (img.hidden = true); img.src = p.photo; }
    const phone = p?.phone || r.office.phone;
    const telA = $('.r-tel') as HTMLAnchorElement; telA.textContent = phone; telA.href = 'tel:+1' + phone.replace(/\D/g, '');
    const mail = $('.r-mail') as HTMLAnchorElement;
    if (p?.email) { mail.textContent = p.email; mail.href = 'mailto:' + p.email; mail.hidden = false; } else mail.hidden = true;
    const note = $('.r-note');
    note.hidden = !(outside && svc !== 'direct');
    note.textContent = 'Contract staffing is in Atlantic Canada only, so this goes to our permanent search team.';
    replier = p?.first || `Our ${r.office.city} office`;
    toLine.textContent = `This goes to ${p ? p.name : `our ${r.office.city} office`}, who'll reply within one business day.`;
  }

  // ---- "Not sure yet": three questions that choose for them ----
  const answers: Record<string, string> = {};
  const result = helper.querySelector<HTMLElement>('.result')!;
  function recommend() {
    const { length, start, trial } = answers;
    if (!length || !start || !trial) return;
    let svc: string, text: string;
    if (length === 'temp') { svc = 'contract'; text = 'Contract workers fit a set stretch of work.'; }
    else if (trial === 'yes') { svc = 'contract'; text = 'Start on contract, then hire them when you’re sure.'; }
    else { svc = 'direct'; text = start === 'now' ? 'A permanent search. If the seat can’t wait, a contract worker can cover it meanwhile.' : 'A permanent search, with a 90-day guarantee.'; }
    result.textContent = `${text} We’ve selected it above.`;
    result.hidden = false;
    helperChose = true;
    select(svc);
    const chosen = form.querySelector(`input[value="${svc}"]`)?.closest('.opt');
    if (chosen) { chosen.classList.remove('flash'); void (chosen as HTMLElement).offsetWidth; chosen.classList.add('flash'); }
    updateReply();
  }
  helper.querySelectorAll('.q').forEach((q) => {
    const buttons = q.querySelectorAll('button');
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      answers[(q as HTMLElement).dataset.q!] = b.dataset.v!;
      recommend();
    }));
  });
  // The questions show for "Not sure yet", and stay open once they've picked a service for the visitor
  let helperChose = false;
  radios.forEach((r) => r.addEventListener('change', () => {
    if (service() === 'unsure') helper.hidden = false;
    else if (!helperChose) helper.hidden = true;
    updateReply();
  }));
  loc.addEventListener('change', updateReply);
  updateReply();

  // ---- Validation: say what's missing, right under the field ----
  const required = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[required]')];
  const errFor = (f: Element) => f.closest('.field')?.querySelector<HTMLElement>('.err');
  required.forEach((f) => f.addEventListener('input', () => { if (f.checkValidity()) { f.removeAttribute('aria-invalid'); const e = errFor(f); if (e) e.hidden = true; } }));
  const endpoint = form.dataset.endpoint;
  const errBox = form.querySelector<HTMLElement>('.send-err')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const bad = required.filter((f) => !f.checkValidity());
    required.forEach((f) => { const ok = !bad.includes(f); if (ok) f.removeAttribute('aria-invalid'); else f.setAttribute('aria-invalid', 'true'); const e = errFor(f); if (!e) return; e.hidden = ok;
      // An email that's there but mistyped gets its own message, not "enter an email"
      if (e.dataset.bad) e.textContent = (f as HTMLInputElement).value.trim() ? e.dataset.bad : e.dataset.empty!; });
    if (bad.length) { bad[0].focus(); return; }
    errBox.hidden = true;
    if (endpoint) {
      // Send it for real: the function emails the recruiter the card names
      button.disabled = true; button.textContent = 'Sending…';
      try {
        const data = Object.fromEntries(new FormData(form).entries());
        const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...data, page: location.pathname }) });
        if (!res.ok) throw new Error(String(res.status));
      } catch {
        button.disabled = false; button.textContent = 'Send request';
        errBox.hidden = false;
        return;
      }
      form.querySelector<HTMLElement>('.sent-note')!.hidden = true;
    }
    document.dispatchEvent(new CustomEvent('isl:track', { detail: { name: 'generate_lead', params: { service: service() } } }));
    form.querySelector<HTMLElement>('.submit')!.hidden = true;
    toLine.hidden = true;
    const sent = form.querySelector<HTMLElement>('.sent')!;
    form.querySelector('.sent-who')!.textContent = `${replier} will reply within one business day.`;
    sent.hidden = false;
    sent.focus();
  });
</script>

<style>
  .work { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }

  /* Form */
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend, .field { font-weight: var(--fw-text); font-size: var(--fs-small); }
  legend { margin-bottom: var(--s3); }
  .options { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s2); }
  .opt {
    position: relative; display: grid; gap: 2px; align-content: start; cursor: pointer;
    padding: var(--s4); padding-top: calc(var(--s4) + 6px);
    border: 1.5px solid var(--line); border-radius: var(--radius);
    transition: border-color 150ms var(--ease), background-color 150ms var(--ease);
  }
  .opt::before { content: ''; position: absolute; left: -1.5px; right: -1.5px; top: -1.5px; height: 6px; }
  .opt--contract::before { background: var(--contract); }
  .opt--direct::before { background: var(--direct); }
  .opt--unsure::before { background: var(--line); }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt-name { font-weight: var(--fw-bold); font-size: var(--fs-body); }
  .opt-meta { font-weight: var(--fw-text); color: var(--ink-soft); font-size: var(--fs-small); line-height: 1.4; }
  .opt:hover { border-color: var(--ink-soft); }
  .opt:has(input:checked) { border-color: var(--ink); background: var(--mist); }
  .opt--direct:has(input:checked) { border-color: var(--direct); background: var(--isl-blue-tint); }
  .opt:has(input:focus-visible) { outline: 2px solid var(--isl-blue); outline-offset: 2px; }
  .opt.flash { animation: flash 1.2s var(--ease); }
  @keyframes flash { 0% { box-shadow: 0 0 0 0 rgb(0 112 202 / 0.45); } 100% { box-shadow: 0 0 0 14px rgb(0 112 202 / 0); } }

  .helper { margin-top: var(--s3); padding: var(--s4) var(--s5) var(--s5); background: var(--mist); display: grid; gap: var(--s4); }
  .helper[hidden] { display: none; }
  .helper:not([hidden]) { animation: rise 0.35s var(--ease); }
  @keyframes rise { from { opacity: 0; transform: translateY(-6px); } }
  .q-label { font-weight: var(--fw-text); font-size: var(--fs-small); margin-bottom: var(--s2); }
  .seg { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2); }
  .seg button { font: inherit; font-size: var(--fs-small); font-weight: var(--fw-bold); cursor: pointer; padding: 0.6rem 0.5rem; border: 1.5px solid var(--line); background: var(--paper); color: var(--ink); }
  .seg button:hover { border-color: var(--ink); }
  .seg button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .result { font-weight: var(--fw-bold); margin: 0; }

  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4) var(--s5); margin-top: var(--s6); }
  .field { display: grid; gap: var(--s1); align-content: start; }
  .field--wide { grid-column: 1 / -1; }
  .opt-tag { font-weight: var(--fw-text); color: var(--ink-soft); }
  .hint { font-weight: var(--fw-text); color: var(--ink-soft); }
  input:not([type='radio']), select, textarea {
    font: inherit; font-size: var(--fs-body); font-weight: var(--fw-text); color: var(--ink);
    padding: 0.75rem 0.85rem; border: 1.5px solid var(--line); background: var(--paper); width: 100%;
  }
  select:invalid { color: var(--ink-soft); }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px var(--focus); }
  [aria-invalid] { border-color: #b3261e !important; }
  .err { color: #b3261e; font-weight: var(--fw-bold); font-size: var(--fs-small); }

  .to-line { display: none; margin: var(--s5) 0 0; font-size: var(--fs-small); font-weight: var(--fw-text); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .send-err { margin-top: var(--s3); color: #b42318; font-weight: var(--fw-bold); }
  .submit { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3) var(--s5); margin-top: var(--s6); }
  .submit button { font: inherit; font-weight: var(--fw-bold); font-size: var(--fs-body); cursor: pointer; padding: 1rem 1.8rem; border: 0; background: var(--isl-blue); color: #fff; }
  .submit button:hover { background: var(--isl-blue-deep); }
  .submit p { font-size: var(--fs-small); color: var(--ink-soft); margin: 0; }
  .sent { margin-top: var(--s6); padding-top: var(--s4); border-top: 3px solid var(--isl-blue); }
  .sent-title { font-weight: var(--fw-bold); font-size: var(--fs-h3); margin-bottom: var(--s2); }
  .sent-note { color: var(--ink-soft); font-size: var(--fs-small); }

  /* Who'll reply */
  .reply { position: sticky; top: 100px; padding-top: var(--s4); border-top: 3px solid var(--ink); display: grid; gap: var(--s4); }
  .r-label { margin: 0; font-size: var(--fs-small); font-weight: var(--fw-bold); color: var(--ink-soft); }
  .r-card { display: flex; gap: var(--s4); align-items: center; }
  .r-face { position: relative; width: 72px; height: 72px; flex: none; display: grid; place-items: center; overflow: hidden; background: var(--mist); color: var(--ink-soft); font-weight: var(--fw-light); font-size: var(--fs-h3); }
  .r-face img[hidden] { display: none; }
  .r-face img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .r-name { margin: 0; font-weight: var(--fw-bold); font-size: var(--fs-h3); letter-spacing: -0.01em; }
  .r-role { margin: 2px 0 0; color: var(--ink-soft); font-size: var(--fs-small); }
  .r-reach { display: grid; gap: 2px; margin: 0; font-weight: var(--fw-bold); }
  .r-reach a { color: var(--ink); text-decoration: none; width: fit-content; }
  .r-reach a:hover { text-decoration: underline; }
  .r-note { margin: 0; font-size: var(--fs-small); color: var(--ink-soft); }
  .r-promise { margin: 0; padding-top: var(--s3); border-top: 1px solid var(--line); font-size: var(--fs-small); color: var(--ink-soft); }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .reply { display: none; }        /* on phones, one line above the button says who it goes to */
    .to-line { display: block; }
  }
  @media (max-width: 620px) { .options, .fields { grid-template-columns: 1fr; } }
</style>

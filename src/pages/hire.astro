---
// EMPLOYER REQUEST  →  /hire/
// Left: the request form. Right: three questions that recommend a service and preselect it in the form.
// The form is visual only in the sandbox: nothing is sent.
// Linking with ?service=contract or ?service=direct preselects that service.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Steps from '../components/Steps.astro';
import HeroFigure from '../components/HeroFigure.astro';
import { brand } from '../data/site.js';

const sectors = ['Construction and trades', 'Warehousing and logistics', 'Manufacturing', 'Energy and natural resources',
  'Hospitality and customer service', 'Office and administrative', 'Finance and accounting', 'Engineering and technical',
  'Technology and IT', 'Healthcare', 'Other'];
const locations = ['Nova Scotia', 'New Brunswick', 'Prince Edward Island', 'Newfoundland and Labrador', 'Elsewhere in Canada'];
const tel = `tel:+1${brand.mainPhone.replaceAll('-', '')}`;
// From the live /hire page: the four steps from request to filled position.
const afterSteps = [
  ['A recruiter replies', 'To confirm the role, timing and rate.'],
  ['We search our network', 'Recruiters screen candidates against your requirements.'],
  ['You meet the candidates', 'A shortlist, ready to interview or start.'],
  ['Your position is filled', 'We handle the paperwork and follow up after placement.'],
];
---
<Base assistant={false} title="Request talent" description="Request contract workers or start a permanent search. A recruiter replies within one business day.">
  <PageHero title="Tell us who you need." lead="Contract workers or a permanent hire, anywhere we work.">
    <Fragment slot="aside">
      <HeroFigure figure="1" label="business day for a recruiter to reply">
        <p class="hf-extra">Prefer to talk? <a href={tel}>{brand.mainPhone}</a></p>
      </HeroFigure>
    </Fragment>
  </PageHero>

  <section class="section section--rule work">
    <div class="wrap layout">
      <form class="form" id="request" novalidate>
        <fieldset class="service">
          <legend>What do you need?</legend>
          <div class="options">
            <label class="opt opt--contract">
              <input type="radio" name="service" value="contract" />
              <span class="opt-name">Contract workers</span>
              <span class="opt-meta">Short or long term, on site within hours</span>
            </label>
            <label class="opt opt--direct">
              <input type="radio" name="service" value="direct" />
              <span class="opt-name">A permanent hire</span>
              <span class="opt-meta">A targeted search with a 90-day guarantee</span>
            </label>
            <label class="opt opt--unsure">
              <input type="radio" name="service" value="unsure" checked />
              <span class="opt-name">Not sure yet</span>
              <span class="opt-meta">We'll recommend the right fit</span>
            </label>
          </div>
        </fieldset>

        <div class="fields">
          <label class="field">Your name <input name="name" autocomplete="name" required /></label>
          <label class="field">Work email <input name="email" type="email" autocomplete="email" required /></label>
          <label class="field">Company <input name="company" autocomplete="organization" /></label>
          <label class="field"><span>Phone <span class="opt-tag">(optional)</span></span> <input name="phone" type="tel" autocomplete="tel" /></label>
          <label class="field">Industry
            <select name="sector">{sectors.map((s) => <option>{s}</option>)}</select>
          </label>
          <label class="field">Where's the work?
            <select name="location">{locations.map((l) => <option>{l}</option>)}</select>
          </label>
          <label class="field field--wide">What are you hiring for?
            <textarea name="role" rows="4" placeholder="The role, how many people, and when you need them to start"></textarea>
          </label>
        </div>

        <div class="submit">
          <button type="submit">Send request</button>
          <p>We use your details only to respond to this request.</p>
        </div>
        <div class="sent" hidden tabindex="-1">
          <p class="sent-title">Request sent.</p>
          <p>A recruiter will reply within one business day. (Sandbox preview: nothing was actually sent.)</p>
        </div>
      </form>

      <aside class="picker" aria-labelledby="picker-title">
        <h2 id="picker-title">Not sure which service fits?</h2>
        <p class="picker-intro">Answer three questions and we'll choose for you.</p>
        <div class="progress" aria-hidden="true"><span></span><span></span><span></span></div>

        <div class="q" data-q="length">
          <p class="q-label">How long do you need them?</p>
          <div class="seg" role="group" aria-label="How long do you need them?">
            <button type="button" data-v="temp" aria-pressed="false">Days to months</button>
            <button type="button" data-v="perm" aria-pressed="false">Permanently</button>
          </div>
        </div>
        <div class="q" data-q="start">
          <p class="q-label">When do they need to start?</p>
          <div class="seg" role="group" aria-label="When do they need to start?">
            <button type="button" data-v="now" aria-pressed="false">This week</button>
            <button type="button" data-v="later" aria-pressed="false">In a few weeks or more</button>
          </div>
        </div>
        <div class="q" data-q="trial">
          <p class="q-label">Would you like to see them on the job first?</p>
          <div class="seg" role="group" aria-label="Would you like to see them on the job first?">
            <button type="button" data-v="yes" aria-pressed="false">Yes</button>
            <button type="button" data-v="no" aria-pressed="false">No</button>
          </div>
        </div>

        <div class="result" aria-live="polite" hidden>
          <p class="result-name"></p>
          <p class="result-why"></p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tint after">
    <div class="wrap">
      <div class="section-head"><h2>What happens after you send it</h2></div>
      <Steps steps={afterSteps} />
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById('request');
  const radios = form.querySelectorAll('input[name="service"]');
  const select = (v) => radios.forEach((r) => (r.checked = r.value === v));

  // ?service=contract|direct from links elsewhere on the site
  const fromUrl = new URLSearchParams(location.search).get('service');
  if (fromUrl === 'contract' || fromUrl === 'direct') select(fromUrl);

  // Recommendation logic for the three questions
  const answers = {};
  const result = document.querySelector('.result');
  const nameEl = result.querySelector('.result-name');
  const whyEl = result.querySelector('.result-why');

  function recommend() {
    const { length, start, trial } = answers;
    if (!length || !start || !trial) return;
    let svc, name, why;
    if (length === 'temp') {
      svc = 'contract'; name = 'Contract workers';
      why = 'A fixed stretch of work is what contract staffing is built for: one hourly rate, and we handle payroll and workers’ compensation.';
    } else if (trial === 'yes') {
      svc = 'contract'; name = 'Contract, with the option to hire';
      why = 'Start them on contract, see them on the job, then bring them onto your team when you’re sure.';
    } else {
      svc = 'direct'; name = 'A permanent hire';
      why = start === 'now'
        ? 'A permanent search averages 47 days. If the seat can’t wait, we can cover it with a contract worker while we search.'
        : 'A targeted search for the right long-term fit, backed by a 90-day replacement guarantee.';
    }
    select(svc);
    // Briefly highlight the option we just chose in the form, so the link between the two is visible
    const chosen = form.querySelector(`input[value="${svc}"]`)?.closest('.opt');
    if (chosen) { chosen.classList.remove('flash'); void chosen.offsetWidth; chosen.classList.add('flash'); }
    result.dataset.svc = svc;
    nameEl.textContent = name;
    whyEl.textContent = why + ' We’ve selected it in the form.';
    result.hidden = false;
  }

  document.querySelectorAll('.q').forEach((q) => {
    const buttons = q.querySelectorAll('button');
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      answers[q.dataset.q] = b.dataset.v;
      // Fill one segment of the progress bar per answered question
      const done = Object.keys(answers).length;
      document.querySelectorAll('.progress span').forEach((s, i) => s.classList.toggle('on', i < done));
      recommend();
    }));
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }
    form.querySelector('.submit').hidden = true;
    const sent = form.querySelector('.sent');
    sent.hidden = false;
    sent.focus();
  });
</script>

<style>

  .layout { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4.5fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }

  /* Form */
  .form { }
  fieldset { border: 0; margin: 0; padding: 0; }
  legend, .field { font-weight: 500; font-size: var(--fs-small); }
  legend { margin-bottom: var(--s3); }
  .options { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s2); }
  .opt {
    position: relative; display: grid; gap: 2px; cursor: pointer;
    padding: var(--s4); padding-top: calc(var(--s4) + 6px);
    border: 1.5px solid var(--line); border-radius: var(--radius);
    transition: border-color 150ms var(--ease), background-color 150ms var(--ease);
  }
  .opt::before { content: ''; position: absolute; left: -1.5px; right: -1.5px; top: -1.5px; height: 6px; border-radius: var(--radius) var(--radius) 0 0; }
  .opt--contract::before { background: var(--contract); }
  .opt--direct::before { background: var(--direct); }
  .opt--unsure::before { background: var(--line); }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt-name { font-weight: 700; font-size: 1.02rem; }
  .opt-meta { font-weight: 400; color: var(--ink-soft); font-size: var(--fs-small); line-height: 1.4; }
  .opt:hover { border-color: var(--ink-soft); }
  .opt:has(input:checked) { border-color: var(--ink); background: var(--mist); }
  .opt:has(input:focus-visible) { outline: 2px solid var(--isl-blue); outline-offset: 2px; }

  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s4) var(--s5); margin-top: var(--s6); }
  .field { display: grid; gap: var(--s1); }
  .field--wide { grid-column: 1 / -1; }
  .opt-tag { font-weight: 400; color: var(--ink-soft); }
  input:not([type='radio']), select, textarea {
    font: inherit; font-size: 1rem; font-weight: 400; color: var(--ink);
    padding: 0.75rem 0.85rem; border: 1.5px solid var(--line); border-radius: var(--radius); background: var(--paper); width: 100%;
  }
  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px var(--focus); }
  .submit { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s5); margin-top: var(--s6); }
  .submit button {
    font: inherit; font-weight: 600; font-size: 1.0625rem; cursor: pointer;
    padding: 1rem 1.8rem; border: 0; border-radius: var(--radius); background: var(--isl-blue); color: #fff;
  }
  .submit button:hover { background: var(--isl-blue-deep); }
  .submit p { font-size: var(--fs-small); color: var(--ink-soft); }
  .sent { margin-top: var(--s6); padding-top: var(--s4); border-top: 3px solid var(--isl-blue); }
  .sent-title { font-weight: 700; font-size: 1.3rem; }

  /* Picker: same hairline structure as the rest of the site, opened by a heavy rule */
  .picker { border-top: 3px solid var(--ink); padding-top: var(--s5); position: sticky; top: 100px; }
  .picker h2 { font-size: 1.6rem; }
  .picker-intro { color: var(--ink-soft); font-size: var(--fs-small); margin-top: var(--s3); }
  .q { margin-top: var(--s5); padding-top: var(--s4); border-top: 1px solid var(--line); }
  .q-label { font-weight: 500; font-size: var(--fs-small); margin-bottom: var(--s2); }
  .seg { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s2); }
  .seg button {
    font: inherit; font-size: var(--fs-small); font-weight: 500; cursor: pointer;
    padding: 0.65rem 0.5rem; border: 1.5px solid var(--line); border-radius: var(--radius); background: var(--paper); color: var(--ink);
  }
  .seg button:hover { border-color: var(--ink); }
  .seg button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .progress { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; margin-top: var(--s4); }
  .progress span { height: 4px; background: var(--line); position: relative; overflow: hidden; }
  .progress span::after { content: ''; position: absolute; inset: 0; background: var(--ink); transform: scaleX(0); transform-origin: left; transition: transform 0.4s var(--ease); }
  .progress span.on::after { transform: none; }
  .result:not([hidden]) { animation: rise 0.5s var(--ease); }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } }
  .opt.flash { animation: flash 1.2s var(--ease); }
  @keyframes flash { 0% { box-shadow: 0 0 0 0 rgb(0 112 202 / 0.45); } 100% { box-shadow: 0 0 0 14px rgb(0 112 202 / 0); } }


  .result { margin-top: var(--s5); padding-top: var(--s4); border-top: 1.5px solid var(--ink); }
  .result-name { font-weight: 700; font-size: 1.45rem; line-height: 1.15; }
  .result[data-svc='direct'] .result-name { color: var(--direct); }
  .result-why { color: var(--ink-soft); font-size: var(--fs-small); margin-top: var(--s2); }

  @media (max-width: 960px) {
    .layout { grid-template-columns: 1fr; }
    .picker { position: static; order: -1; }
  }
  @media (max-width: 620px) {
    .options, .fields { grid-template-columns: 1fr; }
  }

  /* After-send steps */

</style>

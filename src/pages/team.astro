---
// TEAM  →  /team/
// Reads src/data/team.js. Cards link to each person's bio on the live site for now.
import Base from '../layouts/Base.astro';
import { team } from '../data/team.js';

const initials = (n) => n.split(' ').map((x) => x[0]).join('');
const groups = ['Leadership', 'Direct Hire'];
const leaders = team.filter((p) => p.team === 'Leadership');
const others = team.filter((p) => p.team !== 'Leadership');
const filters = [
  { key: '', label: 'Everyone', n: team.length },
  ...groups.map((g) => ({ key: g, label: g === 'Direct Hire' ? 'Direct hire' : g, n: team.filter((p) => p.team === g).length })),
];
---
<Base title="Our team" description="Meet the Integrated Staffing team across Atlantic Canada.">
  <section class="hero">
    <div class="wrap hero-grid">
      <h1>The people behind every placement.</h1>
      <p class="lead">{team.length} recruiters and staff across five offices in Atlantic Canada.</p>
    </div>
  </section>

  <section class="people" data-team>
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter team">
        {filters.map((f, i) => (
          <button type="button" data-key={f.key} aria-pressed={String(i === 0)}>{f.label} <span>{f.n}</span></button>
        ))}
      </div>
      {[leaders, others].map((list, i) => (
        <ul class:list={['grid', i === 0 && 'grid--lead']}>
          {list.map((p) => (
            <li data-group={p.team ?? ''}>
              <a href={`https://www.integratedstaffing.ca/${p.slug}`}>
                <span class="avatar" aria-hidden="true">{initials(p.name)}</span>
                <span class="name">{p.name}</span>
                {p.role && <span class="role">{p.role}</span>}
              </a>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector('[data-team]');
  const buttons = root.querySelectorAll('.filters button');
  const cards = root.querySelectorAll('.grid li');
  const lists = root.querySelectorAll('.grid');
  buttons.forEach((b) => b.addEventListener('click', () => {
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    cards.forEach((c) => (c.hidden = !!b.dataset.key && c.dataset.group !== b.dataset.key));
    lists.forEach((l) => (l.hidden = ![...l.children].some((c) => !c.hidden)));
  }));
</script>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 6rem) var(--s7); }
  .hero-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: var(--s6); align-items: end; }
  .hero h1 { font-size: var(--fs-hero); font-weight: 830; letter-spacing: -0.035em; max-width: 16ch; }

  .people { padding-bottom: var(--s9); }
  .filters { display: flex; flex-wrap: wrap; gap: var(--s2); margin-bottom: var(--s5); }
  .filters button {
    font: inherit; font-size: var(--fs-small); font-weight: 600; cursor: pointer;
    padding: 0.5rem 0.95rem; border-radius: var(--radius-round); background: transparent; color: var(--ink); border: 1.5px solid var(--line);
  }
  .filters button span { color: var(--ink-soft); font-weight: 500; }
  .filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .filters button[aria-pressed='true'] span { color: rgb(255 255 255 / 0.7); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr)); gap: var(--s3); }
  .grid li[hidden], .grid[hidden] { display: none; }
  .grid + .grid { margin-top: var(--s3); }
  /* Leadership gets its own row of larger cards: the people clients most often ask for by name */
  .grid--lead { grid-template-columns: repeat(3, 1fr); }
  a {
    display: grid; align-content: end; gap: 2px; height: 100%; min-height: 12rem; padding: var(--s5);
    background: var(--mist); color: var(--ink); text-decoration: none; border-radius: var(--radius);
    transition: background-color 150ms var(--ease);
  }
  a:hover { background: #dfe8f1; }
  .grid--lead a { background: var(--navy); color: #fff; min-height: 15rem; }
  .grid--lead a:hover { background: var(--navy-raised); }
  .avatar {
    width: 52px; height: 52px; border-radius: var(--radius-round); display: grid; place-items: center; margin-bottom: auto;
    background: var(--paper); color: var(--ink); font-family: var(--font-display); font-stretch: 115%; font-weight: 780;
  }
  .name { margin-top: var(--s6); font-family: var(--font-display); font-stretch: 112%; font-weight: 740; font-size: 1.1rem; }
  .grid--lead .name { font-size: 1.5rem; }
  .role { font-size: var(--fs-small); opacity: 0.75; }

  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; }
    .grid { grid-template-columns: 1fr 1fr; }
    .grid--lead { grid-template-columns: 1fr; }
    a { min-height: 9rem; }
  }
</style>

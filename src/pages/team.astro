---
// TEAM  →  /team/
// Reads src/data/team.js. Cards link to each person's bio on the live site for now.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import HeroFigure from '../components/HeroFigure.astro';
import { offices } from '../data/site.js';
import { team } from '../data/team.js';
import { sized } from '../lib/img.js';

const initials = (n) => n.split(' ').map((x) => x[0]).join('');
const groups = ['Leadership', 'Direct Hire'];
// Leadership first, then everyone else in the order of the data file.
const people = [...team.filter((p) => p.team === 'Leadership'), ...team.filter((p) => p.team !== 'Leadership')];
const filters = [
  { key: '', label: 'Everyone', n: team.length },
  ...groups.map((g) => ({ key: g, label: g === 'Direct Hire' ? 'Direct hire' : g, n: team.filter((p) => p.team === g).length })),
];
---
<Base title="Our team" description="Meet the Integrated Staffing team across Atlantic Canada.">
  <PageHero title="The people behind every placement." lead="Recruiters who know their industries and their towns. Select a person to read their bio.">
    <Fragment slot="aside"><HeroFigure figure={String(team.length)} label={`recruiters and staff across ${offices.length} offices`} /></Fragment>
  </PageHero>

  <section class="section section--rule people" data-team>
    <div class="wrap">
      <div class="filters" role="group" aria-label="Filter team">
        {filters.map((f, i) => (
          <button type="button" data-key={f.key} aria-pressed={String(i === 0)}>{f.label} <span>{f.n}</span></button>
        ))}
      </div>
      <ul class="grid">
        {people.map((p, i) => (
          <li data-group={p.team ?? ''} data-reveal style={`--i:${i % 5}`}>
            <a href={`https://www.integratedstaffing.ca/${p.slug}`}>
              {p.photo
                ? <span class="shot"><img src={sized(p.photo, 500)} srcset={`${sized(p.photo, 500)} 500w, ${sized(p.photo, 750)} 750w`} sizes="(max-width: 760px) 50vw, 240px" alt="" loading="lazy" decoding="async" onerror="this.parentElement.classList.add('none'); this.remove();" /><span class="ini" aria-hidden="true">{initials(p.name)}</span></span>
                : <span class="shot none"><span class="ini" aria-hidden="true">{initials(p.name)}</span></span>}
              <span class="name">{p.name}</span>
              {p.role && <span class="role">{p.role}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector('[data-team]');
  const buttons = root.querySelectorAll('.filters button');
  const cards = root.querySelectorAll('.grid li');
  buttons.forEach((b) => b.addEventListener('click', () => {
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    cards.forEach((c) => (c.hidden = !!b.dataset.key && c.dataset.group !== b.dataset.key));
  }));
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: var(--s2); margin-bottom: var(--s6); }
  .filters button {
    font: inherit; font-size: var(--fs-small); font-weight: 500; cursor: pointer;
    padding: 0.5rem 0.95rem; border-radius: var(--radius); background: transparent; color: var(--ink); border: 1.5px solid var(--line);
  }
  .filters button span { color: var(--ink-soft); }
  .filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .filters button[aria-pressed='true'] span { color: rgb(255 255 255 / 0.7); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: var(--s6) var(--s4); }
  .grid li[hidden] { display: none; }
  a { display: grid; gap: 2px; color: var(--ink); text-decoration: none; }
  a:hover .name { text-decoration: underline; }
  /* Headshot: a fixed 4:5 frame, cropped from the top so faces stay in view */
  .shot { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--mist); margin-bottom: var(--s3); }
  .shot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; transition: transform 0.6s var(--ease); }
  a:hover .shot img { transform: scale(1.04); }
  .shot .ini { position: absolute; inset: 0; display: none; place-items: center; font-size: 2rem; font-weight: 300; letter-spacing: -0.03em; color: var(--ink-soft); }
  .shot.none .ini { display: grid; }
  .name { font-weight: 700; font-size: 1.05rem; }
  .role { font-size: var(--fs-small); color: var(--ink-soft); }

  @media (max-width: 760px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>

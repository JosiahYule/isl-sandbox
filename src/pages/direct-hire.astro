---
// DIRECT HIRE (PERMANENT PLACEMENT)  →  /direct-hire/
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import HireClock from '../components/HireClock.astro';
import IndustryMatrix from '../components/IndustryMatrix.astro';
import CanadaMap from '../components/CanadaMap.astro';
import CtaBand from '../components/CtaBand.astro';
import { team } from '../data/team.js';
import { stats } from '../data/site.js';
import { sized } from '../lib/img.js';

const recruiters = team.filter((p) => p.team === 'Direct Hire');
const retention = stats.find((s) => s.label.includes('retention'))?.value ?? '92%';
// A real sequence, so it's numbered.
const steps = [
  ['Brief', 'We learn the role, the team and what you need from the hire.'],
  ['Search', 'Recruiters reach out through targeted networks instead of waiting for applicants.'],
  ['Shortlist', 'You meet candidates screened for capability, culture fit and genuine interest.'],
  ['Hire', 'We handle the paperwork through to the start date, then follow up after placement.'],
  ['Guarantee', 'If the hire doesn’t work out within 90 days, we replace them at no extra cost.'],
];
const terms = [
  ['Retainer-based, agreed upfront', 'Clear pricing with no surprise fees or shifting terms.'],
  ['Industry-focused recruiters', 'Each search is led by someone who works in your industry every day.'],
  ['One invoice', 'Based on a percentage of the hire’s annual salary.'],
];
const initials = (n) => n.split(' ').map((x) => x[0]).join('');
const phones = { 'Zowie Tucker': '902-471-0166' };
---
<Base assistant={false} title="Direct hire recruitment" description="Permanent recruitment for hard-to-fill roles anywhere in Canada, with a 90-day replacement guarantee.">
  <PageHero svc="direct" title="Permanent hires, searched coast to coast." lead="Targeted recruitment for hard-to-fill, full-time roles. Our offices are in Atlantic Canada; our searches reach every province.">
    <Button href="/hire/?service=direct" size="lg">Start a search</Button>
    <Fragment slot="aside"><CanadaMap /></Fragment>
  </PageHero>

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head"><h2>How a search runs</h2></div>
      <ol class="items steps">
        {steps.map(([t, d], i) => (
          <li class="item"><span class="num">{i + 1}</span><h3>{t}</h3><p>{d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>{retention} of our placements stay.</h2>
        <p class="lead">The guarantee covers the rest. Here's the timeline, next to contract staffing for comparison.</p>
      </div>
      <HireClock focus="direct" />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>How we work with you</h2></div>
      <ul class="items">
        {terms.map(([t, d]) => <li class="item item--blue"><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head"><h2>Your direct hire recruiters</h2></div>
      <ul class="people">
        {recruiters.map((r) => (
          <li>
            <a href={`https://www.integratedstaffing.ca/${r.slug}`}>
              <span class="shot">{r.photo
                ? <img src={sized(r.photo, 750)} srcset={`${sized(r.photo, 500)} 500w, ${sized(r.photo, 750)} 750w`} sizes="(max-width: 900px) 50vw, 25vw" alt="" loading="lazy" decoding="async" onerror="this.remove()" />
                : <span class="ini" aria-hidden="true">{initials(r.name)}</span>}</span>
              <span class="pname">{r.name}</span>
              <span class="prole">{r.role}</span>
              {phones[r.name] && <span class="pphone">{phones[r.name]}</span>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap ind-grid">
      <div class="section-head">
        <h2>Specialties</h2>
        <p class="lead">Twelve industries, from agriculture to executive search.</p>
      </div>
      <IndustryMatrix only="direct" />
    </div>
  </section>

  <CtaBand title="Start your next key hire." text="Tell us about the role. A direct hire recruiter will set up a call within one business day." href="/hire/?service=direct" label="Start a search" />
</Base>

<style>
  .steps { grid-template-columns: repeat(5, 1fr); }
  .steps .item { border-top-color: var(--direct); }
  .steps .item:last-child { border-top-style: dashed; }
  .num { display: block; font-size: 2.6rem; font-weight: 300; letter-spacing: -0.04em; line-height: 1; color: var(--direct); margin-bottom: var(--s3); }
  .item--blue { border-top-color: var(--direct); }

  .people { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s5); }
  .people a { display: grid; gap: 2px; color: var(--ink); text-decoration: none; }
  .people a:hover .pname { text-decoration: underline; }
  .shot { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--mist); margin-bottom: var(--s3); }
  .shot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .ini { position: absolute; inset: 0; display: grid; place-items: center; font-size: 2rem; font-weight: 300; color: var(--ink-soft); }
  .pname { font-weight: 700; font-size: 1.1rem; }
  .prole, .pphone { font-size: var(--fs-small); color: var(--ink-soft); }

  .ind-grid { display: grid; grid-template-columns: 5fr 7fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }

  @media (max-width: 960px) {
    .steps { grid-template-columns: 1fr; }
    .people { grid-template-columns: 1fr 1fr; }
    .ind-grid { grid-template-columns: 1fr; }
  }
</style>

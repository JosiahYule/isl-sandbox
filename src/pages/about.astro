---
// ABOUT  →  /about/
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import PageHero from '../components/PageHero.astro';
import AtlanticMap from '../components/AtlanticMap.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import { photos } from '../data/photos.js';
import { brand, images } from '../data/site.js';

const years = new Date().getFullYear() - brand.since;
const practices = [
  ['Screening built for the role', 'Typing and dexterity tests and company-specific orientations, at no extra cost.'],
  ['Contract: one hourly rate', 'A single, all-inclusive rate per worker.'],
  ['Direct hire: one invoice', 'A percentage of the hire’s annual salary, agreed upfront.'],
  ['Workers’ compensation, handled', 'Payroll remittances, claims, and safe, timely return to work.'],
];
const values = [
  ['Impact', 'A placement should make a measurable difference for the employer and the person hired.'],
  ['Passion', 'We care about the people we place and the businesses that hire them.'],
  ['Honesty', 'Clear terms and straight answers, before and after the hire.'],
  ['Communication', 'Responsive at every stage, including after someone starts.'],
];
const gallery = [
  [photos.chamberAwards, 'At the Chamber Awards'],
  [photos.megZowie, 'Meg and Zowie'],
  [photos.evanFirstYear, "Celebrating Evan's first year"],
  [photos.chamberTrio, 'Erika, Meg and Shelley at the Chamber Awards'],
  [photos.christmasTree, 'Beside the office Christmas tree'],
  [photos.teamMembers, 'Members of the team'],
];
---
<Base title="About" description="Locally owned and operated recruiting and staffing in Atlantic Canada since 2013.">
  <PageHero title="The right fit, for both sides of the hire." lead={`${brand.name} is locally owned and operated. For ${years} years we've matched Atlantic Canadian employers with the people they need, on contract and permanently.`}>
    <Button href="/hire/">I'm hiring</Button>
    <Button href="/find-work/" variant="outline">I'm looking for work</Button>
  </PageHero>

  <div class="wrap">
    <Photo src={photos.teamTogether.src} alt={photos.teamTogether.alt} ratio="21/9" sizes="(max-width: 1280px) 100vw, 1200px" eager />
  </div>

  <section class="section">
    <div class="wrap where-grid">
      <div class="section-head">
        <h2>Five offices across four provinces.</h2>
        <p class="lead">Headquartered in Dartmouth, with teams in New Brunswick, Prince Edward Island, and Newfoundland and Labrador.</p>
      </div>
      <AtlanticMap id="about-map" />
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="section-head"><h2>How we work</h2></div>
      <ul class="items">
        {practices.map(([t, d]) => <li class="item"><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>What we value</h2></div>
      <dl class="values">
        {values.map(([t, d]) => (
          <div class="value"><dt>{t}</dt><dd>{d}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head"><h2>The people behind the placements</h2></div>
      <div class="gallery">
        {gallery.map(([p, caption]) => (
          <Photo src={p.src} alt={p.alt} ratio="4/3" sizes="(max-width: 900px) 50vw, 33vw" caption={caption} />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--rule">
    <div class="wrap">
      <ul class="items recognition">
        <li class="item rec">
          <img src={images.badgeBestPlaces} alt="" width="56" height="56" loading="lazy" onerror="this.remove()" />
          <div><h3>Best Places to Work</h3><p>Named one of the Best Places to Work.</p></div>
        </li>
        <li class="item rec">
          <img src={images.badgeCor} alt="" width="56" height="56" loading="lazy" onerror="this.remove()" />
          <div><h3>COR certified</h3><p>Certificate of Recognition for occupational health and safety.</p></div>
        </li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .where-grid { display: grid; grid-template-columns: 4fr 7fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; }

  .values { margin: 0; border-top: 1.5px solid var(--ink); }
  .value { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: var(--s6); align-items: baseline; padding-block: var(--s5); border-bottom: 1px solid var(--line); }
  dt { font-weight: 300; font-size: clamp(1.9rem, 1rem + 3vw, 3.4rem); letter-spacing: -0.035em; line-height: 1; }
  dd { margin: 0; color: var(--ink-soft); font-size: var(--fs-lead); font-weight: 300; max-width: 40ch; }

  .gallery { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s6) var(--s4); }

  .rec { display: flex; gap: var(--s4); align-items: flex-start; }
  .rec img { width: 56px; height: 56px; object-fit: contain; flex: none; }

  @media (max-width: 900px) {
    .where-grid { grid-template-columns: 1fr; }
    .value { grid-template-columns: 1fr; gap: var(--s2); }
    .gallery { grid-template-columns: 1fr 1fr; }
  }
</style>

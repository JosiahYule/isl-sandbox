---
// HOMEPAGE  →  /
// Built from the shared section system in global.css:
// hero (job search + now hiring strip), situation picker, offices, proof, free tools, call to action.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import AtlanticMap from '../components/AtlanticMap.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import ToolCards from '../components/ToolCards.astro';
import Proof from '../components/Proof.astro';
import WeRecruit from '../components/WeRecruit.astro';
import { photos } from '../data/photos.js';
import { stats, brand, offices, social } from '../data/site.js';
import { jobs } from '../data/jobs.js';
import { url } from '../lib/url.js';

const retention = stats.find((s) => s.label.includes('retention'))?.value ?? '92%';

// Situations employers call about, each answered by the service that fits, with one figure
// that backs the answer. Every claim restates the live site (hours, one rate, temp to perm,
// retention, average search time, national search).
const situations = [
  { svc: 'contract', q: "Someone's on leave next week.", fig: 'Within hours', figLabel: 'from your call to a worker on site', a: 'A pre-screened worker covers the role for as long as the leave lasts.' },
  { svc: 'contract', q: 'Orders just doubled for the season.', fig: 'One rate', figLabel: 'per worker, with payroll and workers\u2019 compensation included', a: 'Add people for the peak and scale back when it settles.' },
  { svc: 'contract', q: "We'd like to see someone work before we hire.", fig: 'Temp to perm', figLabel: 'start on contract, hire when you\u2019re sure', a: 'See them on the job before you make an offer.' },
  { svc: 'direct', q: 'Our controller just gave notice.', fig: retention, figLabel: 'of our permanent placements stay', a: 'A targeted search led by a recruiter in your field, with a 90-day guarantee.' },
  { svc: 'direct', q: 'This role has been posted for months.', fig: '47 days', figLabel: 'on average, from brief to hire', a: 'We go after the people who aren\u2019t answering job ads.' },
  { svc: 'direct', q: "We're hiring outside Atlantic Canada.", fig: 'Every province', figLabel: 'reached by our permanent searches', a: 'Our offices are in Atlantic Canada. Our searches aren\u2019t limited to it.' },
];
const svcName = { contract: 'Contract staffing', direct: 'Direct hire' };
const svcLink = { contract: '/contract/', direct: '/direct-hire/' };
// Structured data: who ISL is and where its offices are (read by search engines)
const orgSchema = {
  '@context': 'https://schema.org', '@type': 'EmploymentAgency', name: brand.name, url: 'https://www.integratedstaffing.ca',
  telephone: '+1-' + brand.mainPhone, email: brand.email, foundingDate: String(brand.since), areaServed: 'Atlantic Canada',
  sameAs: social.map((s) => s.href),
  department: offices.map((o) => ({ '@type': 'EmploymentAgency', name: `${brand.name} ${o.city}`, telephone: '+1-' + o.phone, address: o.address })),
};
// The "Now hiring" strip in the hero: the newest real postings
const ticker = jobs.slice(0, 14);

---
<Base description="Contract and permanent staffing from five offices across Atlantic Canada. Search open jobs, or tell us who you need." schema={orgSchema}>
  <!-- 1. HERO: ISL's own photo across the full width, the promise over it,
       one way in for each audience, and a live strip of real open jobs -->
  <section class="hero">
    <div class="hero-bg" data-animate>
      <Photo src={photos.warehouse.src} alt="" ratio="16/9" sizes="100vw" position="65% center" eager />
    </div>
    <div class="wrap hero-inner">
      <div class="hero-copy" data-stagger>
        <h1 class="hero-title">
          <span class="line">Workers in hours.</span>{" "}
          <span class="line">Hires that stay.</span>
        </h1>
        <p class="hero-lead">Contract and permanent staffing across Atlantic Canada. Locally owned since {brand.since}.</p>
        <form class="search" action={url('/find-work/')} method="get" role="search">
          <label for="hero-q">Looking for work? Search {jobs.length} open jobs</label>
          <div class="search-bar">
            <input id="hero-q" name="q" type="search" placeholder="Job title, skill or city" autocomplete="off" />
            <button type="submit">Search</button>
          </div>
        </form>
        <p class="employer">Hiring? <Button href="/hire/" variant="light">Request talent</Button></p>
      </div>
    </div>

    <div class="ticker" aria-label="Now hiring">
      <p class="ticker-label"><span class="pulse" aria-hidden="true"></span>Now hiring</p>
      <div class="ticker-track">
        {[0, 1].map((copy) => (
          <ul class="ticker-list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {ticker.map((j) => (
              <li><a href={url(`/find-work/?q=${encodeURIComponent(j.title)}`)} tabindex={copy === 1 ? -1 : undefined}><strong>{j.title.replace(/\s*\/\s*/g, ' / ')}</strong><span>{j.city}, {j.province}</span><span>{j.pay}</span></a></li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. WE RECRUIT. The live site's signature line, with three live points: where, what, who -->
  <WeRecruit />

  <!-- 3. SITUATIONS: the employer picks what's happening; one answer panel responds,
       in the colour of the service that fits (near-black contract, ISL blue direct hire) -->
  <section class="section sit-section">
    <div class="wrap">
      <div class="section-head">
        <h2>What's happening at your company?</h2>
      </div>
      <div class="picker" data-sit>
        <div class="sit-list" role="tablist" aria-label="Hiring situations" data-stagger>
          {situations.map((x, i) => (
            <button type="button" role="tab" id={`sit-${i}`} aria-controls="sit-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} class:list={['sit', `sit--${x.svc}`]} data-i={i}>
              <span class="sit-q">{x.q}</span>
            </button>
          ))}
        </div>
        <div class="panel" id="sit-panel" role="tabpanel" aria-labelledby="sit-0" data-svc={situations[0].svc}>
          {situations.map((x, i) => (
            <div class="answer" data-answer={i} hidden={i !== 0}>
              <p class="p-svc">{svcName[x.svc]}</p>
              <p class="p-fig figure">{x.fig}</p>
              <p class="p-fig-label">{x.figLabel}</p>
              <p class="p-a">{x.a}</p>
              <div class="p-actions">
                <Button href={`/hire/?service=${x.svc}`} variant="light">Request talent</Button>
                <a class="p-more" href={url(svcLink[x.svc])}>How {x.svc === 'contract' ? 'contract staffing' : 'direct hire'} works</a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. WHERE WE ARE: the map and the people in those offices -->
  <section class="section section--tint local">
    <div class="wrap">
      <div class="section-head">
        <h2><span class="line">Five offices.</span> <span class="line">All of Atlantic Canada.</span></h2>
        <p class="lead">Each office covers its whole province, so we staff towns well beyond our office cities. Select one for its address and phone number.</p>
      </div>
    </div>
    <div class="wrap local-grid">
      <AtlanticMap id="home-map" />
      <div class="local-photo">
        <Photo src={photos.teamNL.src} alt={photos.teamNL.alt} ratio="4/5" sizes="(max-width: 900px) 100vw, 36vw" caption="Our Newfoundland and Labrador team, December 2025" />
        <a class="more" href={url('/team/')}>Meet the team</a>
      </div>
    </div>
  </section>

  <!-- 4. PROOF: one client quote, with the review count beside it -->
  <Proof />

  <!-- 6. FREE TOOLS: ISL's own guides and tools -->
  <section class="section section--rule tools">
    <div class="wrap">
      <div class="section-head">
        <h2>Free tools from our team</h2>
        <p class="lead">Built by ISL from what our recruiters see across Atlantic Canada.</p>
      </div>
      <ToolCards />
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  // Situation picker: selecting a situation shows its answer and recolours the panel
  // for the service that fits. Arrow keys move between situations (standard tab behaviour).
  const root = document.querySelector('[data-sit]');
  if (root) {
    const tabs = [...root.querySelectorAll('.sit')];
    const panel = root.querySelector('.panel');
    const answers = [...root.querySelectorAll('.answer')];
    const show = (i, focus = false) => {
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === i)); t.tabIndex = k === i ? 0 : -1; });
      answers.forEach((a, k) => (a.hidden = k !== i));
      panel.dataset.svc = tabs[i].classList.contains('sit--direct') ? 'direct' : 'contract';
      panel.setAttribute('aria-labelledby', tabs[i].id);
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      t.addEventListener('keydown', (e) => {
        const step = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
        if (step) { e.preventDefault(); show((i + step + tabs.length) % tabs.length, true); }
      });
    });
  }
</script>

<style>
  /* ---------- 1. Hero ---------- */
  /* The photo fills the hero; a dark wash from the left keeps the white text readable */
  .hero { position: relative; isolation: isolate; color: #fff; background: var(--dark); min-height: min(calc(100svh - 72px), 880px); display: flex; flex-direction: column; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg :global(.photo), .hero-bg :global(.frame) { height: 100%; margin: 0; }
  .hero-bg :global(.frame) { aspect-ratio: auto !important; }
  .hero-bg::after { content: ''; position: absolute; inset: 0;
    background:
      linear-gradient(90deg, rgb(20 20 20 / 0.9) 0%, rgb(20 20 20 / 0.72) 38%, rgb(20 20 20 / 0.2) 75%, rgb(20 20 20 / 0.05) 100%),
      linear-gradient(0deg, rgb(20 20 20 / 0.85) 0%, rgb(20 20 20 / 0) 30%); }
  .hero-inner { flex: 1; display: flex; align-items: center; padding-block: var(--s8) var(--s7); }
  .hero-copy { max-width: 660px; }

  .hero-title { font-size: clamp(2.9rem, 1rem + 5.4vw, 6.2rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1; color: #fff; }
  @media (min-width: 901px) { .line { white-space: nowrap; } }
  .line { display: block; }

  .hero-lead { margin-top: var(--s6); font-size: var(--fs-lead); font-weight: 300; line-height: 1.55; color: rgb(255 255 255 / 0.86); max-width: 38ch; }

  /* Job seekers: the search. Employers: one button. */
  .search { margin-top: var(--s7); max-width: 36rem; }
  .search label { display: block; font-size: var(--fs-small); font-weight: 500; margin-bottom: var(--s2); color: rgb(255 255 255 / 0.86); }
  .search-bar { display: flex; background: #fff; }
  .search-bar input { flex: 1; min-width: 0; font: inherit; font-size: 1.05rem; padding: 1rem 1.15rem; border: 0; background: transparent; color: var(--ink); }
  .search-bar input:focus { outline: 2px solid var(--isl-blue); outline-offset: -2px; }
  .search-bar button { font: inherit; font-weight: 600; cursor: pointer; padding: 0 1.6rem; border: 0; background: var(--isl-blue); color: #fff; }
  .search-bar button:hover { background: var(--isl-blue-deep); }
  .employer { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3) var(--s4); margin-top: var(--s5); font-weight: 500; color: rgb(255 255 255 / 0.86); }
  .employer a[href^='tel'] { color: #fff; font-size: var(--fs-small); }

  /* The photo settles slowly from slightly enlarged */
  :global(.motion) .hero-bg :global(img) { transform: scale(1.08); transition: transform 2.6s var(--ease); }
  :global(.motion) .hero-bg.is-in :global(img) { transform: none; }

  /* Now hiring: real postings scrolling along the bottom edge. Pauses on hover or focus. */
  .ticker { position: relative; display: flex; min-width: 0; max-width: 100%; align-items: stretch; border-top: 1px solid rgb(255 255 255 / 0.16); background: rgb(20 20 20 / 0.55); backdrop-filter: blur(6px); }
  .ticker-label { flex: none; display: flex; align-items: center; gap: var(--s2); margin: 0; padding: 0 var(--s5) 0 var(--gutter); font-size: var(--fs-small); font-weight: 600; background: var(--isl-blue); color: #fff; white-space: nowrap; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #fff; }
  :global(.motion) .pulse { animation: pulse 2s ease-out infinite; }
  @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgb(255 255 255 / 0.7); } 70%, 100% { box-shadow: 0 0 0 8px rgb(255 255 255 / 0); } }
  .ticker-track { display: flex; overflow: hidden; flex: 1; min-width: 0; mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent); }
  .ticker-list { display: flex; flex: none; list-style: none; margin: 0; padding: 0; }
  :global(.motion) .ticker-list { animation: ticker 70s linear infinite; }
  .ticker:hover .ticker-list, .ticker:focus-within .ticker-list { animation-play-state: paused; }
  @keyframes ticker { to { transform: translateX(-100%); } }
  .ticker-list a { display: flex; gap: var(--s3); align-items: baseline; padding: var(--s4) var(--s6) var(--s4) 0; margin-left: var(--s6); color: #fff; text-decoration: none; white-space: nowrap; font-size: var(--fs-small); border-left: 1px solid rgb(255 255 255 / 0.16); padding-left: var(--s6); margin-left: 0; }
  .ticker-list a span { color: rgb(255 255 255 / 0.66); }
  .ticker-list a:hover strong { text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .ticker-track { overflow-x: auto; } }

  @media (max-width: 900px) {
    .hero { min-height: 0; }
    .hero-bg::after { background: linear-gradient(0deg, rgb(20 20 20 / 0.92) 0%, rgb(20 20 20 / 0.7) 55%, rgb(20 20 20 / 0.45) 100%); }
    .hero-inner { padding-block: var(--s8) var(--s7); }
    .search-bar button { padding: 0 1.1rem; }
    .ticker-label { padding-left: var(--s4); padding-right: var(--s4); }
  }

  /* ---------- 2. Situations ---------- */
  .picker { display: grid; grid-template-columns: 5fr 6fr; gap: clamp(1.5rem, 4vw, 4rem); align-items: stretch; }
  .sit-list { display: grid; align-content: start; border-top: 1.5px solid var(--ink); }
  .sit {
    position: relative; display: flex; justify-content: space-between; align-items: baseline; gap: var(--s4);
    width: 100%; padding: var(--s5) var(--s4) var(--s5) var(--s5); text-align: left;
    font: inherit; color: var(--ink-soft); background: none; border: 0; border-bottom: 1px solid var(--line); cursor: pointer;
    transition: color 0.2s, background 0.2s;
  }
  .sit::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--contract); transform: scaleY(0); transition: transform 0.35s var(--ease); }
  .sit--direct::before { background: var(--direct); }
  .sit-q { font-size: clamp(1.1rem, 0.9rem + 0.6vw, 1.4rem); font-weight: 500; letter-spacing: -0.015em; line-height: 1.3; }
  .sit:hover { color: var(--ink); background: var(--mist); }
  .sit[aria-selected='true'] { color: var(--ink); }
  .sit[aria-selected='true']::before { transform: none; }

  /* The answer panel: near-black for contract, ISL blue for direct hire */
  .panel { position: relative; color: #fff; background: var(--dark); padding: clamp(2rem, 4vw, 3.5rem); display: flex; transition: background 0.5s var(--ease); min-height: 26rem; }
  .panel[data-svc='direct'] { background: var(--isl-blue); }
  .answer { display: flex; flex-direction: column; width: 100%; }
  .answer[hidden] { display: none; }
  .answer:not([hidden]) { animation: answer 0.55s var(--ease); }
  @keyframes answer { from { opacity: 0; transform: translateY(14px); } }
  .p-svc { font-size: var(--fs-small); font-weight: 600; color: rgb(255 255 255 / 0.75); margin-bottom: var(--s5); }
  .p-fig { font-size: clamp(3rem, 1.6rem + 4vw, 5.4rem); margin: 0 0 var(--s2); }
  .p-fig-label { color: rgb(255 255 255 / 0.8); max-width: 30ch; }
  .p-a { margin-top: auto; padding-top: var(--s6); font-size: var(--fs-lead); font-weight: 300; line-height: 1.5; max-width: 40ch; }
  .p-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s3) var(--s5); margin-top: var(--s6); }
  .p-more { color: #fff; font-weight: 600; }
  .p-more:hover { color: #fff; }

  @media (max-width: 900px) {
    .picker { grid-template-columns: 1fr; }
    .panel { min-height: 0; }
  }

  /* ---------- 3. Local ---------- */
  .local-grid { display: grid; grid-template-columns: 7fr 4fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .local-photo { display: grid; gap: var(--s4); }
  .more { font-weight: 600; }
  @media (max-width: 900px) { .local-grid { grid-template-columns: 1fr; } }

  /* ---------- 4. Proof: see Proof.astro ---------- */

  /* ---------- 6. Tools: see ToolCards.astro ---------- */
  @media (max-width: 860px) { .jobs-intro { justify-self: start; } }
</style>

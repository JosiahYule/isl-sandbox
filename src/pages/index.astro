---
// HOMEPAGE  →  /
// Six sections, each built from the shared section system in global.css:
// hero, two ways to hire, where we are, proof, open roles, closing call to action.
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import AtlanticMap from '../components/AtlanticMap.astro';
import JobRow from '../components/JobRow.astro';
import CtaBand from '../components/CtaBand.astro';
import Photo from '../components/Photo.astro';
import { photos } from '../data/photos.js';
import { testimonials, stats, brand } from '../data/site.js';
import { jobs } from '../data/jobs.js';
import { url } from '../lib/url.js';

const quote = testimonials[0];
const retention = stats.find((s) => s.label.includes('retention'))?.value ?? '92%';
const reviews = stats.find((s) => s.label.includes('reviews'))?.value ?? '200+';
const latest = jobs.slice(0, 5);
---
<Base>
  <!-- 1. HERO: the promise on the left, ISL's own photo running off the right edge -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">
          <span class="line line--contract">Workers in hours.</span>{" "}
          <span class="line line--direct">Hires that stay.</span>
        </h1>
        <p class="lead">Contract and permanent staffing from five offices across Atlantic Canada, with permanent searches anywhere in the country. Locally owned since {brand.since}.</p>
        <div class="actions">
          <Button href="/hire/" size="lg">Request talent</Button>
          <Button href="/find-work/" variant="outline" size="lg">Find work</Button>
        </div>
      </div>
    </div>
    <div class="hero-photo">
      <Photo src={photos.warehouse.src} alt={photos.warehouse.alt} ratio="4/5" sizes="(max-width: 900px) 100vw, 46vw" position="70% center" eager />
    </div>
  </section>

  <!-- 2. TWO WAYS TO HIRE: each service with the one fact that sells it -->
  <section class="section services">
    <div class="wrap">
      <div class="section-head">
        <h2>Two ways to hire.</h2>
      </div>
      <div class="items items--2">
        <div class="item">
          <p class="svc svc--contract">Contract staffing</p>
          <p class="fact"><span class="figure">Within hours</span>from your request to workers on site</p>
          <h3>Cover a gap, a leave or a busy season.</h3>
          <p>Pre-screened workers for one all-inclusive hourly rate. We handle payroll and workers' compensation.</p>
          <a class="more" href={url('/contract/')}>How contract staffing works</a>
        </div>
        <div class="item item--direct">
          <p class="svc svc--direct">Direct hire</p>
          <p class="fact"><span class="figure">{retention}</span>of our direct hire placements stay</p>
          <h3>Find a permanent hire, anywhere in Canada.</h3>
          <p>A targeted search for hard-to-fill roles. If a hire doesn't work out in the first 90 days, we replace them at no extra cost.</p>
          <a class="more" href={url('/direct-hire/')}>How direct hire works</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. WHERE WE ARE: the map and the people in those offices -->
  <section class="section section--tint local">
    <div class="wrap">
      <div class="section-head">
        <h2>Five offices across Atlantic Canada.</h2>
        <p class="lead">Locally owned and operated. Select an office on the map for its address and phone number.</p>
      </div>
    </div>
    <div class="wrap local-grid">
      <AtlanticMap id="home-map" />
      <div class="local-photo">
        <Photo src={photos.teamNL.src} alt={photos.teamNL.alt} ratio="4/5" sizes="(max-width: 900px) 100vw, 36vw" caption="Our Newfoundland and Labrador team, December 2025" />
        <a class="more" href={url('/team/')}>Meet the team</a>
      </div>
    </div>
  </section>

  <!-- 4. PROOF: one client quote, with the review count beside it -->
  <section class="section proof">
    <div class="wrap proof-grid">
      <figure class="quote">
        <blockquote>{quote.quote}</blockquote>
        <figcaption>{quote.who}</figcaption>
      </figure>
      <p class="reviews"><strong>{reviews}</strong> five-star reviews on Google from clients and candidates.</p>
    </div>
  </section>

  <!-- 5. OPEN ROLES: for job seekers -->
  <section class="section section--rule jobs">
    <div class="wrap">
      <div class="section-head section-head--split">
        <h2>Open roles</h2>
        <p class="jobs-intro">{jobs.length} open now across Atlantic Canada. Not sure what to search for? <button type="button" class="textlink" data-open-assistant>Ask the job assistant</button>.</p>
      </div>
      <div class="job-list">
        {latest.map((job) => <JobRow job={job} />)}
      </div>
      <div class="jobs-foot">
        <Button href="/find-work/" variant="outline">See all {jobs.length} open roles</Button>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* ---------- 1. Hero ---------- */
  .hero { position: relative; }
  .hero-grid { min-height: min(84vh, 820px); display: grid; align-items: center; padding-block: var(--s8) var(--s9); }
  .hero-copy { max-width: 600px; position: relative; z-index: 2; }
  /* One sentence per line on desktop: each line is one service, underlined in that service's colour */
  .hero-title { font-size: clamp(2.6rem, 0.9rem + 4.3vw, 4.9rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1; }
  @media (min-width: 901px) { .line { white-space: nowrap; } }
  .line { display: block; width: fit-content; text-decoration-line: underline; text-decoration-thickness: 0.09em; text-underline-offset: 0.13em; text-decoration-skip-ink: none; }
  .line + .line { margin-top: 0.12em; }
  .line--contract { text-decoration-color: var(--contract); }
  .line--direct { text-decoration-color: var(--direct); }
  .hero .lead { margin-top: var(--s6); max-width: 40ch; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s3); margin-top: var(--s7); }

  /* The one deliberate break in the site's grid: the photo runs off the right edge
     and drops past the hero into the next section. */
  .hero-photo { position: absolute; z-index: 1; top: 0; bottom: -6rem; right: 0; width: min(46vw, 760px); }
  .hero-photo :global(.photo), .hero-photo :global(.frame) { height: 100%; }
  .hero-photo :global(.frame) { aspect-ratio: auto !important; }

  @media (max-width: 1100px) { .hero-copy { max-width: 470px; } .hero-photo { width: 44vw; } }
  @media (max-width: 900px) {
    .hero-grid { min-height: 0; padding-bottom: var(--s6); }
    .hero-copy { max-width: none; }
    .hero-photo { position: static; width: auto; }
    .hero-photo :global(.photo), .hero-photo :global(.frame) { height: auto; }
    .hero-photo :global(.frame) { aspect-ratio: 4 / 3 !important; }
  }

  /* ---------- 2. Services ---------- */
  .services { padding-top: calc(clamp(4rem, 8vw, 6.5rem) + 3rem); }
  @media (min-width: 901px) { .services .section-head { max-width: 52%; } .services .items { grid-template-columns: 1fr 1fr; } }
  .item--direct { border-top-color: var(--direct); }
  .item h3 { font-size: 1.4rem; letter-spacing: -0.02em; margin-top: var(--s2); }
  /* The one number that sells each service, in the brand's light display weight */
  .fact { margin: var(--s2) 0 var(--s5); color: var(--ink-soft); font-size: var(--fs-small); }
  .fact .figure { display: block; font-size: clamp(2.6rem, 1.6rem + 2.6vw, 3.9rem); color: var(--ink); margin-bottom: var(--s2); }
  .item--direct .fact .figure { color: var(--direct); }

  /* ---------- 3. Local ---------- */
  .local-grid { display: grid; grid-template-columns: 7fr 4fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .local-photo { display: grid; gap: var(--s4); }
  .more { font-weight: 600; }
  @media (max-width: 900px) { .local-grid { grid-template-columns: 1fr; } }

  /* ---------- 4. Proof ---------- */
  .proof-grid { display: grid; grid-template-columns: 7fr 4fr; gap: clamp(2rem, 5vw, 5rem); align-items: end; }
  .quote { margin: 0; }
  .quote blockquote { margin: 0; font-size: clamp(1.4rem, 1rem + 1.4vw, 2.1rem); font-weight: 300; line-height: 1.35; letter-spacing: -0.015em; }
  .quote figcaption { margin-top: var(--s5); color: var(--ink-soft); font-weight: 500; }
  .reviews { font-size: var(--fs-small); color: var(--ink-soft); border-top: 1.5px solid var(--ink); padding-top: var(--s4); }
  .reviews strong { display: block; color: var(--isl-blue); font-weight: 300; font-size: clamp(3.4rem, 2rem + 4vw, 5.2rem); letter-spacing: -0.05em; line-height: 0.95; margin-bottom: var(--s2); }
  @media (max-width: 900px) { .proof-grid { grid-template-columns: 1fr; } }

  /* ---------- 5. Jobs ---------- */
  .jobs-intro { color: var(--ink-soft); max-width: 44ch; justify-self: end; }
  .job-list { border-top: 1.5px solid var(--ink); }
  .jobs-foot { margin-top: var(--s6); }
  @media (max-width: 860px) { .jobs-intro { justify-self: start; } }
</style>

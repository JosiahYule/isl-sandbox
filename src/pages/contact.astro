---
// CONTACT  →  /contact/
import Base from '../layouts/Base.astro';
import AtlanticMap from '../components/AtlanticMap.astro';
import { brand, offices } from '../data/site.js';
import { url } from '../lib/url.js';

const tel = (n) => `tel:+1${n.replaceAll('-', '')}`;
const routes = [
  { t: "I'm hiring", d: 'Contract workers or a permanent hire. A recruiter replies within one business day.', href: url('/hire/'), cta: 'Request talent', kind: 'primary' },
  { t: "I'm looking for work", d: 'Browse open roles, or send your resume to be matched as roles open.', href: url('/find-work/'), cta: 'Browse jobs' },
  { t: 'I know a company that’s hiring', d: 'Refer them to our team and we’ll take it from there.', href: 'https://www.integratedstaffing.ca/referrals', cta: 'Make a referral' },
];
---
<Base title="Contact" description="Contact Integrated Staffing in Halifax, Moncton, Saint John, Charlottetown and St. John's.">
  <section class="hero">
    <div class="wrap">
      <h1>Talk to the office nearest you.</h1>
      <p class="lead">Or start with what you need, and we'll route you to the right recruiter. General inquiries: <a href={`mailto:${brand.email}`}>{brand.email}</a></p>
    </div>
  </section>

  <section class="routes">
    <div class="wrap route-grid">
      {routes.map((r) => (
        <a class:list={['route', r.kind === 'primary' && 'route--primary']} href={r.href}>
          <h2>{r.t}</h2>
          <p>{r.d}</p>
          <span class="go">{r.cta}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="offices">
    <div class="wrap off-grid">
      <AtlanticMap id="contact-map" />
      <div>
        <h2>Our offices</h2>
        <table>
          <caption class="visually-hidden">Office addresses and phone numbers</caption>
          <tbody>
            {offices.map((o, i) => (
              <tr>
                <th scope="row">{o.city}, {o.province}{i === 0 && <span>Head office</span>}</th>
                <td>{o.address}</td>
                <td><a href={tel(o.phone)}>{o.phone}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(3rem, 7vw, 6rem) var(--s6); }
  .hero h1 { font-size: var(--fs-hero); font-weight: 830; letter-spacing: -0.035em; max-width: 12ch; }
  .hero .lead { margin-top: var(--s5); }

  .routes { padding-bottom: var(--s8); }
  .route-grid { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: var(--s3); }
  .route {
    display: flex; flex-direction: column; min-height: 15rem; padding: var(--s6) var(--s5);
    background: var(--mist); color: var(--ink); text-decoration: none; border-radius: var(--radius);
    transition: background-color 150ms var(--ease);
  }
  .route:hover { background: #dfe8f1; }
  .route--primary { background: var(--navy); color: #fff; }
  .route--primary:hover { background: var(--navy-raised); }
  .route h2 { font-size: clamp(1.4rem, 1.1rem + 0.9vw, 1.9rem); margin-bottom: var(--s3); }
  .route p { opacity: 0.8; font-size: var(--fs-small); flex: 1; }
  .go { margin-top: var(--s5); font-weight: 650; text-decoration: underline; text-underline-offset: 0.2em; }

  .offices { padding-block: var(--s8) var(--s9); border-top: 1px solid var(--line); }
  .off-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .offices h2 { margin-bottom: var(--s5); }
  table { width: 100%; border-collapse: collapse; border-top: 1.5px solid var(--ink); }
  th, td { text-align: left; vertical-align: top; padding: var(--s4) var(--s3) var(--s4) 0; border-bottom: 1px solid var(--line); font-size: var(--fs-small); }
  th { font-family: var(--font-display); font-stretch: 112%; font-weight: 740; font-size: 1.05rem; white-space: nowrap; }
  th span { display: block; font-family: var(--font-body); font-stretch: 100%; font-weight: 500; font-size: var(--fs-tiny); color: var(--ink-soft); }
  td:last-child { padding-right: 0; font-weight: 650; }
  td a { color: var(--ink); }

  @media (max-width: 900px) {
    .route-grid, .off-grid { grid-template-columns: 1fr; }
    .route { min-height: 0; }
    tr { display: grid; grid-template-columns: 1fr auto; border-bottom: 1px solid var(--line); }
    th, td { border: 0; padding-block: var(--s2); }
    td:nth-child(2) { grid-column: 1 / -1; grid-row: 2; padding-top: 0; }
    td:last-child { grid-row: 1; grid-column: 2; }
  }
</style>

---
// CONTACT  →  /contact/
import Base from '../layouts/Base.astro';
import AtlanticMap from '../components/AtlanticMap.astro';
import PageHero from '../components/PageHero.astro';
import { brand, offices } from '../data/site.js';
import { url } from '../lib/url.js';
import { areas } from '../data/areas.js';

const tel = (n) => `tel:+1${n.replaceAll('-', '')}`;
const routes = [
  { t: "I'm hiring", d: 'Contract workers or a permanent hire.', href: url('/hire/'), cta: 'Request talent', kind: 'primary' },
  { t: "I'm looking for work", d: 'Browse open roles or send your resume.', href: url('/find-work/'), cta: 'Browse jobs' },
  { t: 'I know a company that’s hiring', d: 'Refer them to our team.', href: 'https://www.integratedstaffing.ca/referrals', cta: 'Make a referral' },
];
---
<Base title="Contact" footerOffices={false} description="Contact Integrated Staffing in Halifax, Moncton, Saint John, Charlottetown and St. John's.">
  <PageHero title="Talk to the office nearest you." lead="Or start with what you need, and we'll route you to the right recruiter." />

  <section class="section section--rule">
    <div class="wrap">
      <ul class="items">
        {routes.map((r) => (
          <li class:list={['item', r.kind === 'primary' && 'item--blue']}>
            <h2 class="r-title">{r.t}</h2>
            <p>{r.d}</p>
            <a class="more" href={r.href}>{r.cta}</a>
          </li>
        ))}
      </ul>
      <p class="email">General inquiries: <a href={`mailto:${brand.email}`}>{brand.email}</a></p>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap off-grid">
      <AtlanticMap id="contact-map" card={false} />
      <div>
        <div class="section-head">
          <h2>Our offices</h2>
          <p class="lead">Select an office to find it on the map.</p>
        </div>
        <ul class="offices" data-stagger>
          {offices.map((o, i) => (
            <li data-row={i} aria-current={i === 0 ? 'true' : undefined}>
              <button type="button" class="o-city" data-select={i}>{o.city}, {o.province}{i === 0 && <span>Head office</span>}</button>
              <span class="o-addr">{o.address} <a class="o-page" href={url(`/offices/${areas.find((a) => a.label === o.city)?.key}/`)}>Office page</a></span>
              <a class="o-tel" href={tel(o.phone)}>{o.phone}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Base>

<script>
  // The office list and the map pins select each other
  const map = document.getElementById('contact-map');
  const rows = document.querySelectorAll('.offices li');
  const mark = (i) => rows.forEach((r) => (r.dataset.row === String(i) ? r.setAttribute('aria-current', 'true') : r.removeAttribute('aria-current')));
  document.querySelectorAll('[data-select]').forEach((b) => b.addEventListener('click', () => {
    map.querySelector(`.pin[data-index="${b.dataset.select}"]`)?.click();
  }));
  map.querySelectorAll('.pin').forEach((pin) => pin.addEventListener('click', () => mark(pin.dataset.index)));
</script>

<style>
  .r-title { font-size: 1.4rem; letter-spacing: -0.02em; margin-bottom: var(--s2); }
  .email { margin-top: var(--s7); color: var(--ink-soft); }

  .off-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .offices { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .offices li {
    position: relative; display: grid; grid-template-columns: 1fr auto; gap: 2px var(--s4);
    padding: var(--s4) var(--s4) var(--s4) var(--s5); border-bottom: 1px solid var(--line);
    transition: background 0.25s;
  }
  /* A bar on the left marks the selected office, matching the selected pin */
  .offices li::before { content: ''; position: absolute; left: 0; top: var(--s4); bottom: var(--s4); width: 3px; background: var(--ink); transform: scaleY(0); transition: transform 0.3s var(--ease); }
  .offices li[aria-current='true'] { background: var(--paper); }
  .offices li[aria-current='true']::before { transform: none; }
  .o-city { font: inherit; font-weight: 700; font-size: 1.05rem; text-align: left; padding: 0; border: 0; background: none; color: var(--ink); cursor: pointer; }
  .o-city::after { content: ''; position: absolute; inset: 0; } /* the whole row is clickable */
  .o-city span { margin-left: var(--s2); font-weight: 500; font-size: var(--fs-tiny); color: var(--ink-soft); }
  .o-city:hover { text-decoration: underline; }
  .o-addr { grid-column: 1; font-size: var(--fs-small); color: var(--ink-soft); }
  .o-page { position: relative; z-index: 1; display: block; width: fit-content; margin-top: 2px; font-weight: 600; }
  .o-tel { position: relative; z-index: 1; grid-column: 2; grid-row: 1 / span 2; align-self: center; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }

  @media (max-width: 900px) { .off-grid { grid-template-columns: 1fr; } }
  @media (max-width: 420px) { .offices li { grid-template-columns: 1fr; } .o-tel { grid-column: 1; grid-row: auto; margin-top: var(--s2); } }
</style>

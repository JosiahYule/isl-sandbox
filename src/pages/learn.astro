---
// LEARN (BLOG INDEX)  →  /learn/
// Lists posts from src/data/posts.js. Posts still live on the real site.
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ToolCards from '../components/ToolCards.astro';
import { posts } from '../data/posts.js';

const fmt = (d) => new Date(d + 'T12:00:00').toLocaleDateString('en-CA', { month: 'long', day: 'numeric', year: 'numeric' });
const audienceLabel = { employers: 'For employers', 'job seekers': 'For job seekers', everyone: 'Market insights' };
const filters = [
  { key: '', label: 'All posts' },
  { key: 'employers', label: 'For employers' },
  { key: 'job seekers', label: 'For job seekers' },
  { key: 'everyone', label: 'Market insights' },
];
const [featured, ...rest] = posts;
---
<Base title="Learn" description="Hiring advice, career guides and Atlantic Canada job market insights.">
  <PageHero title="Hiring advice and career guides." lead="Written by our team for Atlantic Canadian employers and job seekers." />

  <section class="section section--rule">
    <div class="wrap">
      <div class="section-head"><h2>Start with a tool</h2></div>
      <ToolCards />
    </div>
  </section>

  <section class="section section--tint posts" data-posts>
    <div class="wrap">
      <a class="featured" href={featured.url} data-reveal>
        <span class="new">Latest</span>
        <span class="aud">{audienceLabel[featured.audience]}</span>
        <span class="f-title">{featured.title}</span>
        <time datetime={featured.date}>{fmt(featured.date)}</time>
      </a>

      <div class="filters" role="group" aria-label="Filter posts">
        {filters.map((f, i) => <button type="button" data-key={f.key} aria-pressed={String(i === 0)}>{f.label}</button>)}
      </div>

      <ul class="list">
        {rest.map((p) => (
          <li data-aud={p.audience}>
            <a href={p.url}>
              <time datetime={p.date}>{fmt(p.date)}</time>
              <span class="title">{p.title}</span>
              <span class="aud">{audienceLabel[p.audience]}</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  const root = document.querySelector('[data-posts]');
  const buttons = root.querySelectorAll('.filters button');
  const items = root.querySelectorAll('.list li');
  buttons.forEach((b) => b.addEventListener('click', () => {
    buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    items.forEach((li) => (li.hidden = !!b.dataset.key && li.dataset.aud !== b.dataset.key));
  }));
</script>

<style>
  /* The newest post leads, set large; the rest follow as a dated list */
  .featured { display: grid; gap: var(--s3); padding-bottom: var(--s7); color: var(--ink); text-decoration: none; }
  .featured:hover .f-title { text-decoration: underline; text-decoration-thickness: 2px; }
  .featured .aud { color: var(--isl-blue); }
  .new { font-size: var(--fs-tiny); font-weight: 600; color: var(--ink-soft); }
  .f-title { font-weight: 700; letter-spacing: -0.025em; line-height: 1.05; font-size: clamp(2rem, 1rem + 3vw, 3.6rem); max-width: 20ch; }
  .featured time { color: var(--ink-soft); font-size: var(--fs-small); }

  .filters { display: flex; flex-wrap: wrap; gap: var(--s2); margin-bottom: var(--s4); }
  .filters button {
    font: inherit; font-size: var(--fs-small); font-weight: 500; cursor: pointer;
    padding: 0.5rem 0.95rem; border-radius: var(--radius); background: transparent; color: var(--ink); border: 1.5px solid var(--line);
  }
  .filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }

  .list { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .list li[hidden] { display: none; }
  .list a {
    display: grid; grid-template-columns: 11rem 1fr 10rem 1.5rem; gap: var(--s5); align-items: baseline;
    padding-block: var(--s5); border-bottom: 1px solid var(--line); color: var(--ink); text-decoration: none;
  }
  .list a:hover .title { text-decoration: underline; text-decoration-thickness: 2px; }
  .arrow { color: var(--isl-blue); font-weight: 600; opacity: 0; transform: translateX(-8px); transition: opacity 0.25s, transform 0.3s var(--ease); }
  .list a:hover .arrow, .list a:focus-visible .arrow { opacity: 1; transform: none; }
  time { font-size: var(--fs-small); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .title { font-weight: 600; font-size: 1.25rem; letter-spacing: -0.01em; line-height: 1.25; }
  .aud { font-size: var(--fs-small); font-weight: 500; color: var(--ink-soft); }
  .list .aud { text-align: right; }

  @media (max-width: 760px) {
    .list a { grid-template-columns: 1fr; gap: var(--s1); }
    .list .aud { text-align: left; }
    .arrow { display: none; }
  }
</style>

---
// BASE LAYOUT: the frame around every page (<head>, header, footer).
// The page's own content drops in where <slot /> is.
import '@fontsource-variable/dm-sans/opsz.css';   // DM Sans, the brand face of all three sites, self-hosted
// The Latin file is the one every page needs first, so it's requested before the CSS asks for it
import dmSansLatin from '@fontsource-variable/dm-sans/files/dm-sans-latin-opsz-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { brand, images } from '../data/site.js';
import { url } from '../lib/url.js';
import { sized } from '../lib/img.js';
import { htmlJson } from '../lib/html-json.js';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

// assistant: false hides the assistant entirely
// assistantMode: "employer" (hiring pages) or "seeker" (job pages) opens it ready for that visitor; leave out to let it ask
// assistantJob: on a job page, that job's ID, so the assistant answers questions about the posting
// footerOffices: false hides the footer's office row (the contact page already lists the offices)
// live: the whole page is built from data that changes (the jobs report, pay on open jobs); on Squarespace
//   the page is refreshed from the latest build every time it loads (src/squarespace/core.js)
// schema: optional structured data (an object or a list) that search engines read, e.g. an office's address
const { title, description = brand.scope, assistantMode, assistantJob, footerOffices = true, schema, live = false } = Astro.props;
const assistant = (Astro.props.assistant ?? true) && brand.assistant; // AS and ADS: off for now
// All assistant imports and its data share a content-versioned folder. This avoids mixing
// newly published pages with an older cached widget or demo engine on GitHub Pages.
const assistantVersion = assistant ? JSON.parse(readFileSync(resolve('public/assistant/version.json'), 'utf8')).version : '';
const assistantRoot = url(`/assistant/${assistantVersion}/`);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const heroSrc = typeof images.hero === 'string' ? images.hero : images.hero.src;
const shareImage = new URL(sized(heroSrc, 1500), Astro.site).href; // the saved copy once there is one (src/lib/img.js)
const fullTitle = title ? `${title} | ${brand.name}` : `${brand.name} | ${brand.titleTail}`;
// The brand's colours (src/brands/): any design token from tokens.css, by name.
// ISL's are the defaults in tokens.css, so it sets none.
const colorVars = brand.colors ? Object.entries(brand.colors).map(([k, v]) => `--${k}:${v}`).join(';') : undefined;
---
<!doctype html>
<html lang="en-CA" data-brand={brand.key} style={colorVars} data-assistant-mode={assistantMode} data-assistant-job={assistantJob}>
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={dmSansLatin} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={brand.colors?.dark ?? '#1a1a1a'} />
    <link rel="icon" href={url(brand.favicon)} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <!-- Link previews (LinkedIn, Facebook, Teams, iMessage) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={title || fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={htmlJson(schema)} />}
    <Analytics part="head" />
    {!__LIVE__ && <meta name="robots" content="noindex" />}<!-- the sandbox stays out of search engines; a live build (astro.config.mjs) leaves this out -->
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-isl-live-page={live ? '' : undefined}>
      <slot />
    </main>
    <Footer offices={footerOffices} />
    <Analytics part="body" />
    <script>import '../scripts/motion.js';</script>
    <!-- Job assistant: the chat widget, running in demo mode (see assistant/README.md and assistant/demo-mode.js) -->
    {assistant && <script is:inline defer src={`${assistantRoot}widget.js`}></script>}
    {assistant && <script is:inline type="module" src={`${assistantRoot}demo-mode.js`}></script>}
  </body>
</html>

<style>
  .skip {
    position: absolute; left: var(--s4); top: -100px; z-index: 100;
    background: var(--accent); color: #fff; font-weight: var(--fw-bold);
    padding: var(--s2) var(--s4); border-radius: var(--radius);
  }
  .skip:focus { top: var(--s4); }
</style>

---
// BASE LAYOUT
// Every page is wrapped in this. It holds the <head>, header and footer,
// and the page's own content drops in where <slot /> is.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../data/site.js';

// "Props" are the inputs a page passes in, like function arguments.
const { title, description = brand.scope } = Astro.props;
const fullTitle = title ? `${title} | ${brand.name}` : `${brand.name} | ${brand.tagline}`;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" /><!-- sandbox: keep search engines out -->
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip:focus {
    position: fixed; top: 1rem; left: 1rem; z-index: 100;
    width: auto; height: auto; clip: auto;
    background: var(--color-bg); padding: var(--space-3) var(--space-4);
    border-radius: var(--radius);
  }
</style>

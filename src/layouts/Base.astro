---
// BASE LAYOUT: the frame around every page (<head>, header, footer).
// The page's own content drops in where <slot /> is.
import '@fontsource-variable/dm-sans/opsz.css';   // DM Sans, the ISL brand face, self-hosted
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { brand } from '../data/site.js';
import { url } from '../lib/url.js';

const { title, description = brand.scope } = Astro.props;
const fullTitle = title ? `${title} | ${brand.name}` : `${brand.name} | Contract and permanent staffing in Atlantic Canada`;
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="robots" content="noindex" /><!-- sandbox: keep search engines out -->
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- Job assistant: the chat widget, running in demo mode (see assistant/README.md and assistant/demo-mode.js) -->
    <script is:inline defer src={url('/assistant/widget.js')}></script>
    <script is:inline type="module" src={url('/assistant/demo-mode.js')}></script>
  </body>
</html>

<style>
  .skip {
    position: absolute; left: var(--s4); top: -100px; z-index: 100;
    background: var(--isl-blue); color: #fff; font-weight: 500;
    padding: var(--s2) var(--s4); border-radius: var(--radius);
  }
  .skip:focus { top: var(--s4); }
</style>
